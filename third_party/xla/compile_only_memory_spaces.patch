 #include <utility>
 #include <vector>
 
@@ -27,6 +28,7 @@ limitations under the License.
 #include "absl/status/status_matchers.h"
 #include "xla/layout.h"
 #include "xla/layout_util.h"
+#include "xla/pjrt/host_memory_spaces.h"
 #include "xla/pjrt/pjrt_common.h"
 #include "xla/pjrt/pjrt_compiler.h"
 #include "xla/pjrt/pjrt_device_description.h"
@@ -163,6 +165,28 @@ TEST(StreamExecutorGpuTopologyDescriptionTest,
   }
 }
 
+TEST(StreamExecutorGpuTopologyDescriptionTest,
+     DevicesStateTheClientsMemorySpaces) {
+  std::shared_ptr<xla::GpuTopology> gpu_topology =
+      std::make_shared<xla::GpuTopology>(
+          /*platform_version=*/"12.3", /*num_partitions=*/1,
+          /*num_hosts_per_partition=*/1, /*num_devices_per_host=*/2);
+  StreamExecutorGpuTopologyDescription topology_desc(
+      xla::CudaId(), xla::CudaName(), gpu_topology);
+  for (const auto& device : topology_desc.DeviceDescriptions()) {
+    std::vector<std::string> kinds;
+    for (const PjRtMemorySpaceDescription* memory : device->memory_spaces()) {
+      kinds.push_back(std::string(memory->kind()));
+    }
+    EXPECT_THAT(kinds, ElementsAre("device", "pinned_host"));
+    TF_ASSERT_OK_AND_ASSIGN(const PjRtMemorySpaceDescription* default_memory,
+                            device->default_memory_space());
+    EXPECT_EQ(default_memory->kind(), "device");
+    EXPECT_EQ(device->memory_spaces()[1]->kind_id(),
+              PinnedHostMemorySpace::kKindId);
+  }
+}

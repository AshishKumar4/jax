diff --git a/xla/pjrt/se/pjrt_stream_executor_device_description.h b/xla/pjrt/se/pjrt_stream_executor_device_description.h
index fe59f7ebe7..c3ac5a27d2 100644
--- a/xla/pjrt/se/pjrt_stream_executor_device_description.h
+++ b/xla/pjrt/se/pjrt_stream_executor_device_description.h
@@ -17,6 +17,8 @@ limitations under the License.
 #include <utility>
 
 #include "absl/container/flat_hash_map.h"
+#include "absl/status/status.h"
+#include "absl/status/statusor.h"
 #include "absl/strings/str_cat.h"
 #include "absl/strings/string_view.h"
 #include "absl/types/span.h"
@@ -73,6 +75,30 @@ class PjRtStreamExecutorDeviceDescription : public PjRtDeviceDescription {
 
   void SetToString(std::string to_string) { to_string_ = std::move(to_string); }
 
+  absl::Span<const PjRtMemorySpaceDescription* const> memory_spaces()
+      const override {
+    return memory_spaces_;
+  }
+
+  absl::StatusOr<const PjRtMemorySpaceDescription*> default_memory_space()
+      const override {
+    if (default_memory_space_ == nullptr) {
+      return absl::UnimplementedError(
+          "default_memory_space Not implemented.");
+    }
+    return default_memory_space_;
+  }
+
+  // The memory spaces a device of this description has, held where they live
+  // for as long as the description (a topology's one table for all its
+  // devices), the first its default: what a compile-only device states, as
+  // the client's own device holds them.
+  void SetMemorySpaces(
+      absl::Span<const PjRtMemorySpaceDescription* const> memory_spaces) {
+    memory_spaces_ = memory_spaces;
+    default_memory_space_ = memory_spaces.empty() ? nullptr : memory_spaces[0];
+  }
+
  private:
   const int id_;
   const int process_index_;
@@ -81,6 +107,8 @@ class PjRtStreamExecutorDeviceDescription : public PjRtDeviceDescription {
   std::string to_string_ = "<unknown SE device>";
   absl::flat_hash_map<std::string, PjRtDeviceAttribute> attributes_;
   const std::array<int, 3> coords_;
+  absl::Span<const PjRtMemorySpaceDescription* const> memory_spaces_;
+  const PjRtMemorySpaceDescription* default_memory_space_ = nullptr;
 };
 }  // namespace xla
 
diff --git a/xla/python/compile_only_ifrt/client.h b/xla/python/compile_only_ifrt/client.h
index 4962f4e1ec..01942487bf 100644
--- a/xla/python/compile_only_ifrt/client.h
+++ b/xla/python/compile_only_ifrt/client.h
@@ -180,17 +180,18 @@ class CompileOnlyIfRtClient final
           description.get(), topology_->platform_name()));
       auto* device = owned_devices_.back().get();
       devices_.push_back(device);
-      if (description->process_index() == process_index()) {
-        auto default_memory = description->default_memory_space();
-        for (auto* memory_description : description->memory_spaces()) {
-          auto memory = std::make_unique<CompileOnlyMemory>(
-              offset, memory_description, device);
-          if (default_memory.ok() && memory_description == *default_memory) {
-            device->SetDefaultMemory(memory.get());
-          }
-          device->AttachMemory(std::move(memory));
-          ++offset;
+      // Every device's memories, whatever process it is on: they describe it,
+      // and a sharding over another process's devices reads its first
+      // device's default memory and kinds as one over this process's does.
+      auto default_memory = description->default_memory_space();
+      for (auto* memory_description : description->memory_spaces()) {
+        auto memory = std::make_unique<CompileOnlyMemory>(
+            offset, memory_description, device);
+        if (default_memory.ok() && memory_description == *default_memory) {
+          device->SetDefaultMemory(memory.get());
         }
+        device->AttachMemory(std::move(memory));
+        ++offset;
       }
     }
   }

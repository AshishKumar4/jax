index 3b955baa10..ae96dc5285 100644
--- a/xla/pjrt/c/pjrt_c_api_wrapper_impl.h
+++ b/xla/pjrt/c/pjrt_c_api_wrapper_impl.h
@@ -88,9 +88,6 @@ struct PJRT_Client {
                        std::unique_ptr<xla::PjRtClient> cpp_client);
 };
 
-struct PJRT_MemoryDescription {
-  xla::PjRtMemorySpaceDescription memory_space_description;
-};
 
 // PJRT_AsyncHostToDeviceTransferManager is owned by its corresponding
 // PJRT_Client.
@@ -107,6 +104,10 @@ struct PJRT_DeviceDescription {
   const xla::PjRtDeviceDescription* device_description;
   // The device specific attributes which are initialized once per device.
   std::vector<PJRT_NamedValue> attributes;
+  // Its memory spaces' descriptions, each an opaque handle that is the
+  // xla::PjRtMemorySpaceDescription's own pointer
+  // (PJRT_DeviceDescription_MemoryDescriptions), initialized once per device.
+  std::vector<const PJRT_MemoryDescription*> memory_descriptions;
 };
 
 // PJRT_Devices are owned by their corresponding PJRT_Client.

diff --git a/xla/pjrt/gpu/se_gpu_topology_description.cc b/xla/pjrt/gpu/se_gpu_topology_description.cc
index 10d85c893b..5e1873ab22 100644
--- a/xla/pjrt/gpu/se_gpu_topology_description.cc
+++ b/xla/pjrt/gpu/se_gpu_topology_description.cc
@@ -54,6 +54,24 @@ limitations under the License.
 
 namespace xla {
 
+namespace {
+// The memory spaces a StreamExecutor GPU client's device has (its HBM, the
+// default, and pinned host memory, StreamExecutorGpuClient's), each kind id
+// the kind's fingerprint as the client's are: one table every device of a
+// topology states.
+absl::Span<const PjRtMemorySpaceDescription* const> GpuMemorySpaces() {
+  static const PjRtMemorySpaceDescription* const kDevice =
+      new PjRtMemorySpaceDescription(
+          "device", static_cast<int>(tsl::Fingerprint32("device")));
+  static const PjRtMemorySpaceDescription* const kPinnedHost =
+      new PjRtMemorySpaceDescription(PinnedHostMemorySpace::kKind,
+                                     PinnedHostMemorySpace::kKindId);
+  static const PjRtMemorySpaceDescription* const kSpaces[] = {kDevice,
+                                                               kPinnedHost};
+  return kSpaces;
+}
+}  // namespace
+
 REGISTER_PJRT_TOPOLOGY_DESERIALIZER(
     Cuda, xla::CudaId(), xla::CudaName(),
     [](const xla::PjRtTopologyDescriptionProto& proto) {
@@ -153,6 +171,11 @@ StreamExecutorGpuTopologyDescription::CreateDeviceDescription(
   auto description = std::make_unique<PjRtStreamExecutorDeviceDescription>(
       device_id, local_device_id, process_index, process_index_in_partition,
       partition_index, std::string(gpu_topology_->platform_version()));
+  // So a program compiled for a compile-only device places an array in pinned
+  // host memory as one compiled on the device does, where a sharding naming
+  // "pinned_host" was canonicalized to the default memory and its offload
+  // dropped.
+  description->SetMemorySpaces(GpuMemorySpaces());
   if (target_config_.has_value()) {
     std::string compute_capability = "<unknown compute-capability>";
     std::string gpu_vendor = "<unknown gpu vendor>";
diff --git a/xla/pjrt/gpu/se_gpu_topology_description_test.cc b/xla/pjrt/gpu/se_gpu_topology_description_test.cc
index 9d31d364e2..ca4eadb7de 100644
--- a/xla/pjrt/gpu/se_gpu_topology_description_test.cc
+++ b/xla/pjrt/gpu/se_gpu_topology_description_test.cc
@@ -20,6 +20,7 @@ limitations under the License.
 
 #include <memory>

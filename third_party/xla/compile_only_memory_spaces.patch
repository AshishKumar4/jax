From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ashish Kumar Singh <ashishkmr472@gmail.com>
Date: Fri, 20 Nov 2026 22:40:00 -0600
Subject: [PATCH] [PJRT:GPU] A compile-only GPU device states the client's
 memory spaces

StreamExecutorGpuTopologyDescription built each device's description with no memory space, so a compile-only
GPU (the compile-only IFRT client over a topology, or the C API's device descriptions through
PJRT_MemoryDescriptions_Extension) had no default memory and no host memory: a sharding naming "pinned_host"
on it was canonicalized to the default memory kind, and a program compiled for it lost every host offload a
program compiled on the device keeps. PjRtStreamExecutorDeviceDescription now holds the memory spaces a
description states (memory_spaces, default_memory_space), and the topology's devices state the GPU client's:
its HBM ("device", the default), pinned_host and unpinned_host, each kind id the kind's fingerprint as the
client's memory spaces' are.

---
diff --git a/xla/pjrt/gpu/BUILD b/xla/pjrt/gpu/BUILD
--- a/xla/pjrt/gpu/BUILD
+++ b/xla/pjrt/gpu/BUILD
@@ -1062,6 +1062,7 @@
     deps = [
         ":se_gpu_pjrt_compiler",  # buildcleaner: keep
         ":se_gpu_topology_description",
+        "//xla/pjrt:host_memory_spaces",
         "//xla/pjrt:pjrt_common",
         "//xla/pjrt:pjrt_compiler",
         "//xla/pjrt:pjrt_device_description",
diff --git a/xla/pjrt/gpu/se_gpu_topology_description.cc b/xla/pjrt/gpu/se_gpu_topology_description.cc
--- a/xla/pjrt/gpu/se_gpu_topology_description.cc
+++ b/xla/pjrt/gpu/se_gpu_topology_description.cc
@@ -28,6 +28,7 @@
 #include "absl/status/statusor.h"
 #include "absl/strings/str_cat.h"
 #include "absl/strings/str_format.h"
+#include "absl/strings/string_view.h"
 #include "absl/types/span.h"
 #include "tsl/platform/fingerprint.h"
 #include "xla/layout.h"
@@ -54,6 +55,12 @@
 
 namespace xla {
 
+namespace {
+// A GPU device's own memory, as StreamExecutorGpuHbmMemorySpace names it
+// (its kind id the kind's fingerprint, as every PJRT memory space's is).
+constexpr absl::string_view kDeviceMemoryKind = "device";
+}  // namespace
+
 REGISTER_PJRT_TOPOLOGY_DESERIALIZER(
     Cuda, xla::CudaId(), xla::CudaName(),
     [](const xla::PjRtTopologyDescriptionProto& proto) {
@@ -148,6 +155,20 @@
   auto description = std::make_unique<PjRtStreamExecutorDeviceDescription>(
       device_id, local_device_id, process_index, process_index_in_partition,
       partition_index, std::string(platform_version()));
+  // The memory spaces a GPU client's device has (StreamExecutorGpuClient's:
+  // its HBM, the default, and pinned and unpinned host memory), so a program
+  // compiled for a compile-only device places an array in host memory as one
+  // compiled on the device does, where a sharding naming "pinned_host" was
+  // canonicalized to the default memory and its offload dropped.
+  description->SetMemorySpaces(
+      {PjRtMemorySpaceDescription(
+           kDeviceMemoryKind,
+           static_cast<int>(tsl::Fingerprint32(kDeviceMemoryKind))),
+       PjRtMemorySpaceDescription(PinnedHostMemorySpace::kKind,
+                                  PinnedHostMemorySpace::kKindId),
+       PjRtMemorySpaceDescription(UnpinnedHostMemorySpace::kKind,
+                                  UnpinnedHostMemorySpace::kKindId)},
+      /*default_index=*/0);
   if (target_config_.has_value()) {
     std::string compute_capability = "<unknown compute-capability>";
     std::string gpu_vendor = "<unknown gpu vendor>";
diff --git a/xla/pjrt/gpu/se_gpu_topology_description_test.cc b/xla/pjrt/gpu/se_gpu_topology_description_test.cc
--- a/xla/pjrt/gpu/se_gpu_topology_description_test.cc
+++ b/xla/pjrt/gpu/se_gpu_topology_description_test.cc
@@ -20,10 +20,12 @@
 
 #include <memory>
 #include <optional>
+#include <string>
 #include <utility>
 #include <vector>
 
 #include "xla/pjrt/pjrt_common.h"
+#include "xla/pjrt/host_memory_spaces.h"
 #include "xla/pjrt/pjrt_compiler.h"
 #include "xla/pjrt/pjrt_device_description.h"
 #include "xla/pjrt/pjrt_device_dimensions.h"
@@ -129,6 +131,28 @@
   EXPECT_EQ(device_descs.size(), 0);
 }
 
+TEST(StreamExecutorGpuTopologyDescriptionTest,
+     DevicesStateTheClientsMemorySpaces) {
+  std::shared_ptr<xla::GpuTopology> gpu_topology =
+      std::make_shared<xla::GpuTopology>(
+          /*platform_version=*/"12.3", /*num_partitions=*/1,
+          /*num_hosts_per_partition=*/1, /*num_devices_per_host=*/2);
+  StreamExecutorGpuTopologyDescription topology_desc(
+      xla::CudaId(), xla::CudaName(), gpu_topology);
+  for (const auto& device : topology_desc.DeviceDescriptions()) {
+    std::vector<std::string> kinds;
+    for (const PjRtMemorySpaceDescription* memory : device->memory_spaces()) {
+      kinds.push_back(std::string(memory->kind()));
+    }
+    EXPECT_THAT(kinds, ElementsAre("device", "pinned_host", "unpinned_host"));
+    TF_ASSERT_OK_AND_ASSIGN(const PjRtMemorySpaceDescription* default_memory,
+                            device->default_memory_space());
+    EXPECT_EQ(default_memory->kind(), "device");
+    EXPECT_EQ(device->memory_spaces()[1]->kind_id(),
+              PinnedHostMemorySpace::kKindId);
+  }
+}
+
 TEST(PjRtTopologyUtilsGPUTest, GetDeviceCoords) {
   std::shared_ptr<xla::GpuTopology> gpu_topology =
       std::make_shared<xla::GpuTopology>(
diff --git a/xla/pjrt/se/BUILD b/xla/pjrt/se/BUILD
--- a/xla/pjrt/se/BUILD
+++ b/xla/pjrt/se/BUILD
@@ -391,6 +391,8 @@
         "//xla/pjrt:pjrt_device_description",
         "//xla/pjrt:utils",
         "@com_google_absl//absl/container:flat_hash_map",
+        "@com_google_absl//absl/status",
+        "@com_google_absl//absl/status:statusor",
         "@com_google_absl//absl/strings",
         "@com_google_absl//absl/strings:string_view",
         "@com_google_absl//absl/types:span",
diff --git a/xla/pjrt/se/pjrt_stream_executor_device_description.h b/xla/pjrt/se/pjrt_stream_executor_device_description.h
--- a/xla/pjrt/se/pjrt_stream_executor_device_description.h
+++ b/xla/pjrt/se/pjrt_stream_executor_device_description.h
@@ -13,10 +13,14 @@
 #define XLA_PJRT_SE_PJRT_STREAM_EXECUTOR_DEVICE_DESCRIPTION_H_
 
 #include <array>
+#include <memory>
 #include <string>
 #include <utility>
+#include <vector>
 
 #include "absl/container/flat_hash_map.h"
+#include "absl/status/status.h"
+#include "absl/status/statusor.h"
 #include "absl/strings/str_cat.h"
 #include "absl/strings/string_view.h"
 #include "absl/types/span.h"
@@ -73,6 +77,35 @@
 
   void SetToString(std::string to_string) { to_string_ = std::move(to_string); }
 
+  absl::Span<const PjRtMemorySpaceDescription* const> memory_spaces()
+      const override {
+    return memory_space_pointers_;
+  }
+
+  absl::StatusOr<const PjRtMemorySpaceDescription*> default_memory_space()
+      const override {
+    if (default_memory_space_ == nullptr) {
+      return absl::UnimplementedError(
+          "default_memory_space Not implemented.");
+    }
+    return default_memory_space_;
+  }
+
+  // The memory spaces a device of this description has, the one at
+  // `default_index` its default: what a compile-only device of a topology
+  // states, as the client's own device holds them.
+  void SetMemorySpaces(std::vector<PjRtMemorySpaceDescription> memory_spaces,
+                       int default_index) {
+    memory_spaces_.clear();
+    memory_space_pointers_.clear();
+    for (auto& memory_space : memory_spaces) {
+      memory_spaces_.push_back(
+          std::make_unique<PjRtMemorySpaceDescription>(std::move(memory_space)));
+      memory_space_pointers_.push_back(memory_spaces_.back().get());
+    }
+    default_memory_space_ = memory_space_pointers_.at(default_index);
+  }
+
  private:
   const int id_;
   const int process_index_;
@@ -81,6 +114,9 @@
   std::string to_string_ = "<unknown SE device>";
   absl::flat_hash_map<std::string, PjRtDeviceAttribute> attributes_;
   const std::array<int, 3> coords_;
+  std::vector<std::unique_ptr<PjRtMemorySpaceDescription>> memory_spaces_;
+  std::vector<const PjRtMemorySpaceDescription*> memory_space_pointers_;
+  const PjRtMemorySpaceDescription* default_memory_space_ = nullptr;
 };
 }  // namespace xla
 

From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ashish Kumar Singh <ashishkmr472@gmail.com>
Date: Fri, 20 Nov 2026 22:40:00 -0600
Subject: [PATCH] [PJRT:GPU] A compile-only GPU device states the client's
 memory spaces

StreamExecutorGpuTopologyDescription built each device's description with no memory space, so a compile-only
GPU (the compile-only IFRT client over a topology, or the C API's device descriptions through
PJRT_MemoryDescriptions_Extension) had no default memory and no host memory: a sharding naming "pinned_host"
on it was canonicalized to the default memory kind, and a program compiled for it lost every host offload a
program compiled on the device keeps. PjRtStreamExecutorDeviceDescription now holds the memory spaces a
description states (memory_spaces, default_memory_space), and the topology's devices state the GPU client's:
its HBM ("device", the default) and pinned_host, from one table every device shares, each kind id the kind's
fingerprint as the client's memory spaces' are. The C API hands each memory description out as an opaque handle that is its own pointer, cast one by one into
an array of handles each C device description holds, and PJRT_MemoryDescription_Kind reads it back as that
description, and the compile-only IFRT client attaches every device's memories
whatever its process, so a sharding whose first device is another process's keeps its memory kind.

---
diff --git a/xla/pjrt/c/pjrt_c_api_wrapper_impl.cc b/xla/pjrt/c/pjrt_c_api_wrapper_impl.cc
index e0e92d861e..b3178c1b0b 100644
--- a/xla/pjrt/c/pjrt_c_api_wrapper_impl.cc
+++ b/xla/pjrt/c/pjrt_c_api_wrapper_impl.cc
@@ -1639,6 +1639,19 @@ PJRT_Error* PJRT_DeviceDescription_DebugString(
   return nullptr;
 }
 
+// The opaque handles of `description`'s memory spaces, each the
+// xla::PjRtMemorySpaceDescription's own pointer cast on its own
+// (PJRT_MemoryDescription_Kind casts it back).
+static std::vector<const PJRT_MemoryDescription*>
+PopulateMemoryDescriptions(const xla::PjRtDeviceDescription& description) {
+  std::vector<const PJRT_MemoryDescription*> handles;
+  for (const xla::PjRtMemorySpaceDescription* memory :
+       description.memory_spaces()) {
+    handles.push_back(reinterpret_cast<const PJRT_MemoryDescription*>(memory));
+  }
+  return handles;
+}
+
 PJRT_Error* PJRT_DeviceDescription_MemoryDescriptions(
     PJRT_DeviceDescription_MemoryDescriptions_Args* args) {
   PJRT_RETURN_IF_ERROR(ActualStructSizeIsGreaterOrEqual(
@@ -1649,11 +1662,11 @@ PJRT_Error* PJRT_DeviceDescription_MemoryDescriptions(
   absl::Span<const xla::PjRtMemorySpaceDescription* const> memory_spaces =
       args->device_description->device_description->memory_spaces();
 
-  // We pass each xla::PjRtMemorySpaceDescriptions to the caller through an
-  // opaque pointer.
+  // Each xla::PjRtMemorySpaceDescription goes to the caller through an opaque
+  // handle, its own pointer, held in an array of handles of the handle's type
+  // (PopulateMemoryDescriptions).
   args->memory_descriptions =
-      reinterpret_cast<const PJRT_MemoryDescription* const*>(
-          memory_spaces.data());
+      args->device_description->memory_descriptions.data();
 
   absl::StatusOr<const xla::PjRtMemorySpaceDescription*> default_memory =
       args->device_description->device_description->default_memory_space();
@@ -1685,11 +1698,16 @@ PJRT_Error* PJRT_MemoryDescription_Kind(
   PJRT_RETURN_IF_ERROR(ActualStructSizeIsGreaterOrEqual(
       "PJRT_MemoryDescription_Kind_Args",
       PJRT_MemoryDescription_Kind_Args_STRUCT_SIZE, args->struct_size));
-  absl::string_view kind =
-      args->memory_description->memory_space_description.kind();
+  // The opaque handle is the description's own pointer
+  // (PJRT_DeviceDescription_MemoryDescriptions hands each out as one), read
+  // back as it was given.
+  const auto* description =
+      reinterpret_cast<const xla::PjRtMemorySpaceDescription*>(
+          args->memory_description);
+  absl::string_view kind = description->kind();
   args->kind = kind.data();
   args->kind_size = kind.size();
-  args->kind_id = args->memory_description->memory_space_description.kind_id();
+  args->kind_id = description->kind_id();
   return nullptr;
 }
 
@@ -3624,6 +3642,8 @@ static void PopulatePjrtClientDevices(PJRT_Client* c_client) {
     c_device->client = c_client;
     c_device->description.attributes =
         PopulatePjrtAttributes(device->description().Attributes());
+    c_device->description.memory_descriptions =
+        PopulateMemoryDescriptions(device->description());
     c_client->devices.push_back(c_device);
     if (device->IsAddressable()) {
       c_client->addressable_devices.push_back(c_device);
@@ -3722,6 +3742,8 @@ PJRT_TopologyDescription* CreateWrapperDeviceTopology(
         &c_topology->descriptions.back());
     c_topology->descriptions.back().attributes =
         PopulatePjrtAttributes(description->Attributes());
+    c_topology->descriptions.back().memory_descriptions =
+        PopulateMemoryDescriptions(*description);
   }
   c_topology->attributes =
       PopulatePjrtAttributes(c_topology->topology->Attributes());

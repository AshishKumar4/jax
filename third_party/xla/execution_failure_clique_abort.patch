+// evicts each clique split from one of them, as far as splits go: a split
+// clique keeps its parent by pointer, which no cached clique may outlive.
+static absl::Status EvictCliques(
+    ProcessGpuCliques& state,
+    absl::Span<const std::shared_ptr<LockableGpuClique>> cliques)
+    ABSL_EXCLUSIVE_LOCKS_REQUIRED(state.mu) {
+  absl::flat_hash_set<const LockableGpuClique*> evicting;
+  absl::flat_hash_set<const GpuClique*> gone;
+  for (const std::shared_ptr<LockableGpuClique>& clique : cliques) {
+    evicting.insert(clique.get());
+    gone.insert(clique->clique());
+  }
+  absl::flat_hash_set<CliqueCacheKey> splits;
+  for (size_t found = 0; found != gone.size();) {
+    found = gone.size();
+    for (const auto& [cache_key, lockable_clique] : state.cliques) {
+      if (!evicting.contains(lockable_clique.get()) &&
+          !splits.contains(cache_key) &&
+          gone.contains(lockable_clique->parent())) {

+  // address is taken for it.
+  std::vector<std::shared_ptr<LockableGpuClique>> live;
+  for (const std::weak_ptr<LockableGpuClique>& clique : held) {
+    if (std::shared_ptr<LockableGpuClique> lockable_clique = clique.lock()) {
+      live.push_back(std::move(lockable_clique));
+    }
+  }
+  if (live.empty()) {
+    return absl::OkStatus();
+  }
+  ProcessGpuCliques& state = GetProcessGpuCliques();
+  absl::MutexLock lock(state.mu);
+  return EvictCliques(state, live);
+}

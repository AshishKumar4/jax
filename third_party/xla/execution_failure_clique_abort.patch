+absl::Status AbortFailedExecutionCliques(absl::Span<const HeldClique> held,
+                                         const absl::Status& error) {
+  if (held.empty()) {
+    return absl::OkStatus();
+  }
+  ProcessGpuCliques& state = GetProcessGpuCliques();
+  absl::MutexLock lock(state.mu);
+
+  // The held cliques the process still has, then each split from one of them,
+  // as far as splits go: a split clique keeps its parent by pointer.
+  absl::flat_hash_set<CliqueCacheKey> aborted;
+  absl::flat_hash_set<const GpuClique*> gone;
+  for (const auto& [cache_key, lockable_clique] : state.cliques) {
+    for (const HeldClique& clique : held) {
+      if (cache_key == CliqueCacheKey(clique.collectives, clique.key) &&
+          lockable_clique->instance() == clique.instance) {
+        aborted.insert(cache_key);
+        gone.insert(lockable_clique->clique());
+      }
+    }
+  }
+  for (size_t found = 0; found != gone.size();) {
+    found = gone.size();
+    for (const auto& [cache_key, lockable_clique] : state.cliques) {
+      if (gone.contains(lockable_clique->parent())) {
+        aborted.insert(cache_key);
+        gone.insert(lockable_clique->clique());
+      }
+    }
+  }
+
+  // Their keys' initializations under way end too, as AbortAllCliques ends
+  // every one.
+  for (const HeldClique& clique : held) {
+    auto pending = state.pending_cliques.find(
+        CliqueCacheKey(clique.collectives, clique.key));
+    if (pending != state.pending_cliques.end()) {
+      pending->second->Cancel();
+    }
+  }
+  if (aborted.empty()) {
+    return absl::OkStatus();
+  }
+  LOG(ERROR) << "Aborting " << aborted.size()
+             << " GPU cliques of an execution that failed: " << error;
+  return AbortCliques(state, [&](const CliqueCacheKey& key) {
+    return aborted.contains(key);
+  });
+}

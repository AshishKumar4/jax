+
+using ::testing::HasSubstr;
+
+// Whether device 0's copy fails to initialize: its execution's failure after
+// it locked its cliques, before the rendezvous after initialization.
+std::atomic<bool> fail_on_device_zero{false};
+
+absl::Status FailOnDeviceZero(ffi::AnyBuffer, ffi::Result<ffi::AnyBuffer>,
+                              int32_t device_ordinal) {
+  if (fail_on_device_zero.load() && device_ordinal == 0) {
+    return absl::ResourceExhaustedError("device 0 failed to initialize");
+  }
+  return absl::OkStatus();
+}
+
+XLA_FFI_DEFINE_HANDLER(kFailOnDeviceZero, FailOnDeviceZero,
+                       ffi::Ffi::Bind<ffi::ExecutionStage::kInitialize>()
+                           .Arg<ffi::AnyBuffer>()
+                           .Ret<ffi::AnyBuffer>()
+                           .Ctx<ffi::DeviceOrdinal>());
+
+absl::Status Copy(se::Stream* stream, ffi::AnyBuffer src,
+                  ffi::Result<ffi::AnyBuffer> dst) {
+  se::DeviceAddressBase dst_mem = dst->device_memory();
+  se::DeviceAddressBase src_mem = src.device_memory();
+  return stream->MemcpyD2D(&dst_mem, src_mem, src_mem.size());
+}
+
+XLA_FFI_DEFINE_HANDLER(kCopy, Copy,
+                       ffi::Ffi::Bind()
+                           .Ctx<ffi::Stream>()
+                           .Arg<ffi::AnyBuffer>()
+                           .Ret<ffi::AnyBuffer>());
+
+constexpr char kModule[] = R"(
+HloModule test, replica_count=2
+
+add {
+  x = f32[] parameter(0)
+  y = f32[] parameter(1)
+  ROOT add = f32[] add(x, y)
+}
+
+ENTRY test {
+  p = f32[4] parameter(0)
+  copied = f32[4] custom-call(p),
+    custom_call_target="xla.test.fail_on_device_zero",
+    api_version=API_VERSION_TYPED_FFI
+  ROOT sum = f32[4] all-reduce(copied), replica_groups={}, to_apply=add
+})";
+
+using FailedExecutionCliqueAbortTest = HloPjRtTestBase;
+
+// A rank whose execution fails once it holds its cliques (its copy failing to
+// initialize) ends its peer's execution with a failure, where the peer would
+// wait at the rendezvous after initialization until its terminate timeout and
+// abort the process; and the next run locks its cliques again and runs whole.
+TEST_F(FailedExecutionCliqueAbortTest,
+       ARankThatFailsToInitializeEndsItsPeerAndTheNextRunRunsWhole) {
+  if (test_runner().device_count() < 2) {
+    GTEST_SKIP() << "Test requires at least 2 GPUs";
+  }
+  // Registered once for the process: the registry refuses a name twice.
+  static const absl::Status registered =
+      ffi::TakeError(ffi::Ffi::RegisterStaticHandler(
+          ffi::GetXlaFfiApi(), "xla.test.fail_on_device_zero", "CUDA",
+          {/*instantiate=*/nullptr, /*prepare=*/nullptr,
+           /*initialize=*/kFailOnDeviceZero, /*execute=*/kCopy}));
+  ASSERT_OK(registered);
+  HloModuleConfig config = GetModuleConfigForTest(/*replica_count=*/2);
+  Literal input = LiteralUtil::CreateR1<float>({1, 2, 3, 4});
+
+  fail_on_device_zero = true;
+  ASSERT_OK_AND_ASSIGN(std::unique_ptr<HloModule> failing,
+                       ParseAndReturnVerifiedModule(kModule, config));
+  EXPECT_THAT(
+      ExecuteReplicated(std::move(failing), {&input}, /*num_devices=*/2,
+                        /*use_threads=*/true, /*run_hlo_passes=*/true)
+          .status(),
+      absl_testing::StatusIs(absl::StatusCode::kResourceExhausted,
+                             HasSubstr("device 0 failed to initialize")));
+
+  fail_on_device_zero = false;
+  ASSERT_OK_AND_ASSIGN(std::unique_ptr<HloModule> whole,
+                       ParseAndReturnVerifiedModule(kModule, config));
+  ASSERT_OK_AND_ASSIGN(std::vector<Literal> results,
+                       ExecuteReplicated(std::move(whole), {&input},
+                                         /*num_devices=*/2,
+                                         /*use_threads=*/true,
+                                         /*run_hlo_passes=*/true));
+  for (const Literal& result : results) {
+    LiteralTestUtil::ExpectR1Equal<float>({2, 4, 6, 8}, result);
+  }
+}

+// A clique's lock with a hold on the clique it locks, so a clique outlives
+// every lock of it where the process cache lets it go first
+// (`AbortFailedExecutionCliques` evicts a clique its other ranks still hold).
+// The lock, its second member, is released before the hold is.
+struct OwnedCliqueLock {
+  std::shared_ptr<LockableGpuClique> clique;
+  LockableGpuClique::Lock lock;
+};
+
+static absl::Status EvictCliques(
+    ProcessGpuCliques& state,
+    absl::Span<const std::shared_ptr<LockableGpuClique>> cliques)
+    ABSL_EXCLUSIVE_LOCKS_REQUIRED(state.mu);
+
+// `clique` locked, held while it is (none, where there is no clique).
+static OwnedCliqueLock LockOwned(std::shared_ptr<LockableGpuClique> clique) {
+  LockableGpuClique::Lock lock =
+      clique ? clique->Acquire() : LockableGpuClique::Lock();
+  return OwnedCliqueLock{std::move(clique), std::move(lock)};
+}
+
+// The lock an owned lock shares among its ranks, its hold kept beside it;
+// `locked`, where given, set to the clique it locks.
+static absl::StatusOr<std::shared_ptr<LockableGpuClique::Lock>> SharedLock(
+    absl::StatusOr<std::shared_ptr<OwnedCliqueLock>> owned,
+    std::weak_ptr<LockableGpuClique>* locked) {
+  ABSL_ASSIGN_OR_RETURN(std::shared_ptr<OwnedCliqueLock> held,
+                        std::move(owned));
+  if (locked != nullptr) {
+    *locked = held->clique;
+  }
+  LockableGpuClique::Lock* lock = &held->lock;
+  return std::shared_ptr<LockableGpuClique::Lock>(std::move(held), lock);
+}

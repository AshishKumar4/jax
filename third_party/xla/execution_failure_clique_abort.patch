 }
 
+absl::Status AbortFailedExecutionCliques(
+    absl::Span<const GpuCliqueKey> clique_keys, const absl::Status& error) {
+  if (clique_keys.empty()) {
+    return absl::OkStatus();
+  }
+  LOG(ERROR) << "Aborting " << clique_keys.size()
+             << " GPU cliques of an execution that failed: " << error;
+  absl::flat_hash_set<GpuCliqueKey> keys(clique_keys.begin(),
+                                         clique_keys.end());
+  ProcessGpuCliques& state = GetProcessGpuCliques();
+  absl::MutexLock lock(state.mu);
+  return AbortCliques(state, [&](const GpuCliqueKey& key) {
+    return keys.contains(key);
+  });
+}

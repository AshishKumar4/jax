+// An execution that fails holding its cliques aborts them while its peers
+// still hold them (their locks taken, as a peer's running collective holds
+// them), and only them: a clique of other devices stands.
+TEST(AbortCollectivesOnTaskFailureTest, AbortsTheCliquesOfAFailedExecution) {
+  auto cleanup = absl::MakeCleanup([] { internal::DestroyAcquiredCliques(); });
+  ResetProcessTaskState();
+
+  ASSERT_OK_AND_ASSIGN(auto platform_name,
+                       xla::PlatformUtil::CanonicalPlatformName("gpu"));
+  ASSERT_OK_AND_ASSIGN(se::Platform * platform,
+                       se::PlatformManager::PlatformWithName(
+                           absl::AsciiStrToUpper(platform_name)));
+  if (platform->VisibleDeviceCount() < 2) {
+    GTEST_SKIP() << "Test requires at least 2 GPUs";
+  }
+
+  tsl::thread::ThreadPool pool(tsl::Env::Default(), "abort-collectives", 2);
+  tsl::Executor& exec = *pool.AsExecutor();
+  ASSERT_OK_AND_ASSIGN(std::vector<se::StreamExecutor*> executors,
+                       CreateExecutors(platform, 2));
+  GpuCollectives* collectives = GpuCollectives::Default("GPU");
+
+  GpuCliqueKey pair({kD0, kD1}, /*num_local_participants=*/2);
+  GpuCliqueKey alone({kD1}, /*num_local_participants=*/1);
+  std::vector<std::vector<GlobalDeviceId>> groups = {{kD0, kD1}};
+  std::vector<std::vector<GlobalDeviceId>> alone_groups = {{kD1}};
+  std::vector<AcquiredCliquesMap> acquired_cliques(3);
+  std::vector<Future<std::shared_ptr<LockableGpuClique::Lock>>> futures(2);
+  for (size_t i = 0; i < 2; ++i) {
+    futures[i] = MakeFutureOn(exec, [=, &acquired_cliques] {
+      return AcquireClique(collectives, executors.at(i), RunId(0), pair,
+                           groups, DefaultCliqueId(), RankId(i),
+                           acquired_cliques.at(i));
+    });
+  }
+  std::vector<std::shared_ptr<LockableGpuClique::Lock>> locks(2);
+  for (size_t i = 0; i < 2; ++i) {
+    ASSERT_OK_AND_ASSIGN(locks[i], futures[i].Await());
+  }
+  ASSERT_OK_AND_ASSIGN(
+      std::shared_ptr<LockableGpuClique::Lock> other,
+      AcquireClique(collectives, executors.at(1), RunId(1), alone, alone_groups,
+                    DefaultCliqueId(), RankId(0), acquired_cliques.at(2)));
+  ASSERT_FALSE((*locks[0])->IsCancelled());
+
+  ASSERT_OK(AbortFailedExecutionCliques(
+      {pair}, absl::ResourceExhaustedError("Failed to allocate scratch")));
+
+  EXPECT_TRUE((*locks[0])->IsCancelled());
+  EXPECT_TRUE((*locks[1])->IsCancelled());
+  EXPECT_FALSE((*other)->IsCancelled());
+}

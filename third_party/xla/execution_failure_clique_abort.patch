+absl::Status AbortHeldCliques(
+    absl::Span<const std::weak_ptr<LockableGpuClique>> held,
+    const absl::Status& error) {
+  std::vector<std::shared_ptr<LockableGpuClique>> live;
+  for (const std::weak_ptr<LockableGpuClique>& clique : held) {
+    if (std::shared_ptr<LockableGpuClique> lockable_clique = clique.lock()) {
+      lockable_clique->Cancel();
+      live.push_back(std::move(lockable_clique));
+    }
+  }
+  if (live.empty()) {
+    return absl::OkStatus();
+  }
+  LOG(ERROR) << "Aborting " << live.size()
+             << " GPU cliques of an execution that failed: " << error;
+
+  // Concurrently, as AbortCliques does: an abort of one communicator may wait
+  // on a pending collective of another. A clique aborts once, whoever else
+  // aborts it (GpuClique::Abort).
+  absl::Status result;
+  absl::Mutex result_mu;
+  {
+    std::vector<std::unique_ptr<tsl::Thread>> threads;
+    for (const std::shared_ptr<LockableGpuClique>& lockable_clique : live) {
+      auto abort = [&result, &result_mu, lockable_clique]() {
+        if (absl::Status s = lockable_clique->Abort(); !s.ok()) {
+          absl::MutexLock lock(result_mu);
+          result = std::move(s);
+        }
+      };
+      threads.push_back(absl::WrapUnique(tsl::Env::Default()->StartThread(
+          tsl::ThreadOptions(), "abort", abort)));
+    }
+  }  // threads' destructor will block until all threads finish.
+  return result;
+}

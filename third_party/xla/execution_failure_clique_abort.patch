+// An execution that failed holding a clique aborts that clique and the
+// cliques split from it, while its other rank still holds its lock (as a rank
+// in a running collective does), and the clique outlives the cache's hold of
+// it until that lock goes. A clique of the key made after is another clique,
+// which the abort of the first never reaches.
+TEST(AbortCollectivesOnTaskFailureTest,
+     AbortsTheCliquesAFailedExecutionHeldAndTheirSplits) {
+  auto cleanup = absl::MakeCleanup([] { internal::DestroyAcquiredCliques(); });
+  ResetProcessTaskState();
+
+  ASSERT_OK_AND_ASSIGN(auto platform_name,
+                       xla::PlatformUtil::CanonicalPlatformName("gpu"));
+  ASSERT_OK_AND_ASSIGN(se::Platform * platform,
+                       se::PlatformManager::PlatformWithName(
+                           absl::AsciiStrToUpper(platform_name)));
+  if (platform->VisibleDeviceCount() < 2) {
+    GTEST_SKIP() << "Test requires at least 2 GPUs";
+  }
+  tsl::thread::ThreadPool pool(tsl::Env::Default(), "abort-collectives", 2);
+  tsl::Executor& exec = *pool.AsExecutor();
+  ASSERT_OK_AND_ASSIGN(std::vector<se::StreamExecutor*> executors,
+                       CreateExecutors(platform, 2));
+  GpuCollectives* collectives = GpuCollectives::Default("GPU");
+
+  GpuCliqueKey pair({kD0, kD1}, /*num_local_participants=*/2);
+  std::vector<std::vector<GlobalDeviceId>> pair_groups = {{kD0, kD1}};
+  std::vector<std::vector<GlobalDeviceId>> split_groups = {{kD0}, {kD1}};
+  std::vector<GlobalDeviceId> devices = {kD0, kD1};
+  using SharedLock = std::shared_ptr<LockableGpuClique::Lock>;
+
+  // Each rank locks the pair, then splits its clique of one from it.
+  std::vector<AcquiredCliquesMap> acquired(2);
+  std::vector<SharedLock> pair_locks(2);
+  std::vector<Future<SharedLock>> futures(2);
+  for (size_t i = 0; i < 2; ++i) {
+    futures[i] = MakeFutureOn(
+        exec, [=, &acquired, &pair_locks]() -> absl::StatusOr<SharedLock> {
+          ABSL_ASSIGN_OR_RETURN(
+              pair_locks.at(i),
+              AcquireClique(collectives, executors.at(i), RunId(0), pair,
+                            pair_groups, DefaultCliqueId(), RankId(i),
+                            acquired.at(i)));
+          acquired.at(i)[pair] = pair_locks.at(i);
+          return AcquireClique(collectives, executors.at(i), RunId(0),
+                               GpuCliqueKey({devices.at(i)}, 1), split_groups,
+                               DefaultCliqueId(), RankId(0), acquired.at(i));
+        });
+  }
+  std::vector<SharedLock> split_locks(2);
+  for (size_t i = 0; i < 2; ++i) {
+    ASSERT_OK_AND_ASSIGN(split_locks[i], futures[i].Await());
+  }
+  ASSERT_EQ((*split_locks[1])->parent(), &**pair_locks[1]);
+  HeldClique held{collectives, pair, (*pair_locks[0])->instance()};
+
+  // The failed execution's rank lets its locks go; the other rank keeps its.
+  acquired.clear();
+  pair_locks[0].reset();
+  split_locks[0].reset();
+  ASSERT_OK(AbortFailedExecutionCliques(
+      {held}, absl::ResourceExhaustedError("Failed to allocate scratch")));
+  EXPECT_TRUE((*pair_locks[1])->IsCancelled());
+  EXPECT_TRUE((*split_locks[1])->IsCancelled());
+  split_locks.clear();
+  pair_locks.clear();
+
+  // The pair locked again is another clique, which the first's abort spares.
+  std::vector<AcquiredCliquesMap> again(2);
+  for (size_t i = 0; i < 2; ++i) {
+    futures[i] = MakeFutureOn(exec, [=, &again] {
+      return AcquireClique(collectives, executors.at(i), RunId(1), pair,
+                           pair_groups, DefaultCliqueId(), RankId(i),
+                           again.at(i));
+    });
+  }
+  ASSERT_OK_AND_ASSIGN(SharedLock replacement, futures[0].Await());
+  ASSERT_OK(futures[1].Await().status());
+  EXPECT_NE((*replacement)->instance(), held.instance);
+  ASSERT_OK(AbortFailedExecutionCliques(
+      {held}, absl::ResourceExhaustedError("Failed to allocate scratch")));
+  EXPECT_FALSE((*replacement)->IsCancelled());
+}

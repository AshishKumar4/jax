+
+  ENTRY main {
+    p0 = f32[6,2,2]{2,1,0} parameter(0)
+    p1 = f32[3,2,2,3]{3,2,1,0} parameter(1)
+    p2 = s32[2,3]{1,0} parameter(2)
+    ROOT ragged-dot = f32[2,6,3]{2,1,0} ragged-dot(p0, p1, p2),
+                      lhs_contracting_dims={2}, rhs_contracting_dims={2},

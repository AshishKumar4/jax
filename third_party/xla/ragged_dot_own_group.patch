+}
+
+TEST_F(RaggedDotRewriterTest,
+       RaggedNonContractingRowsReadTheirOwnGroupAloneUnderAnOuterDim) {
+  // Group sizes over the lhs non-contracting dimension outer to the ragged
+  // one, the group dimension the rhs's last but one.
+  ExpectRowsReadTheirOwnGroup(R"(
+  HloModule module
+
+  ENTRY main {
+    p0 = f32[2,6,4]{2,1,0} parameter(0)
+    p1 = f32[4,3,5]{2,1,0} parameter(1)
+    p2 = s64[2,3]{1,0} parameter(2)
+    ROOT ragged-dot = f32[2,6,5]{2,1,0} ragged-dot(p0, p1, p2),
+                      lhs_contracting_dims={2}, rhs_contracting_dims={0},
+                      lhs_ragged_dims={1}, rhs_group_dims={1}
+  })",
+                              /*rhs_group_dim=*/1,
+                              LiteralUtil::CreateR2<int64_t>({{3, 2, 1},
+                                                              {0, 6, 0}}),
+                              RaggedDotRewriter(GetCudaComputeCapability()));
+}
+
+TEST_F(RaggedDotRewriterTest, RaggedNonContractingHoldsNoProductForEachGroup) {
+  // Its loop holds the output and one group's product: no instruction holds
+  // more elements than its largest operand (the rhs, 8 x 32 x 64), where a
+  // product for each of its 8 groups would hold 8 outputs (8 x 64 x 64).
+  ASSERT_OK_AND_ASSIGN(std::unique_ptr<HloModule> module,
+                       ParseAndReturnUnverifiedModule(R"(
+  HloModule module
+
+  ENTRY main {
+    p0 = f32[64,32]{1,0} parameter(0)
+    p1 = f32[8,32,64]{2,1,0} parameter(1)
+    p2 = s32[8]{0} parameter(2)
+    ROOT ragged-dot = f32[64,64]{1,0} ragged-dot(p0, p1, p2),
+                      lhs_contracting_dims={1}, rhs_contracting_dims={1},
+                      lhs_ragged_dims={0}, rhs_group_dims={0}
+  })"));
+  ASSERT_OK_AND_ASSIGN(
+      bool changed,
+      RaggedDotRewriter(GetCudaComputeCapability()).Run(module.get()));
+  ASSERT_TRUE(changed);
+  for (const HloComputation* computation : module->computations()) {
+    for (const HloInstruction* instruction : computation->instructions()) {
+      if (instruction->shape().IsArray()) {
+        EXPECT_LE(ShapeUtil::ElementsIn(instruction->shape()), 8 * 32 * 64)
+            << instruction->ToString();
+      }
+    }
+  }
+}

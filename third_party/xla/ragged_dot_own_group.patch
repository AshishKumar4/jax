+               absl::FunctionRef<float(absl::Span<const int64_t>)> value) {
+  Literal literal(shape);
+  CHECK_OK(literal.Populate<float>(value));
+  return literal;
+}
+
+// Each row's product reads its own group's matrix alone, as the evaluator's
+// ragged dot computes it: one group's infinity weight (group 1's, along
+// `rhs_group_dim`) leaves every other group's rows finite and as they were,
+// where 0 * inf made them NaN (Dew row 13562); a row in no group is zero.
+void ExpectRowsReadTheirOwnGroup(absl::string_view hlo, int rhs_group_dim,
+                                 const Literal& group_sizes,
+                                 RaggedDotRewriter rewriter) {
+  ASSERT_OK_AND_ASSIGN(std::unique_ptr<HloModule> ragged,
+                       ParseAndReturnUnverifiedModule(hlo));
+  std::unique_ptr<HloModule> rewritten = ragged->Clone();
+  ASSERT_OK_AND_ASSIGN(bool changed, rewriter.Run(rewritten.get()));
+  ASSERT_TRUE(changed);
+  const HloInstruction* root = ragged->entry_computation()->root_instruction();
+  Literal lhs = Filled(root->operand(0)->shape(),
+                       [](absl::Span<const int64_t> index) {
+                         return 1.0f + absl::c_accumulate(index, 0) % 3;
+                       });
+  Literal rhs = Filled(root->operand(1)->shape(),
+                       [&](absl::Span<const int64_t> index) {
+                         return index[rhs_group_dim] == 1
+                                    ? std::numeric_limits<float>::infinity()
+                                    : 0.5f + index.back();
+                       });
+  ASSERT_OK_AND_ASSIGN(Literal want, HloEvaluator().Evaluate(
+                                         *ragged, {&lhs, &rhs, &group_sizes}));
+  ASSERT_OK_AND_ASSIGN(Literal got,
+                       HloEvaluator().Evaluate(*rewritten,
+                                               {&lhs, &rhs, &group_sizes}));
+  // Literals compare their floats by value: a NaN in either is a difference.
+  EXPECT_EQ(got, want);
+}
+
+TEST_F(RaggedDotRewriterTest, RaggedNonContractingRowsReadTheirOwnGroupAlone) {
+  // Row 3 in no group (sizes 1 and 2 of 4 rows).
+  ExpectRowsReadTheirOwnGroup(R"(
+  HloModule module
+
+  ENTRY main {
+    p0 = f32[4,2]{1,0} parameter(0)
+    p1 = f32[2,2,3]{2,1,0} parameter(1)
+    p2 = s32[2]{0} parameter(2)
+    ROOT ragged-dot = f32[4,3]{1,0} ragged-dot(p0, p1, p2),
+                      lhs_contracting_dims={1}, rhs_contracting_dims={1},
+                      lhs_ragged_dims={0}, rhs_group_dims={0}
+  })",
+                              /*rhs_group_dim=*/0,
+                              LiteralUtil::CreateR1<int32_t>({1, 2}),
+                              RaggedDotRewriter(GetCudaComputeCapability()));
+}
+
+TEST_F(RaggedDotRewriterTest,
+       RaggedNonContractingRowsReadTheirOwnGroupAloneInEachBatch) {

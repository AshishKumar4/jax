diff --git a/xla/codegen/emitters/elemental_hlo_to_mlir.cc b/xla/codegen/emitters/elemental_hlo_to_mlir.cc
index 4e03097b85..1803aecc8f 100644
--- a/xla/codegen/emitters/elemental_hlo_to_mlir.cc
+++ b/xla/codegen/emitters/elemental_hlo_to_mlir.cc
@@ -14,6 +14,7 @@ limitations under the License.
 ==============================================================================*/
 #include "xla/codegen/emitters/elemental_hlo_to_mlir.h"
 
+#include <array>
 #include <cstddef>
 #include <cstdint>
 #include <functional>
@@ -582,6 +583,34 @@ absl::StatusOr<SmallVector<Value, 1>> EmitDotLoop(
                               /*operand_index=*/1, rhs_indices));
     Value accum = iter_args[0];
 
+    // A mixed precision dot's operands: an integer one's are converted to its
+    // accumulator type (s32 x s64 -> s32), a floating point one's narrower
+    // operand to the wider's (f16 x f32 -> f32), as each is multiplied.
+    PrimitiveType result_type = instr->shape().element_type();
+    if (primitive_util::IsIntegralType(result_type)) {
+      for (auto [operand_index, value] :
+           llvm::enumerate(std::array<Value*, 2>{&lhs_value, &rhs_value})) {
+        if (value->getType() != accumulator_type) {
+          *value = mhlo::MhloOpToStdScalarOp::mapConvertOpToStdScalarOp(
+              b.getLoc(), PrimitiveTypeToMlirTypeWithSign(result_type, b),
+              accumulator_type,
+              {PrimitiveTypeToMlirTypeWithSign(
+                  instr->operand(operand_index)->shape().element_type(), b)},
+              {*value}, /*attributes=*/{}, &b);
+        }
+      }
+    } else if (primitive_util::IsFloatingPointType(result_type) &&
+               lhs_value.getType() != rhs_value.getType()) {
+      // Two types of one width (f16 x bf16) are multiplied in F32.
+      unsigned lhs_width = lhs_value.getType().getIntOrFloatBitWidth();
+      unsigned rhs_width = rhs_value.getType().getIntOrFloatBitWidth();
+      mlir::Type wider = lhs_width > rhs_width   ? lhs_value.getType()
+                         : rhs_width > lhs_width ? rhs_value.getType()
+                                                 : mlir::Type(b.getF32Type());
+      lhs_value = EmitFloatCast(lhs_value, wider, b);
+      rhs_value = EmitFloatCast(rhs_value, wider, b);
+    }
+
     if (algorithm_util::IsBf16ToF32AlgorithmRequested(instr)) {
       Value lhs_trunc = arith::TruncFOp::create(b, b.getBF16Type(), lhs_value);
       lhs_value = arith::ExtFOp::create(b, b.getF32Type(), lhs_trunc);

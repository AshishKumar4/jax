@@ -331,6 +332,52 @@ TEST_P(ScatterDeterminismExpanderTest,
   EXPECT_EQ(actual_result, expected_result);
 }
 
+TEST_P(ScatterDeterminismExpanderTest,
+       FlattenedIndicesAreComputedInTheIndicesType) {
+  // Two index columns are flattened by a dot with their strides, which takes
+  // the indices' type: a mixed s32 x s64 dot left an elemental emitter
+  // multiplying an i32 by an i64.
+  auto index_type = GetParam();
+  const char* const kModuleTemplate = R"(
+    HloModule scatter_determinism_expander
+
+    scatter_computation {
+      arg1.173 = f32[] parameter(1)
+      arg0.172 = f32[] parameter(0)
+      ROOT add.48 = f32[] add(arg0.172, arg1.173)
+    }
+
+    ENTRY scatter_add_computation {
+      operand = f32[3, 3] parameter(0)
+      indices = $0[3, 2] parameter(1)
+      updates = f32[3] parameter(2)
+      ROOT scatter.48 = f32[3,3] scatter(operand, indices, updates),
+        update_window_dims={}, inserted_window_dims={0, 1},
+        scatter_dims_to_operand_dims={0, 1}, index_vector_dim=1,
+        to_apply=scatter_computation
+    })";
+
+  const std::string hlo = absl::Substitute(
+      kModuleTemplate, primitive_util::LowercasePrimitiveTypeName(index_type));
+  ASSERT_OK_AND_ASSIGN(auto module, ParseAndReturnVerifiedModule(hlo));
+  ASSERT_OK_AND_ASSIGN(bool result,
+                       RunScatterDeterminismExpander(module.get()));
+  ASSERT_TRUE(result);
+
+  int dots = 0;
+  for (HloComputation* computation : module->computations()) {
+    for (HloInstruction* instruction : computation->instructions()) {
+      if (instruction->opcode() != HloOpcode::kDot) {
+        continue;
+      }
+      ++dots;
+      EXPECT_EQ(instruction->operand(0)->shape().element_type(), index_type);
+      EXPECT_EQ(instruction->operand(1)->shape().element_type(), index_type);
+    }
+  }
+  EXPECT_EQ(dots, 1);
+}

From 8c2ec3d44d1804fb00f3c567af95dc60cfcf1052 Mon Sep 17 00:00:00 2001
From: Ashish Kumar Singh <ashishkmr472@gmail.com>
Date: Sat, 21 Nov 2026 07:56:03 -0600
Subject: [PATCH 1/2] [XLA:GPU] ScatterDeterminismExpander flattens indices in
 their own type

FlattenIndices multiplied the index columns by an S64 strides constant
whatever the indices' type, so S32 indices made an s32 x s64 -> s32 dot,
which the elemental emitter multiplied as `arith.muli (i32, i64)`: LLVM IR
translation fails ("Both operands to a binary operator are not of the same
type", RET_CHECK mlir_kernel_emitter.cc) wherever nothing rewrote the dot
first (the algebraic simplifier disabled). The strides are converted to the
indices' type.
---
 .../scatter_determinism_expander.cc           |  8 +++-
 .../scatter_determinism_expander_test.cc      | 47 +++++++++++++++++++
 2 files changed, 53 insertions(+), 2 deletions(-)

diff --git a/xla/backends/gpu/transforms/scatter_determinism_expander.cc b/xla/backends/gpu/transforms/scatter_determinism_expander.cc
index 4c0685dc6f..efc18f34fc 100644
--- a/xla/backends/gpu/transforms/scatter_determinism_expander.cc
+++ b/xla/backends/gpu/transforms/scatter_determinism_expander.cc
@@ -161,8 +161,12 @@ HloInstruction* FlattenIndices(
     int64_t operand_dim = scatter_dims_to_operand_dims[i];
     strides(i, 0) = operand_strides[operand_dim];
   }
-  auto strides_tensor = parent->AddInstruction(HloInstruction::CreateConstant(
-      LiteralUtil::CreateR2FromArray2D<int64_t>(strides)));
+  // The strides in the indices' type, so the dot multiplies one type.
+  auto strides_tensor = parent->AddInstruction(HloInstruction::CreateConvert(
+      ShapeUtil::MakeShape(indices->shape().element_type(),
+                           {num_index_cols, 1}),
+      parent->AddInstruction(HloInstruction::CreateConstant(
+          LiteralUtil::CreateR2FromArray2D<int64_t>(strides)))));
 
   // Calculate the flattened indices via dot product
   auto dot_shape = ShapeUtil::MakeShape(indices->shape().element_type(),

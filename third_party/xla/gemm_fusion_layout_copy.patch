+TEST_F(GemmFusionTestV2, BitcastIsNotHoistedAboveALayoutChangingCopy) {
+  // The copy permutes storage, {0,1} to {1,0}: hoisting the bitcast above it,
+  // as above an elementwise op, would leave the copy an identity and read the
+  // parameter's storage in the wrong order (a ragged dot's adjoint, Dew ledger
+  // 1691).
+  ASSERT_OK_AND_ASSIGN(auto module, ParseAndReturnVerifiedModule(R"(
+HloModule m
+
+ENTRY e {
+  p0 = f32[2,5,3]{2,1,0} parameter(0)
+  p1 = f32[4,3]{0,1} parameter(1)
+  c1 = f32[4,3]{1,0} copy(p1)
+  b1 = f32[2,2,3]{2,1,0} bitcast(c1)
+  ROOT d = f32[2,5,2]{2,1,0} dot(p0, b1),
+    lhs_batch_dims={0}, lhs_contracting_dims={2},
+    rhs_batch_dims={0}, rhs_contracting_dims={2}
+})"));
+  ASSERT_TRUE(GemmFusion(device_info_).Run(module.get()).ok());
+  bool permutes = false;
+  for (const HloComputation* computation : module->computations()) {
+    for (const HloInstruction* instruction : computation->instructions()) {
+      permutes |= instruction->opcode() == HloOpcode::kCopy &&
+                  !(instruction->shape().layout() ==
+                    instruction->operand(0)->shape().layout());
+    }
+  }
+  EXPECT_TRUE(permutes) << module->ToString();
+}

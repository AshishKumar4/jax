+// A logical elementwise copy can permute physical storage. Commuting a
+// bitcast through that copy with one shared layout erases its permutation.
+bool IsStorageOrderPreservingElementwise(const HloInstruction* instruction) {
+  return instruction->IsElementwise() &&
+         (instruction->opcode() != HloOpcode::kCopy ||
+          ShapeUtil::Equal(instruction->shape(),
+                           instruction->operand(0)->shape()));
+}

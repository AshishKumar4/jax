+TEST_F(DotStrengthReductionTest, F16VectorDotWithTheF16F16F32AlgorithmMultipliesInF32) {
+  // GPU algorithm support accepts F16_F16_F32 (algorithm_util), so its small
+  // dots are strength-reduced too: each f16 product widened to f32 before it is
+  // taken, summed in f32 (Dew ledger 1691).
+  const std::string& hlo_string = R"(
+HloModule m
+
+ENTRY entry {
+  p0 = f16[2] parameter(0)
+  p1 = f16[2] parameter(1)
+  ROOT dot = f32[] dot(p0, p1), lhs_contracting_dims={0},
+    rhs_contracting_dims={0}, algorithm=dot_f16_f16_f32
+})";
+  ASSERT_OK_AND_ASSIGN(auto module, ParseAndReturnVerifiedModule(hlo_string));
+  DotStrengthReduction pass{
+      se::GpuComputeCapability(se::CudaComputeCapability::Ampere())};
+  ASSERT_OK_AND_ASSIGN(bool changed, this->RunHloPass(&pass, module.get()));
+  EXPECT_TRUE(changed);
+  CHECK_OK(module->Verify());
+
+  const char* filecheck_pattern = R"(
+// CHECK-DAG: f32[2]{{[^ ]*}} convert(
+// CHECK: f32[2]{{[^ ]*}} multiply
+// CHECK: f32[] reduce
+)";
+
+  ASSERT_OK_AND_ASSIGN(bool filecheck_result,
+                       RunFileCheck(module->ToString(), filecheck_pattern));
+  EXPECT_TRUE(filecheck_result);
+}

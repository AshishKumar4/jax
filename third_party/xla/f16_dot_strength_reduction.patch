+++ b/xla/service/gpu/matmul_utils.cc
@@ -1247,6 +1247,24 @@ absl::StatusOr<HloInstruction*> MakeMultiplyForDotPrecisionAlgorithm(
     HloInstruction* lhs, HloInstruction* rhs,
     const PrecisionConfig::Algorithm& algorithm) {
   switch (algorithm) {
+    case PrecisionConfig::ALG_DOT_F16_F16_F32: {
+      // Products of f16 values are exactly representable in f32. Widen before
+      // multiplying, not after: narrowing a product to f16 loses information
+      // that an f32 accumulation must retain.
+      auto widen = [](HloInstruction* value) {
+        if (value->shape().element_type() == F32) {
+          return value;
+        }
+        Shape shape = value->shape();
+        shape.set_element_type(F32);
+        return value->parent()->AddInstruction(
+            HloInstruction::CreateConvert(shape, value));
+      };
+      lhs = widen(lhs);
+      rhs = widen(rhs);
+      return lhs->parent()->AddInstruction(HloInstruction::CreateBinary(
+          lhs->shape(), HloOpcode::kMultiply, lhs, rhs));
+    }
     case PrecisionConfig::ALG_DOT_BF16_BF16_F32:
       return DotAlgorithmRewriter::MakeMultiplyForBF16BF16F32(lhs, rhs);
     case PrecisionConfig::ALG_DOT_BF16_BF16_F32_X3:

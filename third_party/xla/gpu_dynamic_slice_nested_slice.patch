+// Drops each sliced parameter whose slice reads a buffer another sliced
+// parameter's chain makes (a slice of a dynamic slice, both read by the hero):
+// the fusion's slices read its parameters, so that parameter stays outside it,
+// its chain an operand of the fusion, and the other chain is fused alone.
+// Planned with it, its slice would be cloned before the chain making its
+// buffer, whose clone it reads (CreateFusionBody).
+void DropParametersSlicingFusedBuffers(
+    std::vector<SlicedParameter>& sliced_params) {
+  absl::flat_hash_set<const HloInstruction*> fused;
+  for (const SlicedParameter& param : sliced_params) {
+    fused.insert(param.slice);
+    fused.insert(param.noops.begin(), param.noops.end());
+  }
+  sliced_params.erase(
+      std::remove_if(sliced_params.begin(), sliced_params.end(),
+                     [&](const SlicedParameter& param) {
+                       return fused.contains(param.slice->operand(0));
+                     }),
+      sliced_params.end());
+}
+
+// Keeps out of the fusion each sliced result whose dynamic-update-slice writes
+// into a buffer the fusion makes (a captured slice, the hero, another result's
+// chain): a captured update's target is a fusion parameter. A tuple hero's
+// element so dropped passes through, its GTE kept; a lone result is no sliced
+// result. Run after the parameters' (`DropParametersSlicingFusedBuffers`),
+// against the plan they leave, until no result is dropped.
+void DropResultsUpdatingFusedBuffers(
+    const HloInstruction* hero,
+    absl::Span<const SlicedParameter> sliced_params,
+    std::vector<SlicedResult>& sliced_results) {
+  bool dropped = true;
+  while (dropped) {
+    dropped = false;
+    absl::flat_hash_set<const HloInstruction*> fused = {hero};
+    for (const SlicedParameter& param : sliced_params) {
+      fused.insert(param.slice);
+      fused.insert(param.noops.begin(), param.noops.end());
+    }
+    for (const SlicedResult& result : sliced_results) {
+      fused.insert(result.noops.begin(), result.noops.end());
+      if (result.update_slice != nullptr) {
+        fused.insert(result.update_slice);
+      }
+    }
+    for (SlicedResult& result : sliced_results) {
+      if (result.update_slice == nullptr ||
+          !fused.contains(result.update_slice->operand(0))) {
+        continue;
+      }
+      result.update_slice = nullptr;
+      result.noops.resize(std::min<size_t>(result.noops.size(), 1));
+      dropped = true;
+    }
+  }
+  if (!hero->shape().IsTuple()) {
+    sliced_results.erase(
+        std::remove_if(sliced_results.begin(), sliced_results.end(),
+                       [](const SlicedResult& result) {
+                         return result.update_slice == nullptr;
+                       }),
+        sliced_results.end());
+  }
+}

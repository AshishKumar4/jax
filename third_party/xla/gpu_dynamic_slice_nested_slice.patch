+    HloModule test
+
+    ENTRY main {
+      %p0 = f32[2,8,8]{2,1,0} parameter(0)
+      %slice = f32[1,8,8]{2,1,0} slice(%p0), slice={[1:2], [0:8], [0:8]}
+      %bitcast0 = f32[8,8]{1,0} bitcast(%slice)
+      %hero = (f32[8,8]{1,0}, f32[8,8]{1,0}) custom-call(%bitcast0),
+        custom_call_target="fake_target"
+      %gte0 = f32[8,8]{1,0} get-tuple-element(%hero), index=0
+      %gte1 = f32[8,8]{1,0} get-tuple-element(%hero), index=1
+      %target = f32[1,8,8]{2,1,0} bitcast(%gte0)
+      %update = f32[1,8,8]{2,1,0} bitcast(%gte1)
+      %c0 = s32[] constant(0)
+      %dus = f32[1,8,8]{2,1,0} dynamic-update-slice(%target, %update, %c0,
+        %c0, %c0)
+      ROOT %root = (f32[8,8]{1,0}, f32[1,8,8]{2,1,0}) tuple(%gte0, %dus)

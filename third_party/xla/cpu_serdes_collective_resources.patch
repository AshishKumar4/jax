diff --git a/xla/backends/cpu/runtime/thunk_sequence_serdes_test.cc b/xla/backends/cpu/runtime/thunk_sequence_serdes_test.cc
index b96226abb7..c475fd9de1 100644
--- a/xla/backends/cpu/runtime/thunk_sequence_serdes_test.cc
+++ b/xla/backends/cpu/runtime/thunk_sequence_serdes_test.cc
@@ -1389,6 +1389,146 @@ TYPED_TEST(ThunkSequenceSerdesTest, ResourceSharingRecounstruction) {

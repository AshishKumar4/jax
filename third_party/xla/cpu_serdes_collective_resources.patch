-    ABSL_ASSIGN_OR_RETURN(*proto.add_thunks(), thunk_serdes.ToProto(*thunk));
+    // A nested sequence's communicators get their ids here, before the thunk
+    // holding it lists them among its resource uses below.
+    ABSL_ASSIGN_OR_RETURN(*proto.add_thunks(),
+                          thunk_serdes.ToProto(*thunk, communicator_ids));
     for (auto& resource_use : thunk->resource_uses()) {
-      Resource* resource = resource_use.resource().get();
-      if (resource) {
-        resource_users[resource].push_back(thunk_index);
+      const Resource* resource = resource_use.resource().get();
+      if (!resource) {
+        continue;
       }
+      auto [row, inserted] =
+          resource_rows.try_emplace(resource, proto.thunk_resources_size());
+      if (inserted) {
+        ThunkSequenceProto::ResourceUsersProto* resource_users_proto =
+            proto.add_thunk_resources();
+        switch (resource->kind()) {
+          case Resource::Kind::kToken:
+            resource_users_proto->mutable_resource()->set_kind(
+                ResourceProto::TOKEN);
+            break;
+          case Resource::Kind::kCollectiveCommunicator:
+            resource_users_proto->mutable_resource()->set_kind(
+                ResourceProto::COLLECTIVE_COMMUNICATOR);
+            resource_users_proto->set_resource_id(
+                communicator_ids
+                    .try_emplace(resource, communicator_ids.size() + 1)
+                    .first->second);
+            break;
+          default:
+            return absl::InvalidArgumentError(absl::StrFormat(
+                "Unsupported resource kind: %d", resource->kind()));
+        }
+      }
+      proto.mutable_thunk_resources(row->second)
+          ->add_thunk_indices(thunk_index);
     }
     thunk_index++;
   }
 
-  for (const auto& [resource, users] : resource_users) {

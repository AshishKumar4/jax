+// Appends `thunk` to `thunk_sequence`; a fatal failure if it is an error.
+void Append(ThunkSequence& thunk_sequence,
+            absl::StatusOr<std::unique_ptr<Thunk>> thunk) {
+  ABSL_ASSERT_OK(thunk);
+  thunk_sequence.push_back(*std::move(thunk));
+}
+
+// The communicator resource of every collective thunk in `thunk_sequence` and
+// the sequences nested in it, in a depth-first order that two sequences of the
+// same structure share.
+void CollectCommunicatorResources(const ThunkSequence& thunk_sequence,
+                                  std::vector<const Resource*>& resources) {
+  for (const auto& thunk : thunk_sequence) {
+    for (const auto& [name, nested] : thunk->nested_thunks()) {
+      CollectCommunicatorResources(*nested, resources);
+    }
+    if (thunk->kind() == Thunk::Kind::kCollective) {
+      resources.push_back(absl::down_cast<const CollectiveThunk&>(*thunk)
+                              .op_resources()
+                              .communicator_resource.get());
+    }
+  }
+}
+
+// The resources `thunk` uses, a while, call or conditional thunk's those of
+// its nested sequences.
+absl::flat_hash_set<const Resource*> UsedResources(const Thunk& thunk) {
+  absl::flat_hash_set<const Resource*> used;
+  for (const ResourceUse& use : thunk.resource_uses()) {
+    used.insert(use.resource().get());
+  }
+  return used;
+}
+
+// The CPU thunk emitter gives every collective of a program one communicator
+// resource, those in a while loop's body, a call's and a conditional's branches
+// included, and a while, call or conditional thunk uses its nested sequences'
+// resources: the execution graph orders a loop against the collectives beside
+// it by that resource. Deserializing each nested sequence's resources apart
+// lost the order: after a roundtrip through a compilation cache, ranks entered
+// a loop's all-reduce and an all-gather beside the loop in different orders,
+// and their rendezvous timed out. A second communicator, shared the same way,
+// stays apart from the first.
+TYPED_TEST(ThunkSequenceSerdesTest, ResourceSharingAcrossNestedSequences) {
+  std::shared_ptr<Resource> first =
+      Resource::Create(Resource::Kind::kCollectiveCommunicator);
+  std::shared_ptr<Resource> second =
+      Resource::Create(Resource::Kind::kCollectiveCommunicator);
+
+  ThunkSequence thunk_sequence;
+  ASSERT_NO_FATAL_FAILURE(
+      Append(thunk_sequence, this->CreateAllGatherThunk(first)));
+  {
+    ThunkSequence cond_sequence;
+    ASSERT_NO_FATAL_FAILURE(
+        Append(cond_sequence, this->CreateAllToAllThunk(first)));
+    ThunkSequence body_sequence;
+    ASSERT_NO_FATAL_FAILURE(
+        Append(body_sequence, this->CreateAllReduceThunk(first)));
+    ASSERT_NO_FATAL_FAILURE(
+        Append(body_sequence, this->CreateReduceScatterThunk(second)));
+    ABSL_ASSERT_OK(this->AddPredBufferAllocation());
+    const BufferAllocation& cond_allocation =
+        this->buffer_allocations_[this->buffer_allocations_.size() - 1];
+    ASSERT_NO_FATAL_FAILURE(Append(
+        thunk_sequence,
+        WhileThunk::Create(Thunk::Info(),
+                           CreateBufferAllocationSlice(cond_allocation),
+                           std::move(cond_sequence), std::move(body_sequence),
+                           /*trip_count=*/std::nullopt)));
+  }
+  {
+    ThunkSequence called_sequence;
+    ASSERT_NO_FATAL_FAILURE(
+        Append(called_sequence, this->CreateAllReduceThunk(first)));
+    ASSERT_NO_FATAL_FAILURE(
+        Append(thunk_sequence,
+               CallThunk::Create(Thunk::Info(), std::move(called_sequence))));
+  }
+  {
+    std::vector<ThunkSequence> branch_sequences(2);
+    ASSERT_NO_FATAL_FAILURE(
+        Append(branch_sequences[0], this->CreateAllGatherThunk(first)));
+    ASSERT_NO_FATAL_FAILURE(Append(branch_sequences[1],
+                                   this->CreateCollectivePermuteThunk(second)));
+    ABSL_ASSERT_OK(this->AddPredBufferAllocation());
+    const BufferAllocation& branch_index_allocation =
+        this->buffer_allocations_[this->buffer_allocations_.size() - 1];
+    ASSERT_NO_FATAL_FAILURE(Append(
+        thunk_sequence,
+        ConditionalThunk::Create(
+            Thunk::Info(), CreateBufferAllocationSlice(branch_index_allocation),
+            std::move(branch_sequences))));
+  }
+  ASSERT_NO_FATAL_FAILURE(
+      Append(thunk_sequence, this->CreateReduceScatterThunk(second)));
+
+  absl::StatusOr<std::string> serialized = this->Serialize(thunk_sequence);
+  ABSL_ASSERT_OK(serialized);
+  absl::StatusOr<std::unique_ptr<ThunkSequence>> deserialized =
+      this->Deserialize(*serialized);
+  ABSL_ASSERT_OK(deserialized);
+  ASSERT_TRUE(
+      this->VerifyThunkSequenceEquality(thunk_sequence, **deserialized));
+
+  // Every collective shares a communicator after the roundtrip exactly when it
+  // did before it.
+  std::vector<const Resource*> before, after;
+  CollectCommunicatorResources(thunk_sequence, before);
+  CollectCommunicatorResources(**deserialized, after);
+  ASSERT_EQ(before.size(), 8u);
+  ASSERT_EQ(after.size(), before.size());
+  for (size_t i = 0; i < before.size(); ++i) {
+    ASSERT_NE(after[i], nullptr);
+    for (size_t j = 0; j < before.size(); ++j) {
+      EXPECT_EQ(before[i] == before[j], after[i] == after[j])
+          << "collectives " << i << " and " << j;
+    }
+  }
+
+  // So the while, call and conditional thunks use the communicators of the
+  // collectives beside them, which the execution graph orders them by.
+  const ThunkSequence& sequence = **deserialized;
+  const Resource* first_after =
+      absl::down_cast<const CollectiveThunk&>(*sequence[0])
+          .op_resources()
+          .communicator_resource.get();
+  const Resource* second_after =
+      absl::down_cast<const CollectiveThunk&>(*sequence[4])
+          .op_resources()
+          .communicator_resource.get();
+  ASSERT_NE(first_after, second_after);
+  using Used = absl::flat_hash_set<const Resource*>;
+  EXPECT_EQ(UsedResources(*sequence[1]), (Used{first_after, second_after}));
+  EXPECT_EQ(UsedResources(*sequence[2]), Used{first_after});
+  EXPECT_EQ(UsedResources(*sequence[3]), (Used{first_after, second_after}));
+
+  // A second deserialization of the same bytes has resources of its own.
+  absl::StatusOr<std::unique_ptr<ThunkSequence>> deserialized_again =
+      this->Deserialize(*serialized);
+  ABSL_ASSERT_OK(deserialized_again);
+  std::vector<const Resource*> again;
+  CollectCommunicatorResources(**deserialized_again, again);
+  ASSERT_EQ(again.size(), after.size());
+  for (size_t i = 0; i < again.size(); ++i) {
+    EXPECT_FALSE(absl::c_linear_search(after, again[i])) << "collective " << i;
+  }
+}
+
+// A sequence's resource rows follow its first use of each resource, whatever
+// the resources' addresses, so a sequence serializes to the same bytes each
+// time. Communicators carry ids, numbered as the sequence tree first uses them
+// (a loop's body before the loop's own row); tokens carry none.
+TYPED_TEST(ThunkSequenceSerdesTest, ResourceRowsInFirstUseOrder) {
+  std::shared_ptr<Resource> first =
+      Resource::Create(Resource::Kind::kCollectiveCommunicator);
+  std::shared_ptr<Resource> second =
+      Resource::Create(Resource::Kind::kCollectiveCommunicator);
+  std::shared_ptr<Resource> token = Resource::Create(Resource::Kind::kToken);
+
+  ThunkSequence thunk_sequence;
+  ASSERT_NO_FATAL_FAILURE(
+      Append(thunk_sequence, this->CreateAllGatherThunk(second)));
+  {
+    ThunkSequence body_sequence;
+    ASSERT_NO_FATAL_FAILURE(
+        Append(body_sequence, this->CreateAllReduceThunk(first)));
+    ABSL_ASSERT_OK(this->AddPredBufferAllocation());
+    const BufferAllocation& cond_allocation =
+        this->buffer_allocations_[this->buffer_allocations_.size() - 1];
+    ASSERT_NO_FATAL_FAILURE(Append(
+        thunk_sequence,
+        WhileThunk::Create(Thunk::Info(),
+                           CreateBufferAllocationSlice(cond_allocation),
+                           /*cond_sequence=*/ThunkSequence(),
+                           std::move(body_sequence),
+                           /*trip_count=*/std::nullopt)));
+  }
+  {
+    ABSL_ASSERT_OK(this->AddBufferAllocations(1));
+    const BufferAllocation& infeed_allocation =
+        this->buffer_allocations_[this->buffer_allocations_.size() - 1];
+    ASSERT_NO_FATAL_FAILURE(Append(
+        thunk_sequence,
+        InfeedThunk::Create(
+            Thunk::Info(),
+            {{CreateBufferAllocationSlice(infeed_allocation),
+              this->literals_.back().shape()}},
+            InfeedThunk::InfeedResources{/*consume_token=*/token,
+                                         /*produce_token=*/token})));
+  }
+  ASSERT_NO_FATAL_FAILURE(
+      Append(thunk_sequence, this->CreateAllToAllThunk(first)));
+  ASSERT_NO_FATAL_FAILURE(
+      Append(thunk_sequence, this->CreateReduceScatterThunk(second)));
+
+  auto* serdes = absl::down_cast<ThunkSequenceSerDesProtobuf*>(
+      this->thunk_sequence_serdes());
+  ASSERT_NE(serdes, nullptr);
+  absl::StatusOr<ThunkSequenceProto> proto = serdes->ToProto(thunk_sequence);
+  ABSL_ASSERT_OK(proto);
+
+  // `second` is first used by thunk 0 and given id 1; the loop's body, written
+  // before the loop's row, gives `first` id 2; the token, first used by thunk
+  // 2, has no id.
+  ASSERT_EQ(proto->thunk_resources_size(), 3);
+  const auto& rows = proto->thunk_resources();
+  EXPECT_EQ(rows[0].resource().kind(), ResourceProto::COLLECTIVE_COMMUNICATOR);
+  EXPECT_EQ(rows[0].resource_id(), 1);
+  EXPECT_EQ(std::vector<int64_t>(rows[0].thunk_indices().begin(),
+                                 rows[0].thunk_indices().end()),
+            (std::vector<int64_t>{0, 4}));
+  EXPECT_EQ(rows[1].resource().kind(), ResourceProto::COLLECTIVE_COMMUNICATOR);
+  EXPECT_EQ(rows[1].resource_id(), 2);
+  EXPECT_EQ(std::vector<int64_t>(rows[1].thunk_indices().begin(),
+                                 rows[1].thunk_indices().end()),
+            (std::vector<int64_t>{1, 3}));
+  EXPECT_EQ(rows[2].resource().kind(), ResourceProto::TOKEN);
+  EXPECT_EQ(rows[2].resource_id(), 0);
+  const ThunkSequenceProto& body =
+      proto->thunks(1).while_thunk().body_sequence();
+  ASSERT_EQ(body.thunk_resources_size(), 1);
+  EXPECT_EQ(body.thunk_resources(0).resource_id(), 2);
+
+  absl::StatusOr<ThunkSequenceProto> again = serdes->ToProto(thunk_sequence);
+  ABSL_ASSERT_OK(again);
+  EXPECT_EQ(again->SerializeAsString(), proto->SerializeAsString());
+}

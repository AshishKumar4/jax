+// One resource keeps one identity across a thunk sequence and the sequences
+// nested in it: the CPU thunk emitter gives every collective one communicator
+// resource, those in a while loop's body included, and the execution graph
+// orders the collectives (and the loop thunk, which uses its body's resources)
+// by it. Deserializing each nested sequence's resources apart dropped that
+// order between a loop and the collectives beside it, so ranks could enter
+// them in different orders and never meet in the rendezvous.
+struct ThunkSequenceSerDesProtobuf::ResourceIdentity {
+  // Serialization: each resource's id, from 1, in the order the sequence tree
+  // first uses it.
+  absl::flat_hash_map<const Resource*, int64_t> ids;
+  // Deserialization: the resource deserialized for each id.
+  absl::flat_hash_map<int64_t, std::shared_ptr<Resource>> resources;
+};
+

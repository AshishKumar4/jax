+static absl::StatusOr<ThunkSequenceProto> ThunkSequenceToProto(
+    const ThunkSequence& thunk_sequence, CommunicatorIds& communicator_ids) {
+  ThunkSerDesProtobuf thunk_serdes;
   ThunkSequenceProto proto;
   proto.mutable_thunks()->Reserve(thunk_sequence.size());
 
+  // Each resource's row, appended when the sequence first uses the resource,
+  // so the serialized rows do not depend on where it was allocated.
+  absl::flat_hash_map<const Resource*, int> resource_rows;

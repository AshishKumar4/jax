+// A program's collectives share one communicator resource, those in a while
+// loop's body, a call's and a conditional's branches included (the CPU thunk
+// emitter creates one), and a while, call or conditional thunk uses its nested
+// sequences' resources: the execution graph orders a loop against the
+// collectives beside it by that communicator. A serialized communicator carries
+// an id unique across the thunk sequence and the sequences nested in it
+// (ThunkSequenceProto.ResourceUsersProto.resource_id), so it deserializes as
+// one resource there too; deserialized apart, a loop lost its edges to the
+// collectives beside it, and ranks entered them in different orders and never
+// met in the rendezvous. Tokens keep the encoding without ids: infeed and
+// outfeed thunks recreate theirs from their own protos.
+//
+// Serialization: each communicator's id, from 1, in the order the sequence
+// tree first uses it.
+using CommunicatorIds = absl::flat_hash_map<const Resource*, int64_t>;
+// Deserialization: the communicator deserialized for each id.
+using CommunicatorsById =
+    absl::flat_hash_map<int64_t, std::shared_ptr<Resource>>;
+
+// One sequence of the tree a top-level ToProto or FromProto call walks, with
+// the tree's communicators.
+static absl::StatusOr<ThunkSequenceProto> ThunkSequenceToProto(
+    const ThunkSequence& thunk_sequence, CommunicatorIds& communicator_ids);
+static absl::StatusOr<std::unique_ptr<ThunkSequence>> ThunkSequenceFromProto(
+    const ThunkSequenceProto& proto, const HloModule* hlo_module,
+    const std::vector<BufferAllocation>* buffer_allocations,
+    CommunicatorsById& communicators);
+

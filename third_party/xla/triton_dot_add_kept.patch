 namespace {
 
@@ -45,6 +55,22 @@ std::vector<std::string> GetPassNames(const mlir::PassManager& pm) {
   return pass_names;
 }
 
+// `module` after Triton's combine, as the CUDA pipeline runs it, printed.
+std::string Combined(absl::string_view module) {
+  mlir::MLIRContext ctx;
+  ctx.loadDialect<mlir::triton::TritonDialect, mlir::arith::ArithDialect>();
+  mlir::OwningOpRef<mlir::ModuleOp> parsed =
+      mlir::parseSourceString<mlir::ModuleOp>(module, &ctx);
+  EXPECT_TRUE(parsed);
+  mlir::PassManager pm(&ctx);
+  pm.addPass(mlir::triton::createTritonCombineOps());
+  EXPECT_TRUE(mlir::succeeded(pm.run(*parsed)));
+  std::string printed;
+  llvm::raw_string_ostream os(printed);
+  parsed->print(os);
+  return printed;
+}
+
 }  // namespace
 
 TEST(CompilationPipelineTest, ContainsUnswitchLoopsCompositePass) {
@@ -67,6 +93,34 @@ TEST(CompilationPipelineTest, ContainsUnswitchLoopsCompositePass) {
   EXPECT_THAT(pipeline_str, ::testing::HasSubstr("xla-simplify-arith"));
 }
 
+// A float add of a dot's result stays an add: the addend as the dot's
+// accumulator adds every product onto it, each rounded at its magnitude, where
+// the program adds it once to the products' sum (a scanned residual r + x @ w
+// rounded 1.7 times as far from float64 as the add kept apart). An integer
+// add, exact either way, still becomes the accumulator.
+TEST(CompilationPipelineTest, CombineKeepsAFloatAddOfADotApart) {
+  std::string floats = Combined(R"(
+    tt.func @residual(%x: tensor<16x16xf32>, %w: tensor<16x16xf32>,
+                      %r: tensor<16x16xf32>) -> tensor<16x16xf32> {
+      %zero = arith.constant dense<0.0> : tensor<16x16xf32>
+      %dot = tt.dot %x, %w, %zero : tensor<16x16xf32> * tensor<16x16xf32> -> tensor<16x16xf32>
+      %sum = arith.addf %r, %dot : tensor<16x16xf32>
+      tt.return %sum : tensor<16x16xf32>
+    })");
+  EXPECT_THAT(floats, HasSubstr("arith.addf"));
+  EXPECT_THAT(floats, Not(HasSubstr("tt.dot %arg0, %arg1, %arg2")));
+  std::string integers = Combined(R"(
+    tt.func @residual(%x: tensor<16x16xi8>, %w: tensor<16x16xi8>,
+                      %r: tensor<16x16xi32>) -> tensor<16x16xi32> {
+      %zero = arith.constant dense<0> : tensor<16x16xi32>
+      %dot = tt.dot %x, %w, %zero : tensor<16x16xi8> * tensor<16x16xi8> -> tensor<16x16xi32>
+      %sum = arith.addi %r, %dot : tensor<16x16xi32>
+      tt.return %sum : tensor<16x16xi32>
+    })");
+  EXPECT_THAT(integers, HasSubstr("tt.dot %arg0, %arg1, %arg2"));
+  EXPECT_THAT(integers, Not(HasSubstr("arith.addi")));
+}
+

+// `module` after Triton's combine, its float fold as asked, printed.
+std::string Combined(absl::string_view module, bool fold_float_dot_add) {
+  mlir::MLIRContext ctx;
+  ctx.loadDialect<mlir::triton::TritonDialect, mlir::arith::ArithDialect>();
+  mlir::OwningOpRef<mlir::ModuleOp> parsed =
+      mlir::parseSourceString<mlir::ModuleOp>(module, &ctx);
+  EXPECT_TRUE(parsed);
+  mlir::PassManager pm(&ctx);
+  pm.addPass(mlir::triton::createTritonCombineOps(
+      {/*foldFloatDotAdd=*/fold_float_dot_add}));
+  EXPECT_TRUE(mlir::succeeded(pm.run(*parsed)));
+  std::string printed;
+  llvm::raw_string_ostream os(printed);
+  parsed->print(os);
+  return printed;
+}
+
+// The textual pipeline `CreateTritonPipeline` builds for a fusion of XLA's own
+// or for a Triton call.
+std::string Pipeline(bool is_xla_fusion) {
+  mlir::MLIRContext ctx;
+  mlir::PassManager pm(&ctx);
+  CreateTritonPipeline(&pm, stream_executor::CudaComputeCapability(8, 0),
+                       /*num_warps=*/4, /*num_ctas=*/1, /*num_stages=*/3,
+                       is_xla_fusion);
+  std::string pipeline;
+  llvm::raw_string_ostream os(pipeline);
+  pm.printAsTextualPipeline(os);
+  return pipeline;
+}

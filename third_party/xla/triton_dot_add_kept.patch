From d02ae946acf7103c2046cc592aa2da5b412d6a47 Mon Sep 17 00:00:00 2001
From: Ashish Kumar Singh <ashishkmr472@gmail.com>
Date: Sun, 15 Nov 2026 23:57:31 -0600
Subject: [PATCH] [XLA:GPU] Triton's combine keeps a float add of a dot's
 result apart from its accumulator

Triton's CombineOps folds add(dot(a, b, 0), d) into dot(a, b, d): the addend becomes the accumulator's initial
value, every product added onto it and rounded at its magnitude, where the program adds it once to the
products' sum. XLA's nested GEMM fusion of a residual add (r + x @ w in a while body, its K loop a single trip
folded away) took the residual as its accumulator, 1.7 times the unfused program's float32 distance from
float64 on an A100 and a GH200. The float patterns (a dot's and a scaled dot's) are dropped; an integer add,
exact either way, is still combined. compilation_pipeline_test holds both.
---
 .../triton/common/dot_add_float_kept.patch    | 29 ++++++++++
 third_party/triton/common/series              |  1 +
 xla/backends/gpu/codegen/triton/BUILD         |  6 +++
 .../triton/compilation_pipeline_test.cc       | 54 +++++++++++++++++++
 4 files changed, 90 insertions(+)
 create mode 100644 third_party/triton/common/dot_add_float_kept.patch

diff --git a/third_party/triton/common/dot_add_float_kept.patch b/third_party/triton/common/dot_add_float_kept.patch
new file mode 100644
index 0000000000..ea8751b5cb
--- /dev/null
+++ b/third_party/triton/common/dot_add_float_kept.patch
@@ -0,0 +1,29 @@
+--- a/lib/Dialect/Triton/Transforms/Combine.cpp
++++ b/lib/Dialect/Triton/Transforms/Combine.cpp
+@@ -262,13 +262,12 @@
+ };
+ 
+ // AddIOp(DotOp(a, b, c), d) and c==0 => DotOp(a, b, d)
+-// AddFOp(DotOp(a, b, c), d) and c==0 => DotOp(a, b, d)
+ // AddIOp(d, DotOp(a, b, c)) and c==0 => DotOp(a, b, d)
+-// AddFOp(d, DotOp(a, b, c)) and c==0 => DotOp(a, b, d)
++// A float add is not combined: d as the accumulator's initial value adds every
++// product onto it, each rounded at d's magnitude, where the program adds d once
++// to the products' sum (XLA: a scanned residual r + x @ w rounded 1.7 times as
++// far from float64 as the add kept apart).
+ using CombineDotAddIPattern = CombineDotAddPattern<DotOp, arith::AddIOp>;
+-using CombineDotAddFPattern = CombineDotAddPattern<DotOp, arith::AddFOp>;
+-using CombineDotScaledAddFPattern =
+-    CombineDotAddPattern<DotScaledOp, arith::AddFOp>;
+ 
+ } // anonymous namespace
+ 
+@@ -280,8 +279,6 @@
+     ModuleOp m = getOperation();
+ 
+     patterns.add<CombineDotAddIPattern>(context);
+-    patterns.add<CombineDotAddFPattern>(context);
+-    patterns.add<CombineDotScaledAddFPattern>(context);
+     patterns.add<CombineSelectMaskedLoadPattern>(context);
+     patterns.add<CombineAddPtrPattern>(context);
+     patterns.add<CombineBroadcastMulReducePattern>(context);

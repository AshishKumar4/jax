+constexpr absl::string_view kFloatResidual = R"(
+    tt.func @residual(%x: tensor<16x16xf32>, %w: tensor<16x16xf32>,
+                      %r: tensor<16x16xf32>) -> tensor<16x16xf32> {
+      %zero = arith.constant dense<0.0> : tensor<16x16xf32>
+      %dot = tt.dot %x, %w, %zero
+          : tensor<16x16xf32> * tensor<16x16xf32> -> tensor<16x16xf32>
+      %sum = arith.addf %r, %dot : tensor<16x16xf32>
+      tt.return %sum : tensor<16x16xf32>
+    })";
+
+constexpr absl::string_view kIntegerResidual = R"(
+    tt.func @residual(%x: tensor<16x16xi8>, %w: tensor<16x16xi8>,
+                      %r: tensor<16x16xi32>) -> tensor<16x16xi32> {
+      %zero = arith.constant dense<0> : tensor<16x16xi32>
+      %dot = tt.dot %x, %w, %zero
+          : tensor<16x16xi8> * tensor<16x16xi8> -> tensor<16x16xi32>
+      %sum = arith.addi %r, %dot : tensor<16x16xi32>
+      tt.return %sum : tensor<16x16xi32>
+    })";
+
+// Without the float fold, a float add of a dot's result stays an add: the
+// addend as the dot's accumulator adds every product onto it, each rounded at
+// its magnitude, where the program adds it once to the products' sum (a scanned
+// residual r + x @ w rounded 1.7 times as far from float64 as the add kept
+// apart). With it, Triton's own rule, the addend is the accumulator. An integer
+// add, exact either way, is the accumulator in both.
+TEST(CompilationPipelineTest, CombineFoldsAFloatAddOfADotOnlyWhereAsked) {
+  std::string kept = Combined(kFloatResidual, /*fold_float_dot_add=*/false);
+  EXPECT_THAT(kept, HasSubstr("arith.addf"));
+  EXPECT_THAT(kept, Not(HasSubstr("tt.dot %arg0, %arg1, %arg2")));
+  std::string folded = Combined(kFloatResidual, /*fold_float_dot_add=*/true);
+  EXPECT_THAT(folded, HasSubstr("tt.dot %arg0, %arg1, %arg2"));
+  EXPECT_THAT(folded, Not(HasSubstr("arith.addf")));
+  for (bool fold : {false, true}) {
+    std::string integers = Combined(kIntegerResidual, fold);
+    EXPECT_THAT(integers, HasSubstr("tt.dot %arg0, %arg1, %arg2"));
+    EXPECT_THAT(integers, Not(HasSubstr("arith.addi")));
+  }
+}
+
+// XLA's own fusions keep a float add of a dot apart, as the HLO adds it; a
+// Triton call (a kernel written in Triton or Pallas, an online softmax's
+// acc * alpha + dot(p, v) among them) folds it, as Triton's compiler does.
+TEST(CompilationPipelineTest, OnlyAnXlaFusionKeepsAFloatAddOfADotApart) {
+  EXPECT_THAT(Pipeline(/*is_xla_fusion=*/true),
+              HasSubstr("triton-combine{fold-float-dot-add=false}"));
+  EXPECT_THAT(Pipeline(/*is_xla_fusion=*/false),
+              HasSubstr("triton-combine{fold-float-dot-add=true}"));
+}

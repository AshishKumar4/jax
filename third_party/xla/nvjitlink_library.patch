+namespace {
+// The nvJitLink library this stub loaded (its handle, never closed), as the
+// loader maps it: the object's Dl_info, or false where the stub has loaded none
+// (every PTX compile so far ptxas's) or the loader names no object for it.
+bool LoadedObject(Dl_info& info) {
+  void* handle = loaded_handle.load(std::memory_order_acquire);
+  if (handle == nullptr) {
+    return false;
+  }
+  void* symbol = dlsym(handle, "nvJitLinkVersion");
+  return symbol != nullptr && dladdr(symbol, &info) != 0 &&
+         info.dli_fbase != nullptr;
+}
+
+// The GNU build id (NT_GNU_BUILD_ID) of the object mapped at `base`, in hex,
+// read from the mapping itself: empty where it states none.
+std::string MappedBuildId(const void* base) {
+  struct Found {
+    const void* base;
+    std::string id;
+  } found{base, ""};
+  dl_iterate_phdr(
+      [](dl_phdr_info* object, size_t, void* data) -> int {
+        auto* found = static_cast<Found*>(data);
+        // The object whose first loaded segment `base` (dladdr's dli_fbase)
+        // falls in: dli_fbase is its mapping's start, dlpi_addr its bias.
+        const auto base = reinterpret_cast<ElfW(Addr)>(found->base);
+        bool holds = false;
+        for (int i = 0; i < object->dlpi_phnum; ++i) {
+          const auto& segment = object->dlpi_phdr[i];
+          const ElfW(Addr) start = object->dlpi_addr + segment.p_vaddr;
+          const ElfW(Addr) page =
+              static_cast<ElfW(Addr)>(sysconf(_SC_PAGESIZE));
+          if (segment.p_type == PT_LOAD && (start & ~(page - 1)) <= base &&
+              base < start + segment.p_memsz) {
+            holds = true;
+          }
+        }
+        if (!holds) return 0;
+        for (int i = 0; i < object->dlpi_phnum; ++i) {
+          const auto& segment = object->dlpi_phdr[i];
+          if (segment.p_type != PT_NOTE) continue;
+          const char* at = reinterpret_cast<const char*>(object->dlpi_addr +
+                                                         segment.p_vaddr);
+          const char* end = at + segment.p_memsz;
+          // Notes align to their segment's alignment, 4 or 8 (a property note).
+          const size_t align = segment.p_align == 8 ? 8 : 4;
+          auto aligned = [align](size_t size) {
+            return (size + align - 1) & ~(align - 1);
+          };
+          while (static_cast<size_t>(end - at) >= sizeof(ElfW(Nhdr))) {
+            const auto* note = reinterpret_cast<const ElfW(Nhdr)*>(at);
+            const char* name = at + sizeof(ElfW(Nhdr));
+            if (aligned(note->n_namesz) > static_cast<size_t>(end - name)) {
+              break;
+            }
+            const char* desc = name + aligned(note->n_namesz);
+            if (aligned(note->n_descsz) > static_cast<size_t>(end - desc)) {
+              break;
+            }
+            const char* next = desc + aligned(note->n_descsz);
+            if (note->n_type == NT_GNU_BUILD_ID && note->n_namesz == 4 &&
+                std::memcmp(name, "GNU", 4) == 0 && note->n_descsz > 0) {
+              static constexpr char kHex[] = "0123456789abcdef";
+              for (unsigned j = 0; j < note->n_descsz; ++j) {
+                const auto byte = static_cast<unsigned char>(desc[j]);
+                found->id.push_back(kHex[byte >> 4]);
+                found->id.push_back(kHex[byte & 15]);
+              }
+              return 1;
+            }
+            at = next;
+          }
+        }
+        return 1;
+      },
+      &found);
+  return found.id;
+}
+}  // namespace
+
+// The absolute path the nvJitLink library this stub loaded was mapped from, or
+// null where it has loaded none or the loader names no absolute file. A name
+// for a reader, no identity: the file may have been replaced since it mapped.
+// Loads nothing and takes no reference.
+extern "C" __attribute__((visibility("default"))) const char*
+XlaNvJitLinkLibrary() {
+  Dl_info info;
+  if (!LoadedObject(info) || info.dli_fname == nullptr ||
+      info.dli_fname[0] != '/') {
+    return nullptr;
+  }
+  return info.dli_fname;
+}
+
+// The GNU build id, in hex, of the nvJitLink library this stub loaded, read
+// from its mapping, so it is the linker's code XLA runs whatever became of its
+// file since; null where the stub has loaded none or the object states no
+// build id. What a caller keys what nvJitLink linked by (Dew row 12166). Loads
+// nothing and takes no reference. Kept for the process: the stub's handle is
+// never closed, so its build id never changes once read.
+extern "C" __attribute__((visibility("default"))) const char*
+XlaNvJitLinkBuildId() {
+  static absl::Mutex mu(absl::kConstInit);
+  static std::string* id = nullptr;
+  absl::MutexLock lock(mu);
+  if (id == nullptr) {
+    Dl_info info;
+    if (!LoadedObject(info)) {
+      return nullptr;
+    }
+    std::string found = MappedBuildId(info.dli_fbase);
+    if (found.empty()) {
+      return nullptr;
+    }
+    id = new std::string(std::move(found));
+  }
+  return id->c_str();
+}

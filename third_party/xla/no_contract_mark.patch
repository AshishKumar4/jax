+// `results`, the value of `instr` (an add, subtract or multiply), its operation
+// marked `kNoContractOpAttr` where `instr` is labeled to round on its own
+// (`kXlaNoContractAttr`): a backend that contracts fences it there.
+SmallVector<Value, 1> Uncontracted(const HloInstruction& instr,
+                                   SmallVector<Value, 1> results) {
+  if (instr.get_frontend_attribute(kXlaNoContractAttr) != "true") {
+    return results;
+  }
+  for (Value result : results) {
+    if (mlir::Operation* op = result.getDefiningOp();
+        op != nullptr && mlir::isa<mlir::FloatType>(
+                             mlir::getElementTypeOrSelf(result.getType()))) {
+      op->setAttr(kNoContractOpAttr, mlir::UnitAttr::get(op->getContext()));
+    }
+  }
+  return results;
+}

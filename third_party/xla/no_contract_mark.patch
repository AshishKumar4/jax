+// An add, subtract or multiply labeled to round on its own
+// (`kXlaNoContractAttr`), of 32 or 64-bit floats, fenced by
+// `llvm.arithmetic.fence`: a multiply's result and an add's or subtract's
+// operands, so no fused multiply-add forms across it when the kernel's
+// arithmetic is made contractible after optimization
+// (`llvm_ir::SetAllowContractOnFpArithmetic`).
+absl::StatusOr<llvm::Value*> CpuElementalIrEmitter::EmitFloatBinaryOp(
+    const HloInstruction* op, llvm::Value* lhs_value, llvm::Value* rhs_value) {
+  const HloOpcode opcode = op->opcode();
+  const PrimitiveType type = op->shape().element_type();
+  if ((opcode != HloOpcode::kAdd && opcode != HloOpcode::kSubtract &&
+       opcode != HloOpcode::kMultiply) ||
+      (type != F32 && type != F64) ||
+      op->get_frontend_attribute(kXlaNoContractAttr) != "true") {
+    return ElementalIrEmitter::EmitFloatBinaryOp(op, lhs_value, rhs_value);
+  }
+  llvm::IRBuilderBase* builder = b();
+  auto fence = [&](llvm::Value* value) {
+    return builder->CreateArithmeticFence(value, value->getType());
+  };
+  if (opcode == HloOpcode::kMultiply) {
+    ABSL_ASSIGN_OR_RETURN(
+        llvm::Value * product,
+        ElementalIrEmitter::EmitFloatBinaryOp(op, lhs_value, rhs_value));
+    return fence(product);
+  }
+  return ElementalIrEmitter::EmitFloatBinaryOp(op, fence(lhs_value),
+                                               fence(rhs_value));
+}

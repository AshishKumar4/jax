+// A fusion whose multiply is labeled to round on its own (xla_no_contract) is
+// not its unlabeled twin: merged, the label would leave the one or reach the
+// other.
+TEST_F(HloCseTest, FusionsLabeledApartToRoundOnTheirOwnAreNotCombined) {
+  const char* const hlo_string = R"(
+    HloModule m
+
+    %labeled (p0: f32[8], p1: f32[8], p2: f32[8]) -> f32[8] {
+      %p0 = f32[8] parameter(0)
+      %p1 = f32[8] parameter(1)
+      %p2 = f32[8] parameter(2)
+      %mul = f32[8] multiply(%p1, %p2), frontend_attributes={xla_no_contract="true"}
+      ROOT %add = f32[8] add(%mul, %p0)
+    }
+
+    %unlabeled (q0: f32[8], q1: f32[8], q2: f32[8]) -> f32[8] {
+      %q0 = f32[8] parameter(0)
+      %q1 = f32[8] parameter(1)
+      %q2 = f32[8] parameter(2)
+      %mul.1 = f32[8] multiply(%q1, %q2)
+      ROOT %add.1 = f32[8] add(%mul.1, %q0)
+    }
+
+    ENTRY entry {
+      %x = f32[8] parameter(0)
+      %y = f32[8] parameter(1)
+      %z = f32[8] parameter(2)
+      %kept = f32[8] fusion(%z, %x, %y), kind=kLoop, calls=%labeled
+      %fused = f32[8] fusion(%z, %x, %y), kind=kLoop, calls=%unlabeled
+      ROOT %root = (f32[8], f32[8]) tuple(%kept, %fused)
+    })";
+  ASSERT_OK_AND_ASSIGN(auto m, ParseAndReturnVerifiedModule(hlo_string));
+  HloCSE cse(/*is_layout_sensitive=*/false);
+  ASSERT_OK_AND_ASSIGN(bool changed, RunHloPass(&cse, m.get()));
+  EXPECT_FALSE(changed);
+  HloInstruction* root = m->entry_computation()->root_instruction();
+  EXPECT_NE(root->operand(0), root->operand(1));
+}
+
+// A multiply labeled to round on its own (xla_no_contract) is not its unlabeled
+// twin, nor is the add of each; two labeled alike are one.
+TEST_F(HloCseTest, OperationsLabeledApartToRoundOnTheirOwnAreNotCombined) {
+  const char* const hlo_string = R"(
+    HloModule m
+
+    ENTRY entry {
+      %x = f32[8] parameter(0)
+      %y = f32[8] parameter(1)
+      %labeled = f32[8] multiply(%x, %y), frontend_attributes={xla_no_contract="true"}
+      %twin = f32[8] multiply(%x, %y), frontend_attributes={xla_no_contract="true"}
+      %unlabeled = f32[8] multiply(%x, %y)
+      ROOT %root = (f32[8], f32[8], f32[8]) tuple(%labeled, %twin, %unlabeled)
+    })";
+  ASSERT_OK_AND_ASSIGN(auto m, ParseAndReturnVerifiedModule(hlo_string));
+  HloCSE cse(/*is_layout_sensitive=*/false);
+  ASSERT_OK_AND_ASSIGN(bool changed, RunHloPass(&cse, m.get()));
+  EXPECT_TRUE(changed);
+  HloInstruction* root = m->entry_computation()->root_instruction();
+  EXPECT_EQ(root->operand(0), root->operand(1));
+  EXPECT_NE(root->operand(0), root->operand(2));
+}

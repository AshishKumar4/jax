+// Each float add, subtract or multiply its emitter marked to round on its own
+// (`emitters::kNoContractOpAttr`, carried through the kernel's lowering to the
+// LLVM dialect) fenced by `llvm.arithmetic.fence`, a multiply's operands and
+// result and an add's or subtract's operands, so no fused multiply-add forms
+// across it when the kernel's arithmetic is made contractible after
+// optimization (`llvm_ir::SetAllowContractOnFpArithmetic`). A float of 32 or 64
+// bits alone: narrower ones compute through conversions.
+void FenceUncontracted(mlir::ModuleOp module) {
+  auto fenced = [](mlir::Type type) {
+    auto element = mlir::dyn_cast<mlir::FloatType>(
+        mlir::getElementTypeOrSelf(type));
+    return element != nullptr && (element.isF32() || element.isF64());
+  };
+  module.walk([&](mlir::Operation* op) {
+    if (!op->hasAttr(emitters::kNoContractOpAttr)) {
+      return;
+    }
+    op->removeAttr(emitters::kNoContractOpAttr);
+    if (!fenced(op->getResult(0).getType())) {
+      return;
+    }
+    mlir::OpBuilder builder(op);
+    auto fence = [&](mlir::Value value) -> mlir::Value {
+      return mlir::LLVM::ArithmeticFenceOp::create(builder, op->getLoc(),
+                                                  value.getType(), value);
+    };
+    if (mlir::isa<mlir::LLVM::FMulOp>(op)) {
+      // Its operands fenced too, so it is no other multiply of the same
+      // operands: a value numbering would join an unlabeled twin to it, whose
+      // own sum, its product then read twice, would contract no more.
+      for (mlir::OpOperand& operand : op->getOpOperands()) {
+        operand.set(fence(operand.get()));
+      }
+      builder.setInsertionPointAfter(op);
+      mlir::Value product = op->getResult(0);
+      mlir::Value kept = fence(product);
+      product.replaceAllUsesExcept(kept, kept.getDefiningOp());
+    } else if (mlir::isa<mlir::LLVM::FAddOp, mlir::LLVM::FSubOp>(op)) {
+      for (mlir::OpOperand& operand : op->getOpOperands()) {
+        operand.set(fence(operand.get()));
+      }
+    }
+  });
+}

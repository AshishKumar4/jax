++  tt.func public @shmem_pipelining_mmav3_register_user(%lb : index, %ub : index, %step : index,
++                                              %X_ptr: tensor<64x64x!tt.ptr<bf16>, #blocked> {tt.divisibility = dense<[16, 16]> : tensor<2xi32>, tt.contiguity = dense<[1, 16]> : tensor<2xi32>},
++                                              %lhs: tensor<64x64xbf16, #ttg.dot_op<{opIdx = 0, parent = #mma, kWidth = 2}>>) -> tensor<64x64xf32, #mma> {
++    %cst = arith.constant dense<0.000000e+00> : tensor<64x64xf32, #mma>
++    %res = scf.for %i = %lb to %ub step %step iter_args(%acc = %cst) -> (tensor<64x64xf32, #mma>) : index {
++      %X = tt.load %X_ptr {loop.cluster = 1 : i32, loop.stage = 0 : i32} : tensor<64x64x!tt.ptr<bf16>, #blocked>
++      "use"(%X) {loop.cluster = 0 : i32, loop.stage = 1 : i32} : (tensor<64x64xbf16, #blocked>) -> ()
++      %X_sh = ttg.local_alloc %X {loop.cluster = 0 : i32, loop.stage = 1 : i32} : (tensor<64x64xbf16, #blocked>) -> !ttg.memdesc<64x64xbf16, #shared, #smem>
++      %X_trans = ttg.memdesc_trans %X_sh {loop.cluster = 0 : i32, loop.stage = 1 : i32, order = array<i32: 1, 0>} : !ttg.memdesc<64x64xbf16, #shared, #smem> -> !ttg.memdesc<64x64xbf16, #shared1, #smem>
++      %acc_res = ttng.warp_group_dot %lhs, %X_trans, %acc {inputPrecision = 0 : i32, loop.cluster = 0 : i32, loop.stage = 1 : i32} : tensor<64x64xbf16, #ttg.dot_op<{opIdx = 0, parent = #mma, kWidth = 2}>> * !ttg.memdesc<64x64xbf16, #shared1, #smem> -> tensor<64x64xf32, #mma>
++      scf.yield %acc_res : tensor<64x64xf32, #mma>
++    } {tt.scheduled_max_stage = 1 : i32}
++    tt.return %res : tensor<64x64xf32, #mma>
++  }
++}

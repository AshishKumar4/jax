+++ b/third_party/triton/common/series
@@ -36,3 +36,4 @@ llvm_cl1010430002.patch
 llvm_cl1010504175.patch
 llvm_cl1012394472.patch
 llvm_cl1007529002.patch
+pipeliner_multiuse_load.patch

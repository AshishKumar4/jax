diff --git a/third_party/triton/common/pipeliner_multiuse_load.patch b/third_party/triton/common/pipeliner_multiuse_load.patch
new file mode 100644
index 0000000000..8027cffc81
--- /dev/null
+++ b/third_party/triton/common/pipeliner_multiuse_load.patch
@@ -0,0 +1,31 @@
+diff --git a/lib/Dialect/TritonGPU/Transforms/Pipeliner/LowerLoops.cpp b/lib/Dialect/TritonGPU/Transforms/Pipeliner/LowerLoops.cpp
+--- a/lib/Dialect/TritonGPU/Transforms/Pipeliner/LowerLoops.cpp
++++ b/lib/Dialect/TritonGPU/Transforms/Pipeliner/LowerLoops.cpp
+@@ -419,18 +419,19 @@ bool loadRequiresAdditionalBuffer(Operation *loadOp) {
+             out.push_back(user);
+         }
+       };
+-  // Pattern match the op sequence used for loading mmav3 operands
+-  if (!mustLoadToRegisters(loadOp)) {
+-    assert(loadOp->hasOneUse());
+-    ttg::LocalAllocOp alloc =
+-        dyn_cast<ttg::LocalAllocOp>(*loadOp->getUsers().begin());
++  // replaceUsesWithLocalLoad aliases compatible local_alloc users to the
++  // async-copy buffer even when other users also require a register load.
++  // Such a buffer remains live until its asynchronous MMA consumers finish.
++  for (Operation *user : loadOp->getUsers()) {
++    auto alloc = dyn_cast<ttg::LocalAllocOp>(user);
+     if (alloc) {
+       SmallVector<Operation *> nonViewUsers;
+       collectNonViewUsers(alloc, nonViewUsers);
+-      return llvm::any_of(nonViewUsers, [&](Operation *op) {
+-        return isa<ttng::WarpGroupDotOp>(op);
+-      });
++      if (llvm::any_of(nonViewUsers, [&](Operation *op) {
++            return isa<ttng::WarpGroupDotOp>(op);
++          }))
++        return true;
+     }
+   }
+   return false;
+ }

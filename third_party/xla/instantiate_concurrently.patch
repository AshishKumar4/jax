+  EXPECT_THAT(Compiled(R"(
+    HloModule m
+    ENTRY main {
+      p0 = f32[8] parameter(0)
+      ROOT a = f32[8] custom-call(p0), custom_call_target="xla.gpu.instantiate_together",
+        api_version=API_VERSION_TYPED_FFI, backend_config="{fail = true}"
+    })").status(),
+              absl_testing::StatusIs(absl::StatusCode::kInvalidArgument,
+                                     HasSubstr("instantiation refused")));
+}

+// Calls arrived at the instantiate stage of `xla.gpu.instantiate_together`.
+static std::atomic<int> instantiate_together_arrived = 0;
+
+// An instantiate stage that holds until two calls have arrived at it, so calls
+// instantiated one at a time fail; a call whose `fail` is set fails at once.
+XLA_FFI_DEFINE_HANDLER(
+    kInstantiateTogether,
+    [](bool fail) -> absl::Status {
+      if (fail) {
+        return absl::InvalidArgumentError("instantiation refused");
+      }
+      instantiate_together_arrived.fetch_add(1);
+      absl::Time deadline = absl::Now() + absl::Seconds(60);
+      while (instantiate_together_arrived.load() < 2) {
+        if (absl::Now() > deadline) {
+          return absl::DeadlineExceededError("instantiated alone");
+        }
+        absl::SleepFor(absl::Milliseconds(1));
+      }
+      return absl::OkStatus();
+    },
+    ffi::Ffi::BindInstantiate().Attr<bool>("fail"));
+XLA_FFI_DEFINE_HANDLER(kInstantiateTogetherExecute,
+                       []() { return absl::OkStatus(); }, ffi::Ffi::Bind());
+
+static std::atomic<int> own_options_arrived = 0;
+static absl::Notification* own_options_gate = nullptr;
+
+// An instantiation that compiles with LLVM options of its own, as Mosaic GPU's
+// does: it takes the LLVM options lock with them once the test lets it.
+XLA_FFI_DEFINE_HANDLER(
+    kInstantiateWithOwnLlvmOptions,
+    []() -> absl::Status {
+      own_options_arrived.fetch_add(1);
+      own_options_gate->WaitForNotification();
+      llvm_ir::LLVMCommandLineOptionsLock lock({"-bonus-inst-threshold=3"});
+      return absl::OkStatus();
+    },
+    ffi::Ffi::BindInstantiate());
+
+class InstantiateConcurrentlyTest : public HloPjRtGpuTestBase {
+ protected:
+  void SetUp() override {
+    HloPjRtGpuTestBase::SetUp();
+    XLA_FFI_Handler_Bundle bundle = {
+        /*instantiate=*/kInstantiateTogether,
+        /*prepare=*/nullptr,
+        /*initialize=*/nullptr,
+        /*execute=*/kInstantiateTogetherExecute,
+    };
+    XLA_FFI_Handler_Bundle own_options = {
+        /*instantiate=*/kInstantiateWithOwnLlvmOptions,
+        /*prepare=*/nullptr,
+        /*initialize=*/nullptr,
+        /*execute=*/kInstantiateTogetherExecute,
+    };
+    for (absl::string_view platform : {"CUDA", "ROCM"}) {
+      xla::ffi::Ffi::RegisterStaticHandler(
+          ffi::GetXlaFfiApi(), "xla.gpu.instantiate_together", platform,
+          bundle, XLA_FFI_HANDLER_TRAITS_INSTANTIATE_CONCURRENTLY);
+      xla::ffi::Ffi::RegisterStaticHandler(
+          ffi::GetXlaFfiApi(), "xla.gpu.instantiate_with_own_llvm_options",
+          platform, own_options,
+          XLA_FFI_HANDLER_TRAITS_INSTANTIATE_CONCURRENTLY);
+    }
+    instantiate_together_arrived = 0;
+    own_options_arrived = 0;
+  }
+
+  // `hlo_text` compiled on two compile threads of its own, or on the shared
+  // `compile_threads` where given, as a client's compiles share its pool.
+  absl::StatusOr<std::unique_ptr<Executable>> Compiled(
+      absl::string_view hlo_text,
+      tsl::thread::ThreadPool* compile_threads = nullptr) {
+    HloModuleConfig config = GetModuleConfigForTest();
+    if (compile_threads == nullptr) {
+      config.mutable_debug_options().set_xla_gpu_force_compilation_parallelism(
+          2);
+    }
+    TF_ASSIGN_OR_RETURN(std::unique_ptr<HloModule> module,
+                        ParseAndReturnVerifiedModule(hlo_text, config));
+    Compiler::CompileOptions compile_options;
+    compile_options.gpu_topology = GetSingleDeviceGpuTopology(
+        /*platform_version=*/"", gpu_target_config());
+    compile_options.thread_pool = compile_threads;
+    return compiler()->RunBackend(std::move(module), /*executor=*/nullptr,
+                                  compile_options);
+  }
+};

+void CubinCustomKernelCompiler::RunConcurrently(
+    int64_t count, absl::FunctionRef<void(int64_t)> task) {
+  if (thread_pool_ == nullptr || count < 2) {
+    KernelCompiler::RunConcurrently(count, task);
+    return;
+  }
+  // The calling thread claims tasks beside the pool's, so the tasks finish
+  // however busy the pool is (it may be the calling thread's own); a helper
+  // the pool starts after every task is claimed runs none.
+  struct Shared {
+    explicit Shared(int64_t count) : count(count) {}
+    bool Done() const ABSL_SHARED_LOCKS_REQUIRED(mu) { return done == count; }
+
+    const int64_t count;
+    std::atomic<int64_t> next{0};
+    absl::Mutex mu;
+    int64_t done ABSL_GUARDED_BY(mu) = 0;
+  };
+  auto shared = std::make_shared<Shared>(count);
+  auto claim = [shared, task]() {
+    for (int64_t i = shared->next.fetch_add(1); i < shared->count;
+         i = shared->next.fetch_add(1)) {
+      task(i);
+      absl::MutexLock lock(shared->mu);
+      ++shared->done;
+    }
+  };
+  const int64_t helpers =
+      std::min<int64_t>(count - 1, thread_pool_->NumThreads());
+  for (int64_t helper = 0; helper < helpers; ++helper) {
+    thread_pool_->Schedule(claim);
+  }
+  claim();
+  absl::MutexLock lock(shared->mu);
+  shared->mu.Await(absl::Condition(shared.get(), &Shared::Done));
+}

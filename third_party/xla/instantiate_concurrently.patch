+TEST_F(InstantiateConcurrentlyTest,
+       HandlersInstantiatingConcurrentlyAreInstantiatedTogether) {
+  TF_ASSERT_OK(Compiled(R"(
+    HloModule m
+    ENTRY main {
+      p0 = f32[8] parameter(0)
+      p1 = f32[8] parameter(1)
+      a = f32[8] custom-call(p0), custom_call_target="xla.gpu.instantiate_together",
+        api_version=API_VERSION_TYPED_FFI, backend_config="{fail = false}"
+      b = f32[8] custom-call(p1), custom_call_target="xla.gpu.instantiate_together",
+        api_version=API_VERSION_TYPED_FFI, backend_config="{fail = false}"
+      ROOT t = (f32[8], f32[8]) tuple(a, b)
+    })").status());
+  EXPECT_EQ(instantiate_together_arrived.load(), 2);
+}
+
+TEST_F(InstantiateConcurrentlyTest,
+       AConcurrentInstantiationsErrorIsTheCompiles) {
+  EXPECT_THAT(Compiled(R"(
+    HloModule m
+    ENTRY main {
+      p0 = f32[8] parameter(0)
+      ROOT a = f32[8] custom-call(p0), custom_call_target="xla.gpu.instantiate_together",
+        api_version=API_VERSION_TYPED_FFI, backend_config="{fail = true}"
+    })").status(),
+              absl_testing::StatusIs(absl::StatusCode::kInvalidArgument,
+                                     HasSubstr("instantiation refused")));
+}
+
+// Another compile of the process holds the LLVM options lock with options of its
+// own while it waits for a kernel on the compile threads it shares with this
+// one (a client's pool). This compile's instantiations, waiting for the lock
+// with theirs, leave those threads free, so that kernel compiles, the lock is
+// released and they instantiate; on the compile threads they held both, and
+// every compile of the process waited on another (row 8602: an A100 decode
+// step's programs compiled together, hung).
+TEST_F(InstantiateConcurrentlyTest,
+       InstantiationsWaitingOnTheLlvmOptionsLockLeaveTheCompileThreadsFree) {
+  tsl::thread::ThreadPool compile_threads(tsl::Env::Default(), "compile", 2);
+  absl::Notification gate;
+  own_options_gate = &gate;
+  std::optional<absl::StatusOr<std::unique_ptr<Executable>>> compiled;
+  std::unique_ptr<tsl::Thread> compiling(tsl::Env::Default()->StartThread(
+      tsl::ThreadOptions(), "compiling", [&] {
+        compiled = Compiled(R"(
+          HloModule m
+          ENTRY main {
+            p0 = f32[8] parameter(0)
+            a = f32[8] custom-call(p0),
+              custom_call_target="xla.gpu.instantiate_with_own_llvm_options",
+              api_version=API_VERSION_TYPED_FFI
+            b = f32[8] custom-call(p0),
+              custom_call_target="xla.gpu.instantiate_with_own_llvm_options",
+              api_version=API_VERSION_TYPED_FFI
+            c = f32[8] custom-call(p0),
+              custom_call_target="xla.gpu.instantiate_with_own_llvm_options",
+              api_version=API_VERSION_TYPED_FFI
+            ROOT t = (f32[8], f32[8], f32[8]) tuple(a, b, c)
+          })",
+                            &compile_threads);
+      }));
+  absl::Time deadline = absl::Now() + absl::Seconds(60);
+  while (own_options_arrived.load() < 3 && absl::Now() < deadline) {
+    absl::SleepFor(absl::Milliseconds(1));
+  }
+  ASSERT_EQ(own_options_arrived.load(), 3);
+  absl::Notification kernel_compiled;
+  {
+    // The other compile: the lock held with its options while its kernel
+    // compiles on the shared compile threads.
+    llvm_ir::LLVMCommandLineOptionsLock other_compile(
+        {"-bonus-inst-threshold=2"});
+    gate.Notify();
+    compile_threads.Schedule([&] { kernel_compiled.Notify(); });
+    EXPECT_TRUE(
+        kernel_compiled.WaitForNotificationWithTimeout(absl::Seconds(30)));
+  }
+  kernel_compiled.WaitForNotification();
+  compiling.reset();
+  ASSERT_TRUE(compiled.has_value());
+  TF_EXPECT_OK(compiled->status());
+}

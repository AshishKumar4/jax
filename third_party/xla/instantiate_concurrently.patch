+absl::Status ThunkEmitter::InstantiateConcurrently(const HloModule& module) {
+  struct Call {
+    const HloCustomCallInstruction* instr;
+    XLA_FFI_Handler_Bundle bundle;
+    std::vector<NullableShapedSlice> operands;
+    std::vector<NullableShapedSlice> results;
+    ffi::AttributesMap attributes;
+    absl::StatusOr<std::unique_ptr<ffi::ExecutionState>> state;
+  };
+  // A call the AOT allowlist refuses is refused as its thunk is emitted.
+  const auto& allowlist =
+      ir_emitter_context_->debug_options().xla_gpu_hlo_custom_call_allowlist();
+  std::vector<Call> calls;
+  for (const HloComputation* computation :
+       module.MakeNonfusionComputations()) {
+    for (const HloInstruction* instruction : computation->instructions()) {
+      auto* instr = DynCast<HloCustomCallInstruction>(instruction);
+      if (instr == nullptr ||
+          instr->api_version() != CustomCallApiVersion::API_VERSION_TYPED_FFI) {
+        continue;
+      }
+      absl::StatusOr<ffi::HandlerRegistration> registration =
+          ffi::FindHandler(instr->custom_call_target(), platform_name());
+      if (!registration.ok() || registration->bundle.instantiate == nullptr ||
+          !(registration->metadata.traits &
+            XLA_FFI_HANDLER_TRAITS_INSTANTIATE_CONCURRENTLY) ||
+          (!allowlist.empty() &&
+           !IsInternalAotAllowlistedCustomCall(instr->custom_call_target()) &&
+           !absl::c_linear_search(allowlist, instr->custom_call_target()))) {
+        continue;
+      }
+      ABSL_ASSIGN_OR_RETURN(auto slices, CustomCallSlices(instr));
+      ABSL_ASSIGN_OR_RETURN(ffi::AttributesMap attributes,
+                            FfiAttributes(instr));
+      calls.push_back(Call{instr, registration->bundle,
+                           std::move(slices.first), std::move(slices.second),
+                           std::move(attributes),
+                           absl::UnknownError("not instantiated")});
+    }
+  }
+  if (calls.empty()) {
+    return absl::OkStatus();
+  }
+  {
+    // Foreign code instantiating may call into LLVM with its own options.
+    auto released_lock_keeper = llvm_options_lock_->TemporarilyReleaseLock();
+    ir_emitter_context_->kernel_compiler()->RunConcurrently(
+        static_cast<int64_t>(calls.size()), [&](int64_t i) {
+          Call& call = calls[i];
+          call.state = CustomCallThunk::Instantiated(
+              call.bundle, call.operands, call.results, call.attributes,
+              ir_emitter_context_->gpu_compute_capability(),
+              ir_emitter_context_->cpu_target_machine_options());
+        });
+  }
+  for (Call& call : calls) {
+    ABSL_ASSIGN_OR_RETURN(instantiated_[call.instr], std::move(call.state));
+  }
+  return absl::OkStatus();
+}
 

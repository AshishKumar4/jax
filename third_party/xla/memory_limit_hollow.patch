--- a/xla/service/gpu/gpu_compiler_memory_limit_test.cc
+++ b/xla/service/gpu/gpu_compiler_memory_limit_test.cc
@@ -121,6 +121,33 @@ TEST_F(GpuCompilerMemoryLimitTest,
               HasSubstr("stopped after buffer assignment"));
 }
 
+TEST_F(GpuCompilerMemoryLimitTest,
+       ACompileWhoseArgumentsAndOutputsPassItsLimitStopsBeforeItsOptimization) {
+  TF_ASSERT_OK_AND_ASSIGN(std::unique_ptr<CompiledModule> unlimited,
+                          CompiledAhead(0));
+  TF_ASSERT_OK_AND_ASSIGN(CompiledMemoryStats whole,
+                          unlimited->GetCompiledMemoryStats());
+  // Its two arguments and its output alone pass this limit, whatever its
+  // temporaries: its entry is hollowed after layout assignment, so it states
+  // its arguments and a new output, no temporary, and refuses to run.
+  const int64_t limit =
+      whole.argument_size_in_bytes + whole.output_size_in_bytes - 1;
+  ASSERT_GT(whole.temp_size_in_bytes, 0);
+  TF_ASSERT_OK_AND_ASSIGN(std::unique_ptr<CompiledModule> limited,
+                          CompiledAhead(limit));
+  TF_ASSERT_OK_AND_ASSIGN(CompiledMemoryStats stopped,
+                          limited->GetCompiledMemoryStats());
+  EXPECT_EQ(stopped.argument_size_in_bytes, whole.argument_size_in_bytes);
+  EXPECT_EQ(stopped.output_size_in_bytes, whole.output_size_in_bytes);
+  EXPECT_EQ(stopped.temp_size_in_bytes, 0);
+  EXPECT_GT(DeviceBytes(stopped), limit);
+  TF_ASSERT_OK_AND_ASSIGN(std::unique_ptr<HloModule> module, Limited(limit));
+  Literal x = LiteralUtil::CreateFullWithDescendingLayout<float>({256, 256},
+                                                                 0.5f);
+  absl::StatusOr<Literal> ran = Execute(std::move(module), {&x, &x});
+  EXPECT_EQ(ran.status().code(), absl::StatusCode::kFailedPrecondition);
+}

+// Each array of `shape` (its leaves), as layout assignment left it, in bytes.
+int64_t ArrayBytes(const Shape& shape,
+                   const std::function<bool(const ShapeIndex&)>& counted) {
+  int64_t bytes = 0;
+  ShapeUtil::ForEachSubshape(
+      shape, [&](const Shape& subshape, const ShapeIndex& index) {
+        if (subshape.IsArray() && counted(index)) {
+          bytes += ShapeUtil::ByteSizeOf(subshape);
+        }
+      });
+  return bytes;
+}
+
+// An all-zero value of `shape`, its layout `shape`'s, built in `computation`;
+// nullptr where a leaf is no array (a token).
+HloInstruction* ZerosOf(HloComputation* computation, const Shape& shape) {
+  if (shape.IsTuple()) {
+    std::vector<HloInstruction*> elements;
+    for (const Shape& element : shape.tuple_shapes()) {
+      HloInstruction* zeros = ZerosOf(computation, element);
+      if (zeros == nullptr) {
+        return nullptr;
+      }
+      elements.push_back(zeros);
+    }
+    return computation->AddInstruction(HloInstruction::CreateTuple(elements));
+  }
+  if (!shape.IsArray()) {
+    return nullptr;
+  }
+  HloInstruction* zero = computation->AddInstruction(
+      HloInstruction::CreateConstant(LiteralUtil::Zero(shape.element_type())));
+  return computation->AddInstruction(
+      HloInstruction::CreateBroadcast(shape, zero, {}));
+}
+
+// A module whose entry's arguments and new outputs (none an argument's alias)
+// alone pass its compile's memory limit
+// (DebugOptions::xla_gpu_memory_limit_early_exit_bytes) holds more than the
+// limit whatever its temporaries: its entry is hollowed to its parameters and
+// zero outputs of its outputs' shapes and layouts, so the rest of the pipeline,
+// autotuning and scheduling among it, runs over nothing, and buffer assignment
+// states the arguments and outputs alone, past the limit, which stops the
+// compile (CompileModuleToLlvmIr). Its memory is so a lower bound of the
+// module's, and its live set no temporary. Whether it was hollowed.
+absl::StatusOr<bool> HollowEntryOverMemoryLimit(HloModule* module) {
+  const int64_t limit =
+      module->config().debug_options().xla_gpu_memory_limit_early_exit_bytes();
+  if (limit <= 0) {
+    return false;
+  }
+  HloComputation* entry = module->entry_computation();
+  int64_t bytes = 0;
+  for (const HloInstruction* parameter : entry->parameter_instructions()) {
+    bytes += ArrayBytes(parameter->shape(), [](const ShapeIndex&) {
+      return true;
+    });
+  }
+  const HloInputOutputAliasConfig& aliases =
+      module->input_output_alias_config();
+  HloInstruction* root = entry->root_instruction();
+  bytes += ArrayBytes(root->shape(), [&](const ShapeIndex& index) {
+    return !aliases.OutputHasAlias(index);
+  });
+  if (bytes <= limit) {
+    return false;
+  }
+  HloInstruction* zeros = ZerosOf(entry, root->shape());
+  if (zeros == nullptr) {
+    return false;
+  }
+  if (root->has_sharding()) {
+    zeros->set_sharding(root->sharding());
+  }
+  VLOG(1) << "Module " << module->name() << "'s arguments and new outputs hold "
+          << bytes << " bytes, over its compile's limit of " << limit
+          << ": its entry is hollowed before its optimization";
+  entry->set_root_instruction(zeros, /*accept_different_shape=*/false);
+  TF_RETURN_IF_ERROR(HloDCE().Run(module).status());
+  module->RemoveUnusedComputations();
+  return true;
+}

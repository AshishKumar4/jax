+// The device bytes of `shape`'s arrays as the entry's ABI places them
+// (`counted` picks leaves), or nullopt where any leaf is no array (a token, an
+// opaque) or lies outside device memory (pinned host, S(5)): layout assignment
+// clears an instruction's memory space, and the host offloader restores it
+// from the entry computation layout, so that layout alone says where an
+// argument or a result lives.
+std::optional<int64_t> DeviceArrayBytes(
+    const Shape& shape,
+    const std::function<bool(const ShapeIndex&)>& counted) {
+  int64_t bytes = 0;
+  bool device = true;
+  ShapeUtil::ForEachSubshape(
+      shape, [&](const Shape& subshape, const ShapeIndex& index) {
+        if (subshape.IsTuple()) {
+          return;
+        }
+        if (!subshape.IsArray() || !subshape.has_layout() ||
+            subshape.layout().memory_space() != Layout::kDefaultMemorySpace) {
+          device = false;
+          return;
+        }
+        if (counted(index)) {
+          bytes += ShapeUtil::ByteSizeOf(subshape);
+        }
+      });
+  return device ? std::optional<int64_t>(bytes) : std::nullopt;
+}
+
+// An all-zero value of `shape` (a tuple of arrays, nested), its layout
+// `shape`'s, built in `computation`.
+HloInstruction* ZerosOf(HloComputation* computation, const Shape& shape) {
+  if (shape.IsTuple()) {
+    std::vector<HloInstruction*> elements;
+    for (const Shape& element : shape.tuple_shapes()) {
+      elements.push_back(ZerosOf(computation, element));
+    }
+    return computation->AddInstruction(HloInstruction::CreateTuple(elements));
+  }
+  HloInstruction* zero = computation->AddInstruction(
+      HloInstruction::CreateConstant(LiteralUtil::Zero(shape.element_type())));
+  return computation->AddInstruction(
+      HloInstruction::CreateBroadcast(shape, zero, {}));
+}
+
+// A module whose entry's arguments and new outputs (none an argument's alias)
+// alone pass its compile's memory limit
+// (DebugOptions::xla_gpu_memory_limit_early_exit_bytes) holds more than the
+// limit whatever its temporaries: its entry is hollowed to its parameters and
+// zero outputs of its outputs' shapes and layouts, so the rest of the pipeline,
+// autotuning and scheduling among it, runs over nothing, and buffer assignment
+// states the arguments and outputs alone, past the limit, which stops the
+// compile (CompileModuleToLlvmIr), its bytes (CompiledMemoryStats: arguments
+// and outputs, an aliased pair once) at least these. Its memory is so a lower
+// bound of the module's, and its live set no temporary.
+//
+// All is checked before the module changes: a module is left whole where its
+// entry ABI (entry_computation_layout) holds a leaf that is no array or lies
+// outside device memory, which CompiledMemoryStats does not count as device
+// bytes, or where any instruction has a side effect, which neither hollowing
+// nor dead code elimination may drop. A hollowed module is marked
+// (kMemoryLimitHollowed): a compile of it whose buffer assignment came within
+// the limit fails rather than emit code that would run zeros. Whether it was
+// hollowed.
+absl::StatusOr<bool> HollowEntryOverMemoryLimit(HloModule* module) {
+  const int64_t limit =
+      module->config().debug_options().xla_gpu_memory_limit_early_exit_bytes();
+  if (limit <= 0) {
+    return false;
+  }
+  const ComputationLayout& abi = module->entry_computation_layout();
+  int64_t bytes = 0;
+  for (int64_t i = 0; i < abi.parameter_count(); ++i) {
+    std::optional<int64_t> argument =
+        DeviceArrayBytes(abi.parameter_layout(i).shape(),
+                         [](const ShapeIndex&) { return true; });
+    if (!argument.has_value()) {
+      return false;
+    }
+    bytes += *argument;
+  }
+  const HloInputOutputAliasConfig& aliases =
+      module->input_output_alias_config();
+  std::optional<int64_t> outputs =
+      DeviceArrayBytes(abi.result_layout().shape(), [&](const ShapeIndex& at) {
+        return !aliases.OutputHasAlias(at);
+      });
+  if (!outputs.has_value() || bytes + *outputs <= limit) {
+    return false;
+  }
+  bytes += *outputs;
+  for (const HloComputation* computation : module->computations()) {
+    for (const HloInstruction* instruction : computation->instructions()) {
+      if (instruction->HasSideEffectNoRecurse()) {
+        return false;
+      }
+    }
+  }
+  HloComputation* entry = module->entry_computation();
+  HloInstruction* root = entry->root_instruction();
+  HloInstruction* zeros = ZerosOf(entry, root->shape());
+  if (root->has_sharding()) {
+    zeros->set_sharding(root->sharding());
+  }
+  VLOG(1) << "Module " << module->name() << "'s arguments and new outputs hold "
+          << bytes << " bytes, over its compile's limit of " << limit
+          << ": its entry is hollowed before its optimization";
+  entry->set_root_instruction(zeros, /*accept_different_shape=*/false);
+  module->add_frontend_attribute(kMemoryLimitHollowed, "true");
+  TF_RETURN_IF_ERROR(HloDCE().Run(module).status());
+  module->RemoveUnusedComputations();
+  return true;
+}

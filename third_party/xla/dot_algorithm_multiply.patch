+absl::StatusOr<HloInstruction*>
+DotAlgorithmRewriter::MakeMultiplyForF16F16F32(HloInstruction* lhs,
+                                               HloInstruction* rhs) {
+  TF_RET_CHECK(lhs->shape().element_type() == PrimitiveType::F32 ||
+               lhs->shape().element_type() == PrimitiveType::F16)
+      << "Algorithm field set to F16_F16_F32, but the lhs isn't F32 or F16.";
+  TF_RET_CHECK(rhs->shape().element_type() == PrimitiveType::F32 ||
+               rhs->shape().element_type() == PrimitiveType::F16)
+      << "Algorithm field set to F16_F16_F32, but the rhs isn't F32 or F16.";
+  // Each operand rounded to F16, as the algorithm reads it, and multiplied in
+  // F32, where the product of two halves (11 significant bits each) is exact,
+  // so the F32 accumulation sums the products the algorithm states.
+  auto as_f16 = [](HloInstruction* operand) {
+    if (operand->shape().element_type() == PrimitiveType::F16) {
+      return operand;
+    }
+    Shape shape = operand->shape();
+    shape.set_element_type(PrimitiveType::F16);
+    return operand->AddInstruction(
+        HloInstruction::CreateConvert(shape, operand));
+  };
+  return Mult(UpcastToF32(as_f16(lhs)), UpcastToF32(as_f16(rhs)));
+}
+
+absl::StatusOr<HloInstruction*>
+DotAlgorithmRewriter::MakeMultiplyForF8F8F32(HloInstruction* lhs,
+                                             HloInstruction* rhs) {
+  // Multiplied in F32, where the product of two F8 values is exact: each
+  // operand F8, or a wider float of one's value where a GPU of no F8 products
+  // had them converted (float normalization), taken as it is.
+  return Mult(UpcastToF32(lhs), UpcastToF32(rhs));
+}

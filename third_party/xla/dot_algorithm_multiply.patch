       return DotAlgorithmRewriter::MakeMultiplyForTF32TF32F32(lhs, rhs);
     case PrecisionConfig::ALG_DOT_TF32_TF32_F32_X3:
       return DotAlgorithmRewriter::MakeMultiplyForTF32TF32F32X3(lhs, rhs);

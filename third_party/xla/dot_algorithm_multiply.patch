Subject: [XLA:GPU] A small dot strength-reduces as its precision algorithm states

DotStrengthReduction rewrites a small or vector dot to a multiply and a reduce
through MakeMultiplyForDotPrecisionAlgorithm, which had no case for
ALG_DOT_F16_F16_F32, F16_F16_F16, BF16_BF16_BF16, F64_F64_F64 or the ANY_F8
algorithms and refused such a dot (INVALID_ARGUMENT "Unsupported dot precision
algorithm"). Each is multiplied as its algorithm states and summed in its
accumulator type: F16 operands in F32 for F16_F16_F32 and F8 ones for ANY_F8
(their products exact there), the operands' own type otherwise. A dot at an F8
emulation of a BF16 product (BF16_BF16_FP8X3, _FP8X4), whose result its
emulation defines, is kept a dot.
---
diff --git a/xla/backends/gpu/transforms/dot_algorithm_rewriter.cc b/xla/backends/gpu/transforms/dot_algorithm_rewriter.cc
index c8407ee12f..b97b5deee3 100644
--- a/xla/backends/gpu/transforms/dot_algorithm_rewriter.cc
+++ b/xla/backends/gpu/transforms/dot_algorithm_rewriter.cc
@@ -34,6 +34,7 @@ limitations under the License.
 #include "xla/hlo/ir/hlo_module.h"
 #include "xla/hlo/ir/hlo_opcode.h"
 #include "xla/literal_util.h"
+#include "xla/primitive_util.h"
 #include "xla/service/hlo_creation_utils.h"
 #include "xla/shape.h"
 #include "xla/status_macros.h"
@@ -427,6 +428,41 @@ DotAlgorithmRewriter::MakeMultiplyForBF16BF16F32(HloInstruction* lhs,
   return UpcastToF32(result_bf16);
 }
 
+absl::StatusOr<HloInstruction*>
+DotAlgorithmRewriter::MakeMultiplyForF16F16F32(HloInstruction* lhs,
+                                               HloInstruction* rhs) {
+  TF_RET_CHECK(lhs->shape().element_type() == PrimitiveType::F32 ||
+               lhs->shape().element_type() == PrimitiveType::F16)
+      << "Algorithm field set to F16_F16_F32, but the lhs isn't F32 or F16.";
+  TF_RET_CHECK(rhs->shape().element_type() == PrimitiveType::F32 ||
+               rhs->shape().element_type() == PrimitiveType::F16)
+      << "Algorithm field set to F16_F16_F32, but the rhs isn't F32 or F16.";
+  // Each operand rounded to F16, as the algorithm reads it, and multiplied in
+  // F32, where the product of two halves (11 significant bits each) is exact,
+  // so the F32 accumulation sums the products the algorithm states.
+  auto as_f16 = [](HloInstruction* operand) {
+    if (operand->shape().element_type() == PrimitiveType::F16) {
+      return operand;
+    }
+    Shape shape = operand->shape();
+    shape.set_element_type(PrimitiveType::F16);
+    return operand->AddInstruction(
+        HloInstruction::CreateConvert(shape, operand));
+  };
+  return Mult(UpcastToF32(as_f16(lhs)), UpcastToF32(as_f16(rhs)));
+}
+
+absl::StatusOr<HloInstruction*>
+DotAlgorithmRewriter::MakeMultiplyForF8F8F32(HloInstruction* lhs,
+                                             HloInstruction* rhs) {
+  TF_RET_CHECK(primitive_util::IsF8Type(lhs->shape().element_type()))
+      << "Algorithm field set to ANY_F8_ANY_F8_F32, but the lhs isn't F8.";
+  TF_RET_CHECK(primitive_util::IsF8Type(rhs->shape().element_type()))
+      << "Algorithm field set to ANY_F8_ANY_F8_F32, but the rhs isn't F8.";
+  // Multiplied in F32, where the product of two F8 values is exact.
+  return Mult(UpcastToF32(lhs), UpcastToF32(rhs));
+}
+
 absl::StatusOr<HloInstruction*>
 DotAlgorithmRewriter::MakeMultiplyForBF16BF16F32X3(HloInstruction* lhs,
                                                    HloInstruction* rhs) {

From 667a79f43dd79aa62e6e9b0082e35ee293d5020a Mon Sep 17 00:00:00 2001
From: Ashish Kumar Singh <ashishkmr472@gmail.com>
Date: Wed, 11 Nov 2026 09:33:05 -0600
Subject: [PATCH] [XLA:GPU] Deterministic ops keep Triton's GEMMs by default

TritonBackend refuses split-k, so a Triton GEMM fusion's sums are ordered, and
it repeats its bits under deterministic ops; dropping it routed every fused dot
to cuBLASLt, whose chain of small batched f32 products did not repeat its bits
on an A100 under deterministic ops and autotune level 0 (selected algorithm 0).
--xla_gpu_experimental_deterministic_ops_triton now defaults to 'unchecked';
'off' drops Triton and its GEMM fusions as before.
---
 xla/backends/gpu/tests/dot_deterministic.hlo | 14 +++++++++-----
 xla/debug_options_flags.cc                   |  9 ++++++---
 2 files changed, 15 insertions(+), 8 deletions(-)

diff --git a/xla/backends/gpu/tests/dot_deterministic.hlo b/xla/backends/gpu/tests/dot_deterministic.hlo
index 0cfdc444c2..1481870e0f 100644
--- a/xla/backends/gpu/tests/dot_deterministic.hlo
+++ b/xla/backends/gpu/tests/dot_deterministic.hlo
@@ -1,9 +1,13 @@
-// RUN: %if !IS_ROCM %{ hlo-opt %s --platform=gpu --stage=hlo --xla_gpu_target_config_filename=%S/../target_config/specs/h100_sxm.txtpb --xla_gpu_deterministic_ops=true --xla_gpu_autotune_level=0 | FileCheck %s %}
+// RUN: %if !IS_ROCM %{ hlo-opt %s --platform=gpu --stage=hlo --xla_gpu_target_config_filename=%S/../target_config/specs/h100_sxm.txtpb --xla_gpu_deterministic_ops=true --xla_gpu_experimental_deterministic_ops_triton=off --xla_gpu_autotune_level=0 | FileCheck %s %}
+// RUN: %if !IS_ROCM %{ hlo-opt %s --platform=gpu --stage=hlo --xla_gpu_target_config_filename=%S/../target_config/specs/h100_sxm.txtpb --xla_gpu_deterministic_ops=true --xla_gpu_autotune_level=0 | FileCheck %s --check-prefix=KEPT %}
 
-// Under deterministic ops the autotuner has no Triton backend, so no GEMM
-// fusion is made: a batched dot whose batch dimension sits between the others,
-// which cuBLAS takes only once its layout is normalized, compiles to a cuBLAS
-// call with no device.
+// Under deterministic ops with Triton off the autotuner has no Triton backend,
+// so no GEMM fusion is made: a batched dot whose batch dimension sits between
+// the others, which cuBLAS takes only once its layout is normalized, compiles
+// to a cuBLAS call with no device. By default deterministic ops keep Triton,
+// whose GEMM fusion takes its default config with no device.
+
+// KEPT: __triton_gemm
 
 // CHECK-NOT: __triton_gemm
 // CHECK: custom_call_target="__cublas${{gemm|lt\$matmul}}"
diff --git a/xla/debug_options_flags.cc b/xla/debug_options_flags.cc
index af30005b1b..d9c37f9caa 100644
--- a/xla/debug_options_flags.cc
+++ b/xla/debug_options_flags.cc
@@ -632,8 +632,11 @@ DebugOptions DefaultDebugOptionsIgnoringFlags() {
       DebugOptions::DEVICELESS_CUB_WITH_FALLBACK);
   opts.set_xla_gpu_cudnn_deviceless_compilation_mode(
       DebugOptions::CUDNN_DEVICELESS_COMPILATION_DISABLED);
+  // Triton's GEMMs take no split-k (TritonBackend refuses split_k > 1), so
+  // their sums are ordered: deterministic ops keep them, a GEMM fusion then
+  // repeating its bits where a cuBLASLt call need not.
   opts.set_xla_gpu_experimental_deterministic_ops_triton(
-      DebugOptions::DETERMINISTIC_OPS_TRITON_MODE_OFF);
+      DebugOptions::DETERMINISTIC_OPS_TRITON_MODE_UNCHECKED);
   // Pre-populate all default autotune backends so that modifier flags (e.g.
   // +cudnn, -triton) can apply to the full default set.
   for (int i = 0; i < autotuner::Backend_descriptor()->value_count(); ++i) {
@@ -4027,11 +4030,11 @@ void MakeDebugOptionsFlags(std::vector<tsl::Flag>* flag_list,
   flag_list->push_back(tsl::Flag(
       "xla_gpu_experimental_deterministic_ops_triton",
       setter_for_xla_gpu_experimental_deterministic_ops_triton,
-      /*default_value_for_display=*/"off",
+      /*default_value_for_display=*/"unchecked",
       "Controls whether Triton is enabled when deterministic ops are requested "
       "(--xla_gpu_deterministic_ops or "
       "--xla_gpu_exclude_nondeterministic_ops). "
-      "Supported modes: 'off' (default) and 'unchecked' (enables Triton and "
+      "Supported modes: 'off' and 'unchecked' (default: enables Triton and "
       "skips correctness checks)."));
 }  // NOLINT(readability/fn_size)
 
-- 

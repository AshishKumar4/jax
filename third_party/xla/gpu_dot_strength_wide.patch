diff --git a/xla/backends/gpu/transforms/dot_strength_reduction.cc b/xla/backends/gpu/transforms/dot_strength_reduction.cc
--- a/xla/backends/gpu/transforms/dot_strength_reduction.cc
+++ b/xla/backends/gpu/transforms/dot_strength_reduction.cc
@@ -156,4 +156,15 @@
   const OpMetadata* metadata = &dot->metadata();
   ABSL_ASSIGN_OR_RETURN(auto dot_dims, DotOperandDims::FromDot(dot));
+  const auto algorithm = dot->precision_config().algorithm();
+  const PrimitiveType output_type = dot->shape().element_type();
+  const int64_t contracting_dims = dot_dims[0].Rank(DotOperandDims::kContracting);
+  const PrimitiveType accumulator_type = GetGemmAccumulatorType(dot);
+  // A dot with an implicit algorithm must not round each product to the
+  // output type before summation. Outer products and explicit algorithms
+  // retain the multiply input types they used before.
+  const PrimitiveType multiply_type =
+      algorithm == PrecisionConfig::ALG_UNSET && contracting_dims != 0
+          ? accumulator_type
+          : output_type;
 
   std::array<HloInstruction*, 2> operands = {dot->mutable_operand(0),
@@ -162,6 +173,5 @@
     DotOperandDims& our_dims = dot_dims[i];
     DotOperandDims& other_dims = dot_dims[1 - i];
-    // Convert operands to the dot resulting type.
-    operands[i] = ConvertTo(operands[i], dot->shape().element_type(), metadata);
+    operands[i] = ConvertTo(operands[i], multiply_type, metadata);
     // Ensure dimensions are in "batch, non-contracting, contracting" order.
     operands[i] = PermuteDotOperandDimensions(operands[i], &our_dims, metadata);
@@ -186,15 +196,14 @@
       HloInstruction * flow,
       MakeMultiplyForDotPrecisionAlgorithm(
-          operands[0], operands[1], dot->precision_config().algorithm()));
+          operands[0], operands[1], algorithm));
   flow->set_metadata(*metadata);
 
   // If there were any contracting dims, we need to reduce them.
-  flow = ReduceDimensions(flow, dot_dims[0].Rank(DotOperandDims::kContracting),
-                          GetGemmAccumulatorType(dot), metadata);
+  flow = ReduceDimensions(flow, contracting_dims, accumulator_type, metadata);
 
   // If the output type is different from what it was before (either because
   // reduction used a different accumulator type, or because types of operand
   // differed the output type for multiply), convert to the output type.
-  flow = ConvertTo(flow, dot->shape().element_type(), metadata);
+  flow = ConvertTo(flow, output_type, metadata);
   return flow;
 }

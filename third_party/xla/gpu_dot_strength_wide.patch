+TEST_F(DotStrengthReductionTest, NarrowGemvKeepsProductBitsThroughReduction) {
+  ASSERT_OK_AND_ASSIGN(auto module, ParseAndReturnVerifiedModule(R"(
+HloModule narrow_gemv
+ENTRY main {
+  lhs = bf16[2] parameter(0)
+  rhs = bf16[2,2] parameter(1)
+  ROOT dot = bf16[2] dot(lhs, rhs), lhs_contracting_dims={0},
+      rhs_contracting_dims={0}, operand_precision={highest,highest}
+})"));
+  DotStrengthReduction pass{
+      se::GpuComputeCapability(se::CudaComputeCapability::Hopper())};
+  ASSERT_OK_AND_ASSIGN(bool changed, RunHloPass(&pass, module.get()));
+  ASSERT_TRUE(changed);
+  CHECK_OK(module->Verify());
+
+  ASSERT_OK_AND_ASSIGN(
+      auto lhs, LiteralUtil::CreateR1<float>({1.0078125f, 1.f}).Convert(BF16));
+  ASSERT_OK_AND_ASSIGN(
+      auto rhs,
+      LiteralUtil::CreateR2<float>({{1.0078125f, 1.f}, {-1.015625f, 0.f}})
+          .Convert(BF16));
+  ASSERT_OK_AND_ASSIGN(Literal result,
+                       HloEvaluator().Evaluate(*module, {&lhs, &rhs}));
+  // (1 + 2^-7)^2 - (1 + 2^-6) = 2^-14, but in BF16 the products cancel.
+  EXPECT_EQ(result.GetAsDouble({0}), 0x1p-14);
+  EXPECT_EQ(result.GetAsDouble({1}), 1.0078125);
+}
+
+// A one-row bf16 dot under an explicit BF16_BF16_F32 algorithm: its products
+// exact in f32 and summed there, whatever its output type, where each was
+// rounded to bf16 before the sum (Dew rows 13666 and 13678: an opt-in decode
+// region's bf16 dots 0.69 from float64 against 0.029 allowed).
+TEST_F(DotStrengthReductionTest, OneRowBf16DotUnderAnAlgorithmSumsExactProducts) {
+  for (const char* output : {"bf16", "f32"}) {
+    SCOPED_TRACE(output);
+    ASSERT_OK_AND_ASSIGN(
+        auto module, ParseAndReturnVerifiedModule(absl::StrReplaceAll(R"(
+HloModule one_row
+ENTRY main {
+  lhs = bf16[1,2] parameter(0)
+  rhs = bf16[2,2] parameter(1)
+  ROOT dot = OUT[1,2] dot(lhs, rhs), lhs_contracting_dims={1},
+      rhs_contracting_dims={0}, algorithm=dot_bf16_bf16_f32
+})",
+                                                               {{"OUT", output}})));
+    DotStrengthReduction pass{
+        se::GpuComputeCapability(se::CudaComputeCapability::Hopper())};
+    ASSERT_OK_AND_ASSIGN(bool changed, RunHloPass(&pass, module.get()));
+    ASSERT_TRUE(changed);
+    CHECK_OK(module->Verify());
+
+    ASSERT_OK_AND_ASSIGN(
+        auto lhs,
+        LiteralUtil::CreateR2<float>({{1.0078125f, 1.f}}).Convert(BF16));
+    ASSERT_OK_AND_ASSIGN(
+        auto rhs,
+        LiteralUtil::CreateR2<float>({{1.0078125f, 1.f}, {-1.015625f, 0.f}})
+            .Convert(BF16));
+    ASSERT_OK_AND_ASSIGN(Literal result,
+                         HloEvaluator().Evaluate(*module, {&lhs, &rhs}));
+    // (1 + 2^-7)^2 - (1 + 2^-6) = 2^-14; each product rounded to bf16, 0.
+    EXPECT_EQ(result.GetAsDouble({0, 0}), 0x1p-14);
+    EXPECT_EQ(result.GetAsDouble({0, 1}), 1.0078125);
+  }
+}

From 3db33fda321052ffed3b014b0c5078be292620a6 Mon Sep 17 00:00:00 2001
From: Ashish Kumar Singh <ashishkmr472@gmail.com>
Date: Tue, 10 Nov 2026 23:54:17 -0600
Subject: [PATCH] [XLA:GPU] No GEMM fusion under deterministic ops where the
 autotuner keeps no Triton backend

ConfigAssignerPass::GetEnabledBackends drops the Triton backend under
--xla_gpu_deterministic_ops (or --xla_gpu_exclude_nondeterministic_ops) unless
--xla_gpu_experimental_deterministic_ops_triton keeps it, but GemmFusion still
made __triton_gemm fusions, gated on --xla_gpu_enable_triton_gemm alone. Such a
fusion had only cuBLAS through FissionBackend, which refuses an operand whose
batch dimensions are not physically sequential and enumerates no config
without a device, and no backend gave it a default config: 'No supported
config found for HLO'. Triton GEMM is now off where its backend is, and the
dots are rewritten to cuBLAS after layout normalization.
---
 xla/backends/gpu/tests/BUILD                 |  1 +
 xla/backends/gpu/tests/dot_deterministic.hlo | 17 +++++++++++++++++
 xla/service/gpu/gpu_compiler.cc              | 11 +++++++++++
 3 files changed, 29 insertions(+)
 create mode 100644 xla/backends/gpu/tests/dot_deterministic.hlo

diff --git a/xla/backends/gpu/tests/BUILD b/xla/backends/gpu/tests/BUILD
index f440975968..5e3a694ca6 100644
--- a/xla/backends/gpu/tests/BUILD
+++ b/xla/backends/gpu/tests/BUILD
@@ -728,6 +728,7 @@ lit_test_suite_for_gpus(
             "bitcast-convert.hlo",
             "calling_convention.hlo",
             "dot_bf16.hlo",
+            "dot_deterministic.hlo",
             "kernel_reuse.hlo",
             "memory_bandwidth_fusion.hlo",
             "offload_scan_output.hlo",
diff --git a/xla/backends/gpu/tests/dot_deterministic.hlo b/xla/backends/gpu/tests/dot_deterministic.hlo
new file mode 100644
index 0000000000..0cfdc444c2
--- /dev/null
+++ b/xla/backends/gpu/tests/dot_deterministic.hlo
@@ -0,0 +1,17 @@
+// RUN: %if !IS_ROCM %{ hlo-opt %s --platform=gpu --stage=hlo --xla_gpu_target_config_filename=%S/../target_config/specs/h100_sxm.txtpb --xla_gpu_deterministic_ops=true --xla_gpu_autotune_level=0 | FileCheck %s %}
+
+// Under deterministic ops the autotuner has no Triton backend, so no GEMM
+// fusion is made: a batched dot whose batch dimension sits between the others,
+// which cuBLAS takes only once its layout is normalized, compiles to a cuBLAS
+// call with no device.
+
+// CHECK-NOT: __triton_gemm
+// CHECK: custom_call_target="__cublas${{gemm|lt\$matmul}}"
+
+HloModule batched_dot
+
+ENTRY e {
+  a = f32[128,8,16]{2,1,0} parameter(0)
+  b = f32[8,16,128]{2,1,0} parameter(1)
+  ROOT d = f32[8,128,128]{2,1,0} dot(a, b), lhs_batch_dims={1}, lhs_contracting_dims={2}, rhs_batch_dims={0}, rhs_contracting_dims={1}, operand_precision={highest,highest}
+}
diff --git a/xla/service/gpu/gpu_compiler.cc b/xla/service/gpu/gpu_compiler.cc
index d438020ba2..d8c4190391 100644
--- a/xla/service/gpu/gpu_compiler.cc
+++ b/xla/service/gpu/gpu_compiler.cc
@@ -374,6 +374,17 @@ bool IsTritonGemmEnabled(const DebugOptions& debug_options,
   if (!debug_options.xla_gpu_enable_triton_gemm()) {
     return false;
   }
+  // Deterministic ops leave the autotuner no Triton backend unless Triton is
+  // kept (ConfigAssignerPass::GetEnabledBackends). A GEMM fusion made then has
+  // only cuBLAS through fission, which takes no operand whose batch dimensions
+  // are not physically sequential and enumerates no config without a device:
+  // its dots are rewritten to cuBLAS as with Triton GEMM off.
+  if ((debug_options.xla_gpu_deterministic_ops() ||
+       debug_options.xla_gpu_exclude_nondeterministic_ops()) &&
+      debug_options.xla_gpu_experimental_deterministic_ops_triton() ==
+          DebugOptions::DETERMINISTIC_OPS_TRITON_MODE_OFF) {
+    return false;
+  }
   return IsTritonEnabled(gpu_version);
 }
 

 namespace stream_executor::gpu {
 
+// The kernels a CUDA graph's conditionals and barriers launch (no-op barriers,
+// updating conditional handles), loaded once by an executor and shared by
+// every command buffer it makes, nested ones among them: a graph recorded
+// later loads no module. A module loaded as a graph is recorded is PTX
+// compiled under the driver's lock; where one process drives two GPUs and
+// the other's graph waits in a collective for this one, that load and the
+// other's graph instantiation never return.
+struct CudaCommandBufferKernels {
+  using NoOp = TypedKernel<>;
+  using SetCaseCondition =
+      TypedKernel<CUgraphConditionalHandle, CUgraphConditionalHandle,
+                  CUgraphConditionalHandle, CUgraphConditionalHandle,
+                  CUgraphConditionalHandle, CUgraphConditionalHandle,
+                  CUgraphConditionalHandle, CUgraphConditionalHandle,
+                  DeviceAddress<uint8_t>, bool, int32_t, int32_t, bool>;
+  using SetWhileCondition =
+      TypedKernel<CUgraphConditionalHandle, DeviceAddress<bool>>;
+
+  // Loads the three on `executor`. Its cuModuleGetFunction loads each
+  // module to the device, also where the driver loads modules lazily
+  // (CUDA_MODULE_LOADING=LAZY).
+  static absl::StatusOr<std::unique_ptr<CudaCommandBufferKernels>> Load(
+      StreamExecutor* executor);
+
+  NoOp noop;
+  SetCaseCondition set_case_condition;
+  SetWhileCondition set_while_condition;
+};

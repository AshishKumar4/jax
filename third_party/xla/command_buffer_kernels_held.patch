+// The CUDA modules this process loads while one lives and is subscribed: the
+// calls into cuModuleLoadData and cuModuleLoadDataEx CUPTI's driver callbacks
+// see, from any thread.
+class ModuleLoads {
+ public:
+  ModuleLoads() {
+    status_ = cuptiSubscribe(&subscriber_, &Count, &loads_);
+    if (status_ != CUPTI_SUCCESS) {
+      return;
+    }
+    subscribed_ = true;
+    for (CUpti_CallbackId call : {CUPTI_DRIVER_TRACE_CBID_cuModuleLoadData,
+                                  CUPTI_DRIVER_TRACE_CBID_cuModuleLoadDataEx}) {
+      if (status_ == CUPTI_SUCCESS) {
+        status_ = cuptiEnableCallback(1, subscriber_,
+                                      CUPTI_CB_DOMAIN_DRIVER_API, call);
+      }
+    }
+  }
+  ~ModuleLoads() {
+    if (subscribed_) {
+      cuptiUnsubscribe(subscriber_);
+    }
+  }
+
+  CUptiResult status() const { return status_; }
+  int loads() const { return loads_.load(); }
+
+ private:
+  static void CUPTIAPI Count(void* loads, CUpti_CallbackDomain,
+                             CUpti_CallbackId, const void* data) {
+    if (static_cast<const CUpti_CallbackData*>(data)->callbackSite ==
+        CUPTI_API_ENTER) {
+      ++*static_cast<std::atomic<int>*>(loads);
+    }
+  }
+
+  CUpti_SubscriberHandle subscriber_ = nullptr;
+  bool subscribed_ = false;
+  CUptiResult status_;
+  std::atomic<int> loads_ = 0;
+};
+
+// A graph's while and case nodes are steered, and an empty branch filled, by
+// kernels of their own: a cold executor loads them as it makes its first
+// command buffer, so recording a while whose body holds a case, one branch
+// empty, nested graphs each, loads no module. A load while the graph is
+// recorded compiles PTX under the driver's lock, which in a process driving
+// two GPUs never returned while the other GPU's graph waited in a collective
+// for this one.
+TEST(CudaCommandBufferKernelsTest, RecordingConditionalsLoadsNoModule) {
+  StreamExecutor* cached = CudaPlatform()->ExecutorForDevice(0).value();
+  if (cached->GetDeviceDescription().driver_version() <
+      SemanticVersion{12, 3, 0}) {
+    GTEST_SKIP() << "CUDA command buffers require CUDA driver >= 12.3";
+  }
+  // A fresh executor, none of whose kernels is loaded yet, held as the
+  // StreamExecutor it is (CudaExecutor's own CreateStream hides the base's).
+  auto cuda_executor = std::make_unique<gpu::CudaExecutor>(CudaPlatform(), 0);
+  TF_ASSERT_OK(cuda_executor->Init());
+  std::unique_ptr<StreamExecutor> executor = std::move(cuda_executor);
+  TF_ASSERT_OK_AND_ASSIGN(std::unique_ptr<Stream> stream,
+                          executor->CreateStream());
+  TF_ASSERT_OK_AND_ASSIGN(auto add, gpu::LoadAddI32TestKernel(executor.get()));
+  TF_ASSERT_OK_AND_ASSIGN(auto inc_and_cmp,
+                          gpu::LoadCmpAndIncTestKernel(executor.get()));
+
+  constexpr int64_t kLength = 4;
+  constexpr int64_t kBytes = sizeof(int32_t) * kLength;
+  DeviceAddress<bool> pred = executor->AllocateArray<bool>(1, 0);
+  DeviceAddress<int32_t> counter = executor->AllocateArray<int32_t>(1, 0);
+  DeviceAddress<int32_t> iterations = executor->AllocateArray<int32_t>(1, 0);
+  DeviceAddress<int32_t> index = executor->AllocateArray<int32_t>(1, 0);
+  DeviceAddress<int32_t> a = executor->AllocateArray<int32_t>(kLength, 0);
+  DeviceAddress<int32_t> b = executor->AllocateArray<int32_t>(kLength, 0);
+  TF_ASSERT_OK(stream->Memset32(&counter, 0, sizeof(int32_t)));
+  TF_ASSERT_OK(stream->Memset32(&iterations, 10, sizeof(int32_t)));
+  TF_ASSERT_OK(stream->Memset32(&index, 0, sizeof(int32_t)));
+  TF_ASSERT_OK(stream->Memset32(&a, 1, kBytes));
+  TF_ASSERT_OK(stream->MemZero(&b, kBytes));
+
+  std::unique_ptr<CommandBuffer> cmd_buffer;
+  {
+    ModuleLoads made;
+    if (made.status() == CUPTI_ERROR_MULTIPLE_SUBSCRIBERS_NOT_SUPPORTED) {
+      GTEST_SKIP() << "Another CUPTI subscriber holds the driver callbacks";
+    }
+    ASSERT_EQ(made.status(), CUPTI_SUCCESS);
+    TF_ASSERT_OK_AND_ASSIGN(cmd_buffer, executor->CreateCommandBuffer(primary));
+    // The control: the cold executor's helper kernels load here.
+    EXPECT_GT(made.loads(), 0);
+  }
+
+  ModuleLoads recorded;
+  ASSERT_EQ(recorded.status(), CUPTI_SUCCESS);
+  CommandBuffer::CreateCommands cond = [&](CommandBuffer* cond_cmd,
+                                           auto deps) {
+    return Wrap(cond_cmd->CreateLaunch(inc_and_cmp, ThreadDim(), BlockDim(),
+                                       {}, deps, counter, pred, iterations));
+  };
+  CommandBuffer::CreateCommands body = [&](CommandBuffer* body_cmd,
+                                           auto deps) {
+    std::vector<CommandBuffer::CreateCommands> branches;
+    branches.push_back([&](CommandBuffer* branch_cmd, auto branch_deps) {
+      return Wrap(branch_cmd->CreateLaunch(add, ThreadDim(),
+                                           BlockDim(kLength), {}, branch_deps,
+                                           a, b, b));
+    });
+    branches.push_back([](CommandBuffer*, auto) {
+      return std::vector<const CommandBuffer::Command*>{};
+    });
+    return Wrap(body_cmd->CreateCase(index, std::move(branches), deps));
+  };
+  TF_ASSERT_OK(cmd_buffer->CreateWhile(pred, std::move(cond), std::move(body),
+                                    {}));
+  TF_ASSERT_OK(cmd_buffer->Finalize());
+  EXPECT_EQ(recorded.loads(), 0);
+
+  TF_ASSERT_OK(cmd_buffer->Submit(stream.get()));
+  std::vector<int32_t> sums(kLength, 42);
+  TF_ASSERT_OK(stream->Memcpy(sums.data(), b, kBytes));
+  TF_ASSERT_OK(stream->BlockHostUntilDone());
+  EXPECT_THAT(sums, Each(10));
+  for (DeviceAddressBase* held :
+       std::initializer_list<DeviceAddressBase*>{&pred, &counter, &iterations,
+                                                 &index, &a, &b}) {
+    executor->Deallocate(held);
+  }
+}

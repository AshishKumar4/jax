+TEST(GpuCliqueRendezvousTest, AFailedRanksPeersReturnItsFailure) {
+  // Rank 1 fails before the rendezvous (its scratch past the device's memory)
+  // and joins in place of its data: rank 0's read of it, and its check of its
+  // peers, return the failure rather than wait for a rank that never joins.
+  GlobalDeviceId id0 = GlobalDeviceId(0);
+  GlobalDeviceId id1 = GlobalDeviceId(1);
+  GpuCliqueKey key({id0, id1}, /*num_local_participants=*/2);
+
+  absl::Status read, ready, failed;
+  {
+    auto thread_pool = CreateThreadPool(2);
+    thread_pool.Schedule([&] {
+      absl::StatusOr<std::shared_ptr<GpuCliqueRendezvous>> rendezvous =
+          GpuCliqueRendezvous::Join(key, RankId(0), int32_t{0});
+      ASSERT_TRUE(rendezvous.ok()) << rendezvous.status();
+      read = (*rendezvous)->at<int32_t>(RankId(1)).status();
+      ready = (*rendezvous)->PeersReady();
+    });
+    thread_pool.Schedule([&] {
+      failed = GpuCliqueRendezvous::JoinFailed(
+          key, RankId(1),
+          absl::ResourceExhaustedError("Failed to allocate Scratch 1"));
+    });
+  }
+  EXPECT_EQ(failed.code(), absl::StatusCode::kResourceExhausted);
+  for (const absl::Status& status : {read, ready}) {
+    EXPECT_EQ(status.code(), absl::StatusCode::kFailedPrecondition);
+    EXPECT_THAT(status.message(), ::testing::HasSubstr("Rank 1"));
+    EXPECT_THAT(status.message(),
+                ::testing::HasSubstr("Failed to allocate Scratch 1"));
+  }
+}
+
+TEST(GpuCliqueRendezvousTest, ReadyPeersAreReady) {
+  GlobalDeviceId id0 = GlobalDeviceId(0);
+  GlobalDeviceId id1 = GlobalDeviceId(1);
+  GpuCliqueKey key({id0, id1}, /*num_local_participants=*/2);
+
+  absl::Status ready[2];
+  {
+    auto thread_pool = CreateThreadPool(2);
+    for (int32_t id : {0, 1}) {
+      thread_pool.Schedule([&, id] {
+        absl::StatusOr<std::shared_ptr<GpuCliqueRendezvous>> rendezvous =
+            GpuCliqueRendezvous::Join(key, RankId(id), int32_t{id});
+        ASSERT_TRUE(rendezvous.ok()) << rendezvous.status();
+        ready[id] = (*rendezvous)->PeersReady();
+      });
+    }
+  }
+  EXPECT_TRUE(ready[0].ok()) << ready[0];
+  EXPECT_TRUE(ready[1].ok()) << ready[1];
+}
+
+TEST(GpuCliqueRendezvousDeathTest, AMissingRankEndsAtTheTerminationTimeout) {
+  // A rank that never joins (its failure told no one) holds its peer at most
+  // the GPU collectives' termination timeout: the process ends, rather than
+  // the peer waiting forever. Run in a process of its own, which reads the
+  // flag afresh.
+  GTEST_FLAG_SET(death_test_style, "threadsafe");
+  const char* held = std::getenv("XLA_FLAGS");
+  const std::optional<std::string> before =
+      held == nullptr ? std::nullopt : std::make_optional<std::string>(held);
+  setenv("XLA_FLAGS", "--xla_gpu_nccl_termination_timeout_seconds=1", 1);
+  GlobalDeviceId id0 = GlobalDeviceId(0);
+  GlobalDeviceId id1 = GlobalDeviceId(1);
+  GpuCliqueKey key({id0, id1}, /*num_local_participants=*/2);
+  EXPECT_DEATH(
+      {
+        auto rendezvous =
+            GpuCliqueRendezvous::Join(key, RankId(0), int32_t{0});
+        (void)rendezvous;
+      },
+      "Termination timeout");
+  // The parent's flags as they were: the next test reads them.
+  if (before.has_value()) {
+    setenv("XLA_FLAGS", before->c_str(), 1);
+  } else {
+    unsetenv("XLA_FLAGS");
+  }
+}

+// A rendezvous of a local clique warns past WarnStuckTimeout and ends at the
+// GPU collectives' termination timeout past that, as acquiring a clique does
+// (gpu_cliques.cc), so a rank that never joins holds its peers no longer:
+// xla_gpu_nccl_termination_timeout_seconds -1 (the default) waits on after the
+// warning as before; N >= 0 ends the process N seconds after it, its stacks
+// dumped (xla/service/rendezvous.cc).
+absl::Duration WarnStuckTimeout() { return absl::Seconds(10); }
+
+absl::Duration TerminateTimeout() {
+  static const int64_t terminate_timeout =
+      GetDebugOptionsFromFlags().xla_gpu_nccl_termination_timeout_seconds();
+  return terminate_timeout >= 0 ? absl::Seconds(terminate_timeout)
+                                : absl::InfiniteDuration();
+}

+  return Rendezvous<GpuCliqueRendezvous>(
+      rendezvous_name, rendezvous_key, rendezvous_value, num_participants,
+      callback, WarnStuckTimeout(), TerminateTimeout());
+}
+
+absl::Status GpuCliqueRendezvous::JoinFailed(const GpuCliqueKey& clique_key,
+                                             RankId rank,
+                                             absl::Status failure) {
+  // A failure that is no error still names one: a peer reads it as failed.
+  absl::Status carried =
+      failure.ok() ? Internal("rank %d failed with no status", rank.value())
+                   : failure;
+  absl::StatusOr<std::shared_ptr<GpuCliqueRendezvous>> joined =
+      Join(clique_key, rank, RankFailure{carried});
+  if (!joined.ok()) {
+    return absl::Status(carried.code(),
+                        absl::StrCat(carried.message(), "; and its peers were "
+                                                        "not told: ",
+                                     joined.status().message()));
+  }
+  return carried;
+}
+
+absl::Status GpuCliqueRendezvous::PeersReady() const {
+  for (const auto& [rank, value] : values_) {
+    if (const auto* failed = tsl::any_cast<RankFailure>(&value)) {
+      return Failed(rank, *failed);
+    }
+  }
+  return absl::OkStatus();
+}
+
+absl::Status GpuCliqueRendezvous::Failed(RankId rank,
+                                         const RankFailure& failure) {
+  return FailedPrecondition("Rank %d of the clique failed before it: %s",
+                            rank.value(), failure.status.ToString());
 }
 
 }  // namespace xla::gpu

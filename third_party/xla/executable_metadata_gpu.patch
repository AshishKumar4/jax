+#include "xla/pjrt/proto/executable_metadata.pb.h"
+#include "xla/service/hlo.pb.h"
+#include "xla/tsl/platform/statusor.h"
+
+namespace pjrt {
+namespace {
+
+class PjrtCApiGpuExecutableMetadataTest : public PjrtCApiTestBase {
+ protected:
+  PjrtCApiGpuExecutableMetadataTest() : PjrtCApiTestBase(GetPjrtApi()) {
+    executable_ = create_executable(api_, client_);
+  }
+
+  ~PjrtCApiGpuExecutableMetadataTest() override { executable_.reset(); }
+
+  std::unique_ptr<PJRT_LoadedExecutable, PJRT_LoadedExecutableDeleter>
+      executable_;
+};
+
+TEST_F(PjrtCApiGpuExecutableMetadataTest,
+       GetExecutableMetadataStatesTheBufferAssignment) {
+  auto executable = PjrtCApiTestBase::GetExecutable(executable_.get(), api_);
+  const auto* extension =
+      pjrt::FindExtension<PJRT_ExecutableMetadata_Extension>(
+          api_, PJRT_Extension_Type::PJRT_Extension_Type_ExecutableMetadata);
+  ASSERT_NE(extension, nullptr);
+  PJRT_ExecutableMetadata_GetExecutableMetadata_Args args;
+  args.executable = executable.get();
+  args.metadata = nullptr;
+  ASSERT_EQ(extension->get_executable_metadata(&args), nullptr);
+  ASSERT_NE(args.metadata, nullptr);
+  xla::PjRtExecutableMetadata metadata;
+  ASSERT_TRUE(metadata.ParseFromArray(args.metadata->serialized_metadata,
+                                      args.metadata->serialized_metadata_size));
+  PJRT_ExecutableMetadata_DestroySerializedMetadata_Args free_args;
+  free_args.metadata = args.metadata;
+  extension->destroy_serialized_metadata(&free_args);
+
+  TF_ASSERT_OK_AND_ASSIGN(auto ref_stats,
+                          executable.get()->get()->GetCompiledMemoryStats());
+  ASSERT_FALSE(ref_stats.serialized_buffer_assignment.empty());
+  EXPECT_EQ(metadata.compiled_memory_stats().serialized_buffer_assignment(),
+            ref_stats.serialized_buffer_assignment);
+  EXPECT_EQ(metadata.compiled_memory_stats().temp_size_in_bytes(),
+            ref_stats.temp_size_in_bytes);
+  xla::BufferAssignmentProto assignment;
+  EXPECT_TRUE(assignment.ParseFromString(
+      metadata.compiled_memory_stats().serialized_buffer_assignment()));
+  EXPECT_GT(assignment.logical_buffers_size(), 0);
+}
+
+}  // namespace

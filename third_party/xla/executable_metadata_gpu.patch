+absl::StatusOr<CompiledMemoryStats> PjRtCApiExecutable::GetCompiledMemoryStats()
+    const {
+  ABSL_ASSIGN_OR_RETURN(CompiledMemoryStats stats,
+                        pjrt::GetCompiledMemoryStats(c_api_, executable_.get()));
+  if (pjrt::FindExtension<PJRT_ExecutableMetadata_Extension>(
+          c_api_, PJRT_Extension_Type::PJRT_Extension_Type_ExecutableMetadata) ==
+      nullptr) {
+    return stats;
+  }
+  ABSL_ASSIGN_OR_RETURN(std::string serialized,
+                        GetSerializedExecutableMetadata());
+  PjRtExecutableMetadata metadata;
+  if (!metadata.ParseFromString(serialized)) {
+    return absl::InternalError("Could not parse the executable's metadata.");
+  }
+  stats.serialized_buffer_assignment =
+      metadata.compiled_memory_stats().serialized_buffer_assignment();
+  return stats;
+}
+

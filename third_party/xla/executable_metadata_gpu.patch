+// An executable's metadata: its compiled memory stats, the buffer assignment
+// among them, which PJRT_Executable_GetCompiledMemoryStats does not carry.
+PJRT_Error* PJRT_Executable_GetExecutableMetadata(
+    PJRT_ExecutableMetadata_GetExecutableMetadata_Args* args) {
+  PJRT_ASSIGN_OR_RETURN(xla::CompiledMemoryStats stats,
+                        args->executable->executable->GetCompiledMemoryStats());
+  xla::PjRtExecutableMetadata metadata;
+  *metadata.mutable_compiled_memory_stats() = stats.ToProto();
+  std::string serialized = metadata.SerializeAsString();
+  char* bytes = new char[serialized.size()];
+  std::memcpy(bytes, serialized.data(), serialized.size());
+  // Released by the extension's destroy_serialized_metadata.
+  args->metadata = new PJRT_ExecutableMetadata{bytes, serialized.size()};
+  return nullptr;
+}

index d2c39d0143..4fed36aa35 100644
--- a/xla/service/collective_ops_utils.cc
+++ b/xla/service/collective_ops_utils.cc
@@ -100,6 +100,11 @@ std::optional<ReductionKind> MatchReductionComputation(
     const HloComputation* computation) {
   namespace m = match;

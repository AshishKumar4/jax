+  while (root->opcode() == HloOpcode::kCopy) {
+    root = root->operand(0);
+  }
   auto kind = MatchReductionInstruction(root);
   if (kind && !Match(root, m::Op()
                                .WithBinaryOperandsAnyOrder(m::Parameter(0),

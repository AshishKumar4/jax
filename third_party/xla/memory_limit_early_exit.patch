+TEST_F(GpuCompilerMemoryLimitTest,
+       ACompileWhoseArgumentsAloneAreOverItsLimitIsNeitherOptimizedNorRun) {
+  // Its two f32[256,256] arguments hold 512 KiB.
+  const int64_t arguments = 2 * 256 * 256 * 4;
+  TF_ASSERT_OK_AND_ASSIGN(std::unique_ptr<HloModule> module,
+                          Limited(arguments - 1));
+  const std::string before = module->ToString();
+  Compiler::CompileOptions options;
+  options.gpu_topology = GetSingleDeviceGpuTopology(
+      /*platform_version=*/"", gpu_target_config());
+  TF_ASSERT_OK_AND_ASSIGN(
+      std::unique_ptr<HloModule> passed,
+      compiler()->RunHloPasses(std::move(module), /*executor=*/nullptr,
+                               options));
+  EXPECT_EQ(passed->ToString(), before);
+
+  // Compiled ahead, it states its arguments alone and that it stopped.
+  TF_ASSERT_OK_AND_ASSIGN(std::unique_ptr<CompiledModule> stopped,
+                          CompiledAhead(arguments - 1));

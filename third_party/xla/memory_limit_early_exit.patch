+TEST_F(GpuCompilerMemoryLimitTest,
+       AnArgumentIsSizedAsItsPackedStorageAndAHostOneNotAtAll) {
+  // An s4's half byte, a pred's byte, a tuple's leaves, a host array's none.
+  TF_ASSERT_OK_AND_ASSIGN(std::unique_ptr<HloModule> module,
+                          ParseAndReturnVerifiedModule(R"hlo(
+    HloModule sized
+
+    ENTRY main {
+      p0 = s4[1000]{0} parameter(0)
+      p1 = pred[1000]{0} parameter(1)
+      p2 = (f32[4]{0}, s8[3]{0}) parameter(2)
+      p3 = f32[1024]{0:S(5)} parameter(3)
+      ROOT out = s4[1000]{0} copy(p0)
+    }
+  )hlo"));
+  EXPECT_EQ(EntryArgumentsOverMemoryLimit(*module, 1),
+            (std::vector<int64_t>{500, 1000, 19, 0}));
+  // Within the limit: nothing, the limit's sum itself included.
+  EXPECT_EQ(EntryArgumentsOverMemoryLimit(*module, 1519), std::nullopt);
+  EXPECT_EQ(EntryArgumentsOverMemoryLimit(*module, 0), std::nullopt);
+}

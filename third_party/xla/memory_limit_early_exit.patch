+std::optional<int64_t> DeviceBytesOverMemoryLimit(
+    absl::Span<const BufferAllocation> allocations, int64_t limit) {
+  if (limit <= 0) {
+    return std::nullopt;
+  }
+  std::vector<const BufferAllocation*> pointers;
+  pointers.reserve(allocations.size());
+  for (const BufferAllocation& allocation : allocations) {
+    pointers.push_back(&allocation);
+  }
+  CompiledMemoryStats stats;
+  stats.PopulateBufferStatsFromAllocations(pointers, /*assignment=*/nullptr);
+  const int64_t bytes = stats.argument_size_in_bytes +
+                        stats.output_size_in_bytes -
+                        stats.alias_size_in_bytes + stats.temp_size_in_bytes;
+  if (bytes <= limit) {
+    return std::nullopt;
+  }
+  return bytes;
+}
+
+std::optional<std::vector<int64_t>> EntryArgumentsOverMemoryLimit(
+    const HloModule& module, int64_t limit) {
+  const ComputationLayout& layout = module.entry_computation_layout();
+  if (limit <= 0 || module.config().num_partitions() > 1 ||
+      !layout.LayoutIsSet()) {
+    return std::nullopt;
+  }
+  std::vector<int64_t> arguments;
+  arguments.reserve(layout.parameter_count());
+  int64_t total = 0;
+  for (int64_t i = 0; i < layout.parameter_count(); ++i) {
+    int64_t bytes = 0;
+    ShapeUtil::ForEachLeafShape(
+        layout.parameter_shape(i), [&](const Shape& leaf, const ShapeIndex&) {
+          if (!leaf.IsArray() ||
+              leaf.layout().memory_space() == Layout::kHostMemorySpace) {
+            return;
+          }
+          bytes += CeilOfRatio<int64_t>(
+              ShapeUtil::ElementsIn(leaf) *
+                  primitive_util::StorageBitWidth(leaf.element_type()),
+              CHAR_BIT);
+        });
+    arguments.push_back(bytes);
+    total += bytes;
+  }
+  if (total <= limit) {
+    return std::nullopt;
+  }
+  return arguments;
+}

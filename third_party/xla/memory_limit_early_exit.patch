--- a/xla/service/gpu/gpu_executable.h
+++ b/xla/service/gpu/gpu_executable.h
@@ -434,11 +434,24 @@ class GpuExecutable : public Executable {
 
   // The GPU topology the executable was compiled for, if known.
   std::optional<GpuTopology> gpu_topology_;
+
+  // The xla_gpu_memory_limit_early_exit_bytes it was compiled under, and the
+  // device bytes its allocations hold where they exceed it: its compile stopped
+  // after buffer assignment, and executing it fails.
+  const int64_t memory_limit_early_exit_bytes_;
+  const std::optional<int64_t> over_memory_limit_;
 };
 
 absl::StatusOr<absl::flat_hash_map<ShapeIndex, GpuExecutable::OutputInfo>>
 GetOutputInfo(const HloModule& hlo_module, const BufferAssignment& assignment);
 
+// The device bytes `allocations` hold at once, as their compiled memory stats
+// state them (argument + output - alias + temp), where they exceed `limit`
+// (DebugOptions::xla_gpu_memory_limit_early_exit_bytes); nullopt within it, or
+// where `limit` is not positive.
+std::optional<int64_t> DeviceBytesOverMemoryLimit(
+    absl::Span<const BufferAllocation> allocations, int64_t limit);
+
 }  // namespace gpu
 }  // namespace xla
 

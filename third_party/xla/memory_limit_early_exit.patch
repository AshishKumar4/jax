     const ServiceExecutableRunOptions* run_options,
     VariantArguments arguments) {
+  if (over_memory_limit_.has_value()) {
+    return absl::FailedPreconditionError(absl::StrCat(
+        "Module ", module_name_, " holds ", *over_memory_limit_,
+        " bytes of device memory, over xla_gpu_memory_limit_early_exit_bytes's ",
+        memory_limit_early_exit_bytes_,
+        ": its compile stopped after buffer assignment and emitted no code"));
+  }
   if (has_module() && module_config().has_static_device_assignment()) {
     const DeviceAssignment& static_device_assignment =
         module_config().static_device_assignment();
@@ -1408,6 +1420,27 @@ int64_t GpuExecutable::SizeOfGeneratedCodeInBytes() const {
   return size;
 }
 
+std::optional<int64_t> DeviceBytesOverMemoryLimit(
+    absl::Span<const BufferAllocation> allocations, int64_t limit) {
+  if (limit <= 0) {
+    return std::nullopt;
+  }
+  std::vector<const BufferAllocation*> pointers;
+  pointers.reserve(allocations.size());
+  for (const BufferAllocation& allocation : allocations) {
+    pointers.push_back(&allocation);
+  }
+  CompiledMemoryStats stats;
+  stats.PopulateBufferStatsFromAllocations(pointers);
+  const int64_t bytes = stats.argument_size_in_bytes +
+                        stats.output_size_in_bytes -
+                        stats.alias_size_in_bytes + stats.temp_size_in_bytes;
+  if (bytes <= limit) {
+    return std::nullopt;
+  }
+  return bytes;
+}

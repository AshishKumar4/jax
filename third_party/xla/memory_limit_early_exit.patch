+constexpr absl::string_view kHloText = R"hlo(
+  HloModule gemm_tanh
+
+  ENTRY main {
+    p0 = f32[256,256]{1,0} parameter(0)
+    p1 = f32[256,256]{1,0} parameter(1)
+    dot = f32[256,256] dot(p0, p1),
+      lhs_contracting_dims={1}, rhs_contracting_dims={0}
+    tanh = f32[256,256] tanh(dot)
+    ROOT out = f32[256,256] dot(tanh, p1),
+      lhs_contracting_dims={1}, rhs_contracting_dims={0}
+  }
+)hlo";
+
+class GpuCompilerMemoryLimitTest : public HloPjRtGpuTestBase {
+ protected:
+  // `kHloText` under a compile limited to `limit` device bytes (none at 0).
+  absl::StatusOr<std::unique_ptr<HloModule>> Limited(int64_t limit) {
+    HloModuleConfig config = GetModuleConfigForTest();
+    DebugOptions options = config.debug_options();
+    options.set_xla_gpu_memory_limit_early_exit_bytes(limit);
+    config.set_debug_options(options);
+    return ParseAndReturnVerifiedModule(kHloText, config);
+  }
+
+  // It compiled ahead of time for this GPU under `limit`.
+  absl::StatusOr<std::unique_ptr<CompiledModule>> CompiledAhead(int64_t limit) {
+    AotCompilationOptions aot_options(compiler()->PlatformId());
+    aot_options.set_gpu_topology(GetSingleDeviceGpuTopology(
+        /*platform_version=*/"", gpu_target_config()));
+    TF_ASSIGN_OR_RETURN(std::unique_ptr<HloModule> module, Limited(limit));
+    TF_ASSIGN_OR_RETURN(
+        std::vector<std::unique_ptr<CompiledModule>> results,
+        compiler()->CompileAheadOfTime(std::move(module), aot_options));
+    if (results.size() != 1) {
+      return absl::InternalError("expected one compiled module");
+    }
+    return std::move(results[0]);
+  }
+};
+
+int64_t DeviceBytes(const CompiledMemoryStats& stats) {
+  return stats.argument_size_in_bytes + stats.output_size_in_bytes -
+         stats.alias_size_in_bytes + stats.temp_size_in_bytes;
+}
+
+TEST_F(GpuCompilerMemoryLimitTest,
+       ACompileOverItsLimitStatesTheWholeCompilesMemoryAndRefusesToRun) {
+  TF_ASSERT_OK_AND_ASSIGN(std::unique_ptr<CompiledModule> unlimited,
+                          CompiledAhead(0));
+  TF_ASSERT_OK_AND_ASSIGN(CompiledMemoryStats whole,
+                          unlimited->GetCompiledMemoryStats());
+  const int64_t limit = DeviceBytes(whole) - 1;
+  TF_ASSERT_OK_AND_ASSIGN(std::unique_ptr<CompiledModule> limited,
+                          CompiledAhead(limit));
+  TF_ASSERT_OK_AND_ASSIGN(CompiledMemoryStats stopped,
+                          limited->GetCompiledMemoryStats());
+
+  // The compile stopped past its limit states the whole compile's memory and
+  // buffer assignment, and carries no code: its serialized form is the whole
+  // one's less the kernels it did not emit.
+  EXPECT_EQ(DeviceBytes(stopped), DeviceBytes(whole));
+  EXPECT_EQ(stopped.temp_size_in_bytes, whole.temp_size_in_bytes);
+  EXPECT_EQ(stopped.serialized_buffer_assignment,
+            whole.serialized_buffer_assignment);
+  TF_ASSERT_OK_AND_ASSIGN(std::string stopped_bytes,
+                          limited->SerializeAsString());
+  TF_ASSERT_OK_AND_ASSIGN(std::string whole_bytes,
+                          unlimited->SerializeAsString());
+  EXPECT_LT(stopped_bytes.size(), whole_bytes.size());
+
+  TF_ASSERT_OK_AND_ASSIGN(std::unique_ptr<HloModule> module, Limited(limit));
+  Literal x = LiteralUtil::CreateFullWithDescendingLayout<float>({256, 256},
+                                                                 0.5f);
+  absl::StatusOr<Literal> ran = Execute(std::move(module), {&x, &x});
+  EXPECT_EQ(ran.status().code(), absl::StatusCode::kFailedPrecondition);
+  EXPECT_THAT(ran.status().message(),
+              HasSubstr("stopped after buffer assignment"));
+}
+
+TEST_F(GpuCompilerMemoryLimitTest, ACompileWithinItsLimitRunsAsAnUnlimitedOne) {
+  TF_ASSERT_OK_AND_ASSIGN(std::unique_ptr<CompiledModule> unlimited,
+                          CompiledAhead(0));
+  TF_ASSERT_OK_AND_ASSIGN(CompiledMemoryStats whole,
+                          unlimited->GetCompiledMemoryStats());
+  // A limit of the module's own device bytes holds it: it compiles whole and
+  // runs as the unlimited compile does.
+  const int64_t limit = DeviceBytes(whole);
+
+  Literal x = LiteralUtil::CreateFullWithDescendingLayout<float>({256, 256},
+                                                                 0.5f);
+  TF_ASSERT_OK_AND_ASSIGN(std::unique_ptr<HloModule> limited_module,
+                          Limited(limit));
+  TF_ASSERT_OK_AND_ASSIGN(Literal ran,
+                          Execute(std::move(limited_module), {&x, &x}));
+  TF_ASSERT_OK_AND_ASSIGN(std::unique_ptr<HloModule> unlimited_module,
+                          Limited(0));
+  TF_ASSERT_OK_AND_ASSIGN(Literal reference,
+                          Execute(std::move(unlimited_module), {&x, &x}));
+  EXPECT_TRUE(LiteralTestUtil::Equal(reference, ran));
+}

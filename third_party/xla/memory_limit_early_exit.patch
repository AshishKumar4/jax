+  TF_ASSERT_OK_AND_ASSIGN(std::unique_ptr<HloModule> partitioned,
+                          ParseAndReturnVerifiedModule(kHloText, config));
+  EXPECT_EQ(EntryArgumentsOverMemoryLimit(*partitioned, 1), std::nullopt);
+  TF_ASSERT_OK_AND_ASSIGN(std::unique_ptr<HloModule> unlaid, Limited(1));
+  ASSERT_TRUE(EntryArgumentsOverMemoryLimit(*unlaid, 1).has_value());
+  unlaid->mutable_entry_computation_layout()
+      ->mutable_parameter_layout(0)
+      ->Clear();
+  EXPECT_EQ(EntryArgumentsOverMemoryLimit(*unlaid, 1), std::nullopt);
+}

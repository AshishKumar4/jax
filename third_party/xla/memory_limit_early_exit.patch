+                          stopped->GetCompiledMemoryStats());
+  EXPECT_EQ(stats.argument_size_in_bytes, arguments);
+  EXPECT_EQ(stats.output_size_in_bytes, 0);
+  EXPECT_EQ(stats.alias_size_in_bytes, 0);
+  EXPECT_EQ(stats.temp_size_in_bytes, 0);
+  EXPECT_EQ(stats.peak_memory_in_bytes, 0);
+  EXPECT_EQ(stats.stopped_at_memory_limit, true);

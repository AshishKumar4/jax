+GpuCompiler::StoppedAtItsArguments(std::unique_ptr<HloModule> module,
+                                   absl::Span<const int64_t> arguments,
+                                   const GpuTopology& gpu_topology,
+                                   const CompileOptions& options) {
+  // Its buffer assignment is its entry arguments alone, each the bytes it
+  // holds at least: its memory stats state them, and nothing else.
+  std::vector<BufferAllocation> allocations;
+  BufferAssignmentProto buffer_assignment_proto;
+  int64_t bytes = 0;
+  for (int64_t i = 0; i < arguments.size(); ++i) {
+    BufferAllocation& allocation =
+        allocations.emplace_back(i, arguments[i], /*color=*/0);
+    allocation.set_entry_computation_parameter(
+        i, /*param_shape_index=*/{}, /*parameter_aliased_with_output=*/false);
+    *buffer_assignment_proto.add_buffer_allocations() = allocation.ToProto();
+    bytes += arguments[i];
+  }
+  const se::DeviceDescription& gpu_device_info =
+      gpu_topology.gpu_target_config().device_description;
+  ABSL_ASSIGN_OR_RETURN(
+      stream_executor::ExecutableAbiVersion executable_abi_version,
+      stream_executor::ExecutableAbiVersion::FromDeviceDescription(
+          gpu_device_info));
+  const DebugOptions debug_opts = module->config().debug_options();
+  std::string module_name = module->name();
+  ProgramShape program_shape =
+      module->compute_computation_layout().ComputeProgramShape();
+  return GpuExecutable::Create(GpuExecutable::Params{
+      /*binary=*/{},
+      /*dnn_compiled_graphs=*/{},
+      /*executable=*/std::make_unique<ThunkExecutor>(ThunkSequence{}),
+      /*constants=*/{},
+      /*output_info=*/{},
+      /*module_name=*/std::move(module_name),
+      /*program_shape=*/std::move(program_shape),
+      /*allocations=*/std::move(allocations),
+      /*alias_info=*/GetAliasInfo(gpu_device_info),
+      /*debug_options=*/debug_opts,
+      /*device_description=*/gpu_device_info,
+      /*debug_module=*/options.embed_hlo_module
+          ? std::move(module)

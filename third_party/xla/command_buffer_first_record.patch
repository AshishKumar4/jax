+// The rendezvous before thunk initialization carries each local participant's
+// failure to every participant: of two local devices, the one that failed to
+// prepare and the healthy one both return its failure, neither waiting on the
+// other until its terminate timeout.
+TEST(GpuExecutableRendezvousTest, AFailureBeforeInitializationReachesAllRanks) {
+  DeviceAssignment assignment(/*replica_count=*/2, /*computation_count=*/1);
+  assignment(0, 0) = 0;
+  assignment(1, 0) = 1;
+  GpuExecutableRunOptions gpu_options;
+  gpu_options.set_gpu_global_device_ids(GpuExecutableRunOptions::DeviceIdMap{
+      {LocalDeviceId(0), GlobalDeviceId(0)},
+      {LocalDeviceId(1), GlobalDeviceId(1)}});
+  DebugOptions debug_options;
+  debug_options.set_xla_gpu_executable_warn_stuck_timeout_seconds(5);
+  debug_options.set_xla_gpu_executable_terminate_timeout_seconds(10);
+
+  RunId run_id = RunId::CreateUniqueId();
+  std::vector<absl::Status> returned(2);
+  std::vector<std::thread> ranks;
+  for (int rank = 0; rank < 2; ++rank) {
+    ranks.emplace_back([&, rank] {
+      ExecutableRunOptions options;
+      options.set_device_ordinal(rank)
+          .set_device_assignment(&assignment)
+          .set_gpu_executable_run_options(&gpu_options)
+          .set_run_id(run_id);
+      ServiceExecutableRunOptions run_options(options);
+      absl::Status carried =
+          rank == 1 ? absl::InternalError("rank 1 failed to prepare")
+                    : absl::OkStatus();
+      returned[rank] = RendezvousAroundInitialization(
+          run_options, &debug_options, InitializationRound::kBefore,
+          std::move(carried));
+    });
+  }
+  for (std::thread& rank : ranks) {
+    rank.join();
+  }
+  for (const absl::Status& status : returned) {
+    EXPECT_EQ(status.code(), absl::StatusCode::kInternal);
+  }
+  EXPECT_EQ(returned[0], returned[1]);
+}
+
+// A healthy round returns success on every rank, and the round after
+// initialization of the same run meets apart from it.
+TEST(GpuExecutableRendezvousTest, RoundsOfOneRunMeetApart) {
+  DeviceAssignment assignment(/*replica_count=*/2, /*computation_count=*/1);
+  assignment(0, 0) = 0;
+  assignment(1, 0) = 1;
+  GpuExecutableRunOptions gpu_options;
+  DebugOptions debug_options;
+  debug_options.set_xla_gpu_executable_warn_stuck_timeout_seconds(5);
+  debug_options.set_xla_gpu_executable_terminate_timeout_seconds(10);
+
+  RunId run_id = RunId::CreateUniqueId();
+  std::vector<absl::Status> returned(4);
+  std::vector<std::thread> ranks;
+  for (int rank = 0; rank < 2; ++rank) {
+    ranks.emplace_back([&, rank] {
+      ExecutableRunOptions options;
+      options.set_device_ordinal(rank)
+          .set_device_assignment(&assignment)
+          .set_gpu_executable_run_options(&gpu_options)
+          .set_run_id(run_id);
+      ServiceExecutableRunOptions run_options(options);
+      returned[rank] = RendezvousAroundInitialization(
+          run_options, &debug_options, InitializationRound::kBefore);
+      returned[2 + rank] = RendezvousAroundInitialization(
+          run_options, &debug_options, InitializationRound::kAfter);
+    });
+  }
+  for (std::thread& rank : ranks) {
+    rank.join();
+  }
+  for (const absl::Status& status : returned) {
+    EXPECT_TRUE(status.ok()) << status;
+  }
+}

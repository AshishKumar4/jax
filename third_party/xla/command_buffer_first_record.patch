 // Returns the number of additional streams to allocate for a `GpuExecutable`.
+// Whether `executor`'s thunks, nested ones among them, hold both a command
+// buffer, which thunk initialization may instantiate, and a collective: its
+// executions' local participants rendezvous before initialization.
+static bool JoinsBeforeInitialization(ThunkExecutor& executor) {
+  bool command_buffer = false;
+  bool collective = false;
+  for (const auto& thunk : executor.thunks()) {
+    thunk->Walk([&](Thunk* nested) {
+      command_buffer |= nested->kind() == Thunk::kCommandBuffer;
+      // A collective of any kind that acquires a clique: the ones
+      // `IsCollective` names, and a collective kernel's.
+      collective |= nested->IsCollective() ||
+                    nested->kind() == Thunk::kCollectiveKernel;
+    });
+  }
+  return command_buffer && collective;
+}

+se::StreamExecutor* GpuExecutor() {
+  auto name =
+      absl::AsciiStrToUpper(PlatformUtil::CanonicalPlatformName("gpu").value());
+  auto* platform = se::PlatformManager::PlatformWithName(name).value();
+  return platform->ExecutorForDevice(0).value();
+}
+
+// A copy that, as a custom call or a collective, runs its first execution as
+// a thunk (`requires_warmup`), counting the times it is recorded.
+class WarmedCopyThunk : public DeviceToDeviceCopyThunk {
+ public:
+  WarmedCopyThunk(const ShapedSlice& source, const ShapedSlice& destination,
+                  int64_t mem_size, int* record_count)
+      : DeviceToDeviceCopyThunk(Thunk::ThunkInfo(), source, destination,
+                                mem_size),
+        record_count_(record_count) {}
+
+  absl::StatusOr<const se::CommandBuffer::Command*> Record(
+      const Thunk::ExecuteParams& execute_params,
+      const RecordParams& record_params, RecordAction record_action,
+      se::CommandBuffer* command_buffer) override {
+    ++*record_count_;
+    return DeviceToDeviceCopyThunk::Record(execute_params, record_params,
+                                           std::move(record_action),
+                                           command_buffer);
+  }
+
+  bool requires_warmup() const override { return true; }
+
+ private:
+  int* record_count_;
+};
+
+// A command buffer whose commands need a warmup runs it as thunks, and its
+// next executions too, a while loop's next iteration among them, until an
+// initialization records it: no execution instantiates a graph, which with
+// no rendezvous of the process's devices waited on the driver lock a peer's
+// instantiation held while that peer's collective waited on this device.
+TEST(CommandBufferThunkFirstRecordTest, OnlyInitializationRecordsAfterWarmup) {
+  se::StreamExecutor* stream_executor = GpuExecutor();
+  TF_ASSERT_OK_AND_ASSIGN(auto stream, stream_executor->CreateStream());
+
+  constexpr int64_t kLength = 4;
+  constexpr int64_t kByteLength = sizeof(int32_t) * kLength;
+  Shape shape = ShapeUtil::MakeShape(S32, {kLength});
+  se::DeviceAddress<int32_t> a =
+      stream_executor->AllocateArray<int32_t>(kLength, 0);
+  se::DeviceAddress<int32_t> b =
+      stream_executor->AllocateArray<int32_t>(kLength, 0);
+  TF_ASSERT_OK(stream->Memset32(&a, 42, kByteLength));
+
+  BufferAllocation source(/*index=*/0, kByteLength, /*color=*/0);
+  BufferAllocation destination(/*index=*/1, kByteLength, /*color=*/0);
+  ShapedSlice from{BufferAllocation::Slice(&source, 0, kByteLength), shape};
+  ShapedSlice to{BufferAllocation::Slice(&destination, 0, kByteLength), shape};
+
+  int record_count = 0;
+  CommandSequence commands;
+  commands.Emplace<WarmedCopyThunk>(from, to, kByteLength, &record_count);
+  constexpr auto kSerialize = CommandExecutor::SynchronizationMode::kSerialize;
+  TF_ASSERT_OK_AND_ASSIGN(
+      CommandExecutor executor,
+      CommandExecutor::Create(std::move(commands), kSerialize));
+  ThunkSequence fallback;
+  fallback.push_back(std::make_unique<DeviceToDeviceCopyThunk>(
+      Thunk::ThunkInfo(), from, to, kByteLength));
+  CommandBufferThunk thunk(
+      std::move(executor), Thunk::ThunkInfo(), /*devices_in_process=*/1,
+      std::make_unique<SequentialThunk>(Thunk::ThunkInfo(),
+                                        std::move(fallback)));
+
+  se::StreamExecutorAddressAllocator allocator(stream_executor);
+  ServiceExecutableRunOptions run_options;
+  BufferAllocations allocations({a, b}, /*device_ordinal=*/0, &allocator);
+  std::vector<BufferAllocation::Index> persistent = {0, 1};
+  Thunk::InitializeParams initialize_params;
+  initialize_params.executor = stream_executor;
+  initialize_params.buffer_allocations = &allocations;
+  initialize_params.stream = stream.get();
+  initialize_params.persistent_alloc_indices = absl::MakeConstSpan(persistent);
+  Thunk::ExecuteParams execute_params = Thunk::ExecuteParams::Create(
+      run_options, allocations, stream.get(), stream.get(), nullptr, nullptr,
+      nullptr, /*additional_compute_streams=*/{},
+      /*execution_scoped_state=*/nullptr, absl::MakeConstSpan(persistent));
+
+  // Each execution copies; the record count after it, and its copy's values.
+  auto executed = [&]() -> std::vector<int32_t> {
+    EXPECT_TRUE(stream->MemZero(&b, kByteLength).ok());
+    EXPECT_TRUE(thunk.ExecuteOnStream(execute_params).ok());
+    std::vector<int32_t> copied(kLength, 0);
+    EXPECT_TRUE(stream->Memcpy(copied.data(), b, kByteLength).ok());
+    EXPECT_TRUE(stream->BlockHostUntilDone().ok());
+    return copied;
+  };
+  const std::vector<int32_t> copied(kLength, 42);
+
+  TF_ASSERT_OK(thunk.Initialize(initialize_params));  // Warmup not done.
+  EXPECT_EQ(record_count, 0);
+  EXPECT_EQ(executed(), copied);  // The warmup.
+  EXPECT_EQ(executed(), copied);  // Its loop's next iteration.
+  EXPECT_EQ(executed(), copied);
+  EXPECT_EQ(record_count, 0);
+
+  TF_ASSERT_OK(thunk.Initialize(initialize_params));  // The next execution's.
+  EXPECT_EQ(record_count, 1);
+  EXPECT_EQ(executed(), copied);
+  EXPECT_EQ(executed(), copied);
+  EXPECT_EQ(record_count, 1);
+
+  stream_executor->Deallocate(&a);
+  stream_executor->Deallocate(&b);
+}

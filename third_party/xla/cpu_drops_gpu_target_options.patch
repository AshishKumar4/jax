+// Whether `key`, an xla_backend_extra_options entry's, is a switch (a leading
+// dash; a value given as an entry of its own is no switch) whose name, its
+// dashes and any =value aside, begins with a prefix the GPU targets' LLVM
+// options are named by: nvptx-, nvvm-, disable-nvptx- (NVPTX), amdgpu-,
+// disable-amdgpu- (AMDGPU). A policy of names, not a registry of the targets'
+// options: a GPU option named otherwise is parsed as any other, and a
+// misspelling under one of these prefixes is skipped where options are the
+// host's. A switch's value goes in its own entry's value (-x=v).
+inline bool HasGpuTargetPrefix(absl::string_view key) {
+  if (!absl::ConsumePrefix(&key, "-")) {
+    return false;
+  }
+  absl::ConsumePrefix(&key, "-");
+  absl::string_view name = key.substr(0, key.find('='));
+  for (absl::string_view target : {"nvptx-", "nvvm-", "disable-nvptx-",
+                                   "amdgpu-", "disable-amdgpu-"}) {
+    if (absl::StartsWith(name, target)) {
+      return true;
+    }
+  }
+  return false;
+}

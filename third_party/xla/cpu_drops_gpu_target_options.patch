+
+TEST(ExtractXlaBackendExtraOptionsDeathTest, AnOptionNoTargetKnowsEndsIt) {
+  // A GPU target's option where no GPU target is initialized, and an option no
+  // target knows, are unknown to LLVM's parser, which ends the process.
+  GTEST_FLAG_SET(death_test_style, "threadsafe");
+  const std::map<std::string, std::string> division = {
+      {"-nvptx-prec-divf32", "2"}};
+  EXPECT_EXIT(LLVMCommandLineOptionsLock(
+                  ExtractXlaBackendExtraOptions(division)),
+              testing::ExitedWithCode(1),
+              "Unknown command line argument '-nvptx-prec-divf32=2'");
+  // A typo naming a target is no target's option: still the host's, unknown.
+  const std::map<std::string, std::string> typo = {
+      {"-xla-unknown-nvptx-option", "1"}};
+  EXPECT_EXIT(LLVMCommandLineOptionsLock(ExtractXlaBackendExtraOptions(

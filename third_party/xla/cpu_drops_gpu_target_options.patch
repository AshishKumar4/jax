+// A GPU process's xla_backend_extra_options: Dew's fp32 division among them.
+const std::map<std::string, std::string>& GpuProcessOptions() {
+  static const auto* options = new std::map<std::string, std::string>{
+      {"-nvptx-prec-divf32", "2"},
+      {"--disable-nvptx-ir-peephole", ""},
+      {"-amdgpu-early-inline-all", "true"},
+      {"-nvvm-reflect-enable", "false"},
+      {"-pass-remarks", "amdgpu-test"},
+      {"-pass-remarks-missed=amdgpu-test", ""},
+      {"-xla-test-llvm-cl-int-option", "7"},
+      {"xla_is_host_offload", "true"}};
+  return *options;
+}
+
+TEST(ExtractXlaBackendExtraOptionsTest, TheHostTakesNoGpuTargetsSwitch) {
+  // A GPU target's switches alone are not the host's: a generic option whose
+  // value names one is.
+  EXPECT_EQ(ExtractXlaBackendExtraOptions(GpuProcessOptions(),
+                                          ExtraOptionsFor::kHost),
+            (std::vector<std::string>{"-pass-remarks-missed=amdgpu-test",
+                                      "-pass-remarks=amdgpu-test",
+                                      "-xla-test-llvm-cl-int-option=7"}));
+  EXPECT_EQ(ExtractXlaBackendExtraOptions(GpuProcessOptions()),
+            (std::vector<std::string>{
+                "--disable-nvptx-ir-peephole", "-amdgpu-early-inline-all=true",
+                "-nvptx-prec-divf32=2", "-nvvm-reflect-enable=false",
+                "-pass-remarks-missed=amdgpu-test", "-pass-remarks=amdgpu-test",
+                "-xla-test-llvm-cl-int-option=7"}));
+}
+
+TEST(ExtractXlaBackendExtraOptionsTest, AHostCompileParsesAGpuProcesssOptions) {
+  // Parsed here, where no GPU target is initialized, as an XLA:CPU compile
+  // parses them.
+  llvm::cl::opt<int>& test_option = GetTestIntOption();
+  LLVMCommandLineOptionsLock lock(ExtractXlaBackendExtraOptions(

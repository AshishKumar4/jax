+TEST_F(GpuCompilerEarlyExitTest,
+       AfterBufferAssignmentStatesTheWholeCompilesMemory) {
+  absl::string_view hlo_text = R"hlo(
+    HloModule gemm_tanh
+
+    ENTRY main {
+      p0 = f32[256,256]{1,0} parameter(0)
+      p1 = f32[256,256]{1,0} parameter(1)
+      dot = f32[256,256] dot(p0, p1),
+        lhs_contracting_dims={1}, rhs_contracting_dims={0}
+      tanh = f32[256,256] tanh(dot)
+      ROOT out = f32[256,256] dot(tanh, p1),
+        lhs_contracting_dims={1}, rhs_contracting_dims={0}
+    }
+)hlo";
+
+  auto compiled = [&](AotCompilationOptions::EarlyExitPoint point)
+      -> absl::StatusOr<CompiledMemoryStats> {
+    AotCompilationOptions aot_options(compiler()->PlatformId());
+    aot_options.set_gpu_topology(GetSingleDeviceGpuTopology(
+        /*platform_version=*/"", gpu_target_config()));
+    aot_options.set_early_exit_point(point);
+    TF_ASSIGN_OR_RETURN(std::unique_ptr<HloModule> module,
+                        ParseAndReturnVerifiedModule(hlo_text));
+    TF_ASSIGN_OR_RETURN(
+        std::vector<std::unique_ptr<CompiledModule>> results,
+        compiler()->CompileAheadOfTime(std::move(module), aot_options));
+    if (results.size() != 1) {
+      return absl::InternalError("expected one compiled module");
+    }
+    return results[0]->GetCompiledMemoryStats();
+  };
+
+  TF_ASSERT_OK_AND_ASSIGN(
+      CompiledMemoryStats early,
+      compiled(AotCompilationOptions::EarlyExitPoint::kAfterBufferAssignment));
+  TF_ASSERT_OK_AND_ASSIGN(
+      CompiledMemoryStats whole,
+      compiled(AotCompilationOptions::EarlyExitPoint::kNone));
+
+  // The stop after buffer assignment states what the whole compile does.
+  EXPECT_GT(early.temp_size_in_bytes, 0);
+  EXPECT_EQ(early.temp_size_in_bytes, whole.temp_size_in_bytes);
+  EXPECT_EQ(early.argument_size_in_bytes, whole.argument_size_in_bytes);
+  EXPECT_EQ(early.output_size_in_bytes, whole.output_size_in_bytes);
+  EXPECT_EQ(early.alias_size_in_bytes, whole.alias_size_in_bytes);
+  EXPECT_EQ(early.peak_memory_in_bytes, whole.peak_memory_in_bytes);
+  EXPECT_EQ(early.serialized_buffer_assignment,
+            whole.serialized_buffer_assignment);
+}

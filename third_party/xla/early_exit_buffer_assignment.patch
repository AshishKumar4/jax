+absl::StatusOr<std::unique_ptr<GpuAliasInfo>> GpuCompiler::ScheduleForBackend(
+    HloModule* module, const GpuTopology& gpu_topology,
+    mlir::MLIRContext* mlir_context) {
+  const se::DeviceDescription& device_description =
+      gpu_topology.gpu_target_config().device_description;
+  std::unique_ptr<GpuAliasInfo> alias_info = GetAliasInfo(device_description);
+  ABSL_RETURN_IF_ERROR(RunPreSchedulingPasses(module, device_description,
+                                              alias_info.get(), mlir_context));
+  ABSL_ASSIGN_OR_RETURN(
+      ScheduleMetadata schedule_metadata,
+      ScheduleGpuModule(module, pointer_size_, device_description,
+                        mlir_context, alias_info.get()));
+  HloPassPipeline pipeline("scheduled-gpu-module");
+  AddHloVerifier(&pipeline);
+  ABSL_RETURN_IF_ERROR(pipeline.Run(module).status());
+  ABSL_RETURN_IF_ERROR(
+      RunPostSchedulingPipelines(module, schedule_metadata.scheduler_mem_limit,
+                                 gpu_topology, alias_info.get()));
+  return alias_info;
+}
+
+absl::StatusOr<std::unique_ptr<CompiledModule>>
+GpuCompiler::CompileToBufferAssignment(std::unique_ptr<HloModule> module,
+                                       se::StreamExecutor* stream_exec,
+                                       const CompileOptions& options) {
+  tsl::profiler::TraceMe traceme("CompileToBufferAssignment");
+  ABSL_ASSIGN_OR_RETURN(
+      GpuTopology gpu_topology,
+      InferGpuTopology(module->config(), stream_exec, options,
+                       module->config().debug_options(), platform_id_));
+  // cuDNN's compiled graphs state their workspaces, buffers of the assignment.
+  BinaryMap dnn_compiled_graphs;
+  ABSL_RETURN_IF_ERROR(RunCudnnCompilerPasses(module.get(), stream_exec,
+                                              gpu_topology.gpu_target_config(),
+                                              &dnn_compiled_graphs));
+  ABSL_ASSIGN_OR_RETURN(BorrowedMlirContext borrowed_context,
+                        mlir_context_pool_.GetOrCreate());
+  ABSL_ASSIGN_OR_RETURN(
+      std::unique_ptr<GpuAliasInfo> alias_info,
+      ScheduleForBackend(module.get(), gpu_topology, borrowed_context->get()));
+  ABSL_ASSIGN_OR_RETURN(std::unique_ptr<BufferAssignment> assignment,
+                        RunBufferAssignment(module.get(), gpu_topology,
+                                            alias_info.get(),
+                                            BufferSizeBytesFunction()));
+  BufferAssignmentProto assignment_proto = assignment->ToProto();
+  return std::make_unique<EarlyExitCompilationResult>(
+      std::move(module), std::move(assignment_proto));
+}

+absl::StatusOr<CompiledMemoryStats> CompiledMemoryStats::FromBufferAssignment(
+    const BufferAssignmentProto& assignment,
+    const HloModuleProto* absl_nullable module) {
+  CompiledMemoryStats stats;
+  stats.serialized_buffer_assignment = assignment.SerializeAsString();
+  std::vector<BufferAllocation> allocations;
+  allocations.reserve(assignment.buffer_allocations_size());
+  for (const BufferAllocationProto& allocation :
+       assignment.buffer_allocations()) {
+    allocations.push_back(BufferAllocation::FromProto(allocation));
+  }
+  std::vector<const BufferAllocation*> pointers;
+  pointers.reserve(allocations.size());
+  for (const BufferAllocation& allocation : allocations) {
+    pointers.push_back(&allocation);
+  }
+  stats.PopulateBufferStatsFromAllocations(pointers, /*assignment=*/nullptr);
+  if (module != nullptr) {
+    ABSL_ASSIGN_OR_RETURN(PeakMemorySizes peak,
+                          ComputePeakMemorySizes(assignment, *module));
+    stats.peak_memory_in_bytes = peak.padded;
+    stats.peak_unpadded_heap_bytes = peak.unpadded;
+  } else {
+    // The unpadded sizes can only be derived from the HLO module, so without a
+    // module only the padded peak is computed and `peak_unpadded_heap_bytes`
+    // stays 0, which means unknown.
+    ABSL_ASSIGN_OR_RETURN(stats.peak_memory_in_bytes,
+                          ComputePeakMemory(assignment));
+  }
+  stats.total_allocation_bytes =
+      ComputeTotalAllocationBytes(assignment, /*memory_color=*/0);
+  stats.indefinite_allocations =
+      ComputeIndefiniteAllocationsInBytes(assignment, /*memory_color=*/0);
+  return stats;
+}
+
 // Recomputes the memory stats from allocations. Why recompute?
 // Firstly, there are cases in which gpu::Executable inherits its allocations
 // from elsewhere, and no buffer assignment is available.

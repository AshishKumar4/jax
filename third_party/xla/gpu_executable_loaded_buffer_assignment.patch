--- a/xla/service/gpu/gpu_executable.cc
+++ b/xla/service/gpu/gpu_executable.cc
@@ -2019,7 +2019,20 @@ absl::StatusOr<std::unique_ptr<GpuExecutable>> GpuExecutable::FromProto(
       params.executable_abi_version,
       se::ExecutableAbiVersion::FromProto(proto.executable_abi_version()));
 
-  return CreateImpl(std::move(params), std::move(module_config_metadata));
+  ABSL_ASSIGN_OR_RETURN(
+      std::unique_ptr<GpuExecutable> executable,
+      CreateImpl(std::move(params), std::move(module_config_metadata)));
+  // An executable compiled with its debug info states its buffer assignment
+  // through Executable's (`GpuCompiler::RunBackend`), which a client's
+  // CompiledMemoryStats read; one loaded from its proto states the assignment
+  // it was serialized with alike, its module beside it.
+  if (executable->has_module()) {
+    auto hlo_proto = std::make_unique<HloProto>();
+    *hlo_proto->mutable_buffer_assignment() =
+        executable->buffer_assignment_proto();
+    executable->set_hlo_proto(std::move(hlo_proto));
+  }
+  return executable;
 }
 

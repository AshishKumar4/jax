+TEST(PjRtCpuClientTest, FingerprintIgnoresMetadata) {
+  // One program whose instructions' metadata (their source locations) differ:
+  // its executables are fingerprinted alike, so processes running it, one
+  // compiling and one loading it from a cache, agree on its collectives'
+  // run ids.
+  static constexpr char kFirst[] = R"(
+HloModule Summed
+
+ENTRY Summed {
+  %x = f32[4] parameter(0), metadata={op_name="sum" source_file="a.py" source_line=1}
+  ROOT %y = f32[4] add(%x, %x), metadata={op_name="sum" source_file="a.py" source_line=1}
+})";
+  static constexpr char kSecond[] = R"(
+HloModule Summed
+
+ENTRY Summed {
+  %x = f32[4] parameter(0), metadata={op_name="sum" source_file="b.py" source_line=9}
+  ROOT %y = f32[4] add(%x, %x), metadata={op_name="sum" source_file="b.py" source_line=9}
+})";
+  TF_ASSERT_OK_AND_ASSIGN(auto client, GetPjRtCpuClient(CpuClientOptions()));
+  std::vector<std::string> fingerprints;
+  for (const char* program : {kFirst, kSecond}) {
+    TF_ASSERT_OK_AND_ASSIGN(auto hlo_module,
+                            ParseAndReturnUnverifiedModule(program, {}));
+    XlaComputation xla_computation(hlo_module->ToProto());
+    TF_ASSERT_OK_AND_ASSIGN(auto executable,
+                            client->CompileAndLoad(xla_computation, {}));
+    TF_ASSERT_OK_AND_ASSIGN(fingerprints.emplace_back(),
+                            executable->FingerprintExecutable());
+  }
+  EXPECT_EQ(fingerprints[0], fingerprints[1]);
+}

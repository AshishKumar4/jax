+}
+
+sort_fusion {
+  keys = s32[5,1]{1,0} parameter(0)
+  iota = s4[5,1]{1,0} iota(), iota_dimension=0
+  ROOT sort = (s32[5,1]{1,0}, s4[5,1]{1,0}) sort(keys, iota), dimensions={1},
+    to_apply=compare
+}

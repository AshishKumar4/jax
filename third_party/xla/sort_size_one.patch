+TEST_F(SortingTest, ASortOverASizeOneDimensionReturnsItsOperands) {
+  // A key, a value and an iota sorted over one element: no pass removes the
+  // sort, so the emitter takes a dimension of one (it aborted shifting by -1).
+  const char* hlo_text = R"(
+HloModule TestModule
+
+compare {
+  p.0.lhs = s32[] parameter(0)
+  p.0.rhs = s32[] parameter(1)
+  p.1.lhs = s32[] parameter(2)
+  p.1.rhs = s32[] parameter(3)
+  p.2.lhs = s32[] parameter(4)
+  p.2.rhs = s32[] parameter(5)
+  ROOT lt = pred[] compare(p.0.lhs, p.0.rhs), direction=LT
+}
+
+ENTRY TestComputation {
+  keys = s32[1] parameter(0)
+  values = s32[1] parameter(1)
+  iota = s32[1] iota(), iota_dimension=0
+  ROOT sort = (s32[1], s32[1], s32[1]) sort(keys, values, iota),
+    dimensions={0}, to_apply=compare
+}
+)";
+  EXPECT_TRUE(RunAndCompareNoHloPasses(hlo_text, ErrorSpec{0, 0}));
+}
+
+class SortingWithoutSimplificationTest : public SortingTest {
+ protected:
+  // As a reference twin compiles: no simplifier to remove a trivial sort.
+  DebugOptions GetDebugOptionsForTest() const override {
+    DebugOptions options = SortingTest::GetDebugOptionsForTest();
+    options.add_xla_disable_hlo_passes("algsimp");
+    options.add_xla_disable_hlo_passes("constant_folding");
+    return options;
+  }
+};
+
+TEST_F(SortingWithoutSimplificationTest,
+       ASortedFusionOverASizeOneDimensionWritesItsIota) {
+  // Sorted over a dimension of one, its iota counting the other dimension:
+  // the sort's fusion writes the iota through its one stage, the keys and
+  // values as they came.
+  const char* hlo_text = R"(
+HloModule TestModule
+
+compare {
+  p.0.lhs = f32[] parameter(0)
+  p.0.rhs = f32[] parameter(1)
+  p.1.lhs = s32[] parameter(2)
+  p.1.rhs = s32[] parameter(3)
+  ROOT lt = pred[] compare(p.0.lhs, p.0.rhs), direction=LT
+}
+
+ENTRY TestComputation {
+  keys = f32[4, 1] parameter(0)
+  iota = s32[4, 1] iota(), iota_dimension=0
+  ROOT sort = (f32[4, 1], s32[4, 1]) sort(keys, iota), dimensions={1},
+    to_apply=compare
+}
+)";
+  EXPECT_TRUE(RunAndCompare(hlo_text, ErrorSpec{0, 0}));
+}

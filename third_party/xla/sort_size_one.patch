+// The elements of a sort's output each thread of its iota copy writes: a
+// packed output's whole bytes (two s4 elements to a byte), so no two threads
+// read, change and write one byte.
+int64_t IotaCopyElementsPerThread(const HloSortInstruction* sort) {
+  int64_t elements = 1;
+  for (const HloInstruction* operand : sort->operands()) {
+    PrimitiveType type = operand->shape().element_type();
+    if (operand->opcode() == HloOpcode::kIota &&
+        primitive_util::IsSubByteNonPredType(type)) {
+      elements =
+          std::max<int64_t>(elements, 8 / primitive_util::BitWidth(type));
+    }
+  }
+  return elements;
+}
+
+// The kernel writing a fused sort's iota outputs, where its sorted dimension
+// holds one element: one elementwise pass, each thread writing
+// `elements_per_thread` consecutive elements of each iota output.
+absl::StatusOr<LlvmKernelSource> EmitModuleForSortIotaCopy(
+    const HloSortInstruction* sort, IrEmitterContext* ir_emitter_context,
+    const std::string& sanitized_kernel_name,
+    const emitters::KernelArguments& kernel_arguments,
+    const LaunchDimensions& launch_dimensions, const Shape& threads_shape,
+    int64_t elements_per_thread) {
+  auto llvm_context = std::make_unique<llvm::LLVMContext>();
+  std::string op_name(sort->name());
+  std::unique_ptr<llvm::Module> llvm_module =
+      ir_emitter_context->CreateLLVMModule(op_name, *llvm_context);
+  IrEmitter ir_emitter(ir_emitter_context, llvm_module.get(),
+                       /*is_nested=*/false);
+  llvm::IRBuilderBase* b = ir_emitter.builder();
+  const HloInstruction* fusion = sort->parent()->FusionInstruction();
+  ABSL_ASSIGN_OR_RETURN(
+      llvm::Function * kernel,
+      BuildKernelPrototype(llvm_module.get(),
+                           ir_emitter_context->gpu_device_info(),
+                           std::string(fusion->name()), sanitized_kernel_name,
+                           kernel_arguments, launch_dimensions, b));
+  std::vector<llvm_ir::IrArray> ir_arrays =
+      IrArraysFor(kernel, kernel_arguments);
+  auto outputs = absl::Span<const llvm_ir::IrArray>(ir_arrays).subspan(
+      fusion->operand_count());
+  const int64_t num_elements = ShapeUtil::ElementsIn(sort->operand(0)->shape());
+  llvm::Type* index_ty = GetIndexTypeForKernel(
+      fusion, launch_dimensions.launch_bound() * elements_per_thread, b);
+  llvm_ir::BodyEmitter write_iotas =
+      [&](const llvm_ir::IrArray::Index& thread) -> absl::Status {
+    for (int64_t offset = 0; offset < elements_per_thread; ++offset) {
+      llvm::Value* element = b->CreateAdd(
+          b->CreateMul(thread.linear(),
+                       llvm::ConstantInt::get(index_ty, elements_per_thread)),
+          llvm::ConstantInt::get(index_ty, offset));
+      // The last thread's bytes may hold fewer elements than the others'.
+      llvm_ir::LlvmIfData in_bounds = llvm_ir::EmitIfThenElse(
+          b->CreateICmpULT(element,
+                           llvm::ConstantInt::get(index_ty, num_elements)),
+          llvm_ir::IrName(op_name, "element_in_bounds"), b,
+          /*emit_else=*/false);
+      llvm_ir::SetToFirstInsertPoint(in_bounds.true_block, b);
+      for (int64_t i = 0; i < sort->operand_count(); ++i) {
+        if (sort->operand(i)->opcode() != HloOpcode::kIota) {
+          continue;
+        }
+        llvm_ir::IrArray::Index index(element, outputs[i].GetShape(), b);
+        ABSL_ASSIGN_OR_RETURN(
+            llvm::Value * value,
+            EmitIota(sort->operand(i), index, llvm_module.get(), b));
+        outputs[i].EmitWriteArrayElement(index, value, b);
+      }
+      llvm_ir::SetToFirstInsertPoint(in_bounds.after_block, b);
+    }
+    return absl::OkStatus();
+  };
+  ABSL_RETURN_IF_ERROR(
+      ParallelLoopEmitter(write_iotas, threads_shape, launch_dimensions, b)
+          .EmitLoop(op_name, index_ty));
+  return LlvmKernelSource(std::move(llvm_context), std::move(llvm_module));
+}
+
+// A sort over a dimension of one element (or none) orders nothing (algsimp
+// removes it; a compile without algsimp reaches here, where a bitonic sort's
+// geometry, Log2Ceiling of the bound, is no stage). Its outputs are its
+// operands, which its caller copied (or aliased), but for an iota fused into
+// it, which one elementwise kernel writes. Newer XLA's sort emitter does the
+// same (BitonicSortKernelSpec::Kind::kIotaCopy): a rebase onto it drops this.
+AsyncThunkSequence EmitSortOverSizeOne(const HloSortInstruction* sort,
+                                       IrEmitterContext* ir_emitter_context) {
+  const Shape& keys_shape = sort->operand(0)->shape();
+  bool fused_iota =
+      sort->parent()->IsFusionComputation() &&
+      absl::c_any_of(sort->operands(), [](const HloInstruction* operand) {
+        return operand->opcode() == HloOpcode::kIota;
+      });
+  if (!fused_iota || ShapeUtil::IsZeroElementArray(keys_shape)) {
+    return ThunkSequence::Empty();
+  }
+  const HloInstruction* fusion = sort->parent()->FusionInstruction();
+  const auto& device_info = ir_emitter_context->gpu_device_info();
+  int64_t elements_per_thread = IotaCopyElementsPerThread(sort);
+  Shape threads_shape = ShapeUtil::MakeShape(
+      U8,
+      {CeilOfRatio(ShapeUtil::ElementsIn(keys_shape), elements_per_thread)});
+  LaunchDimensions launch_dimensions =
+      CalculateLaunchDimensions(threads_shape, device_info);
+  // Blocks past the x grid's limit go to y, which ParallelLoopEmitter takes
+  // none of: the x grid at its limit, its loop strides over the rest.
+  if (launch_dimensions.block_counts().y > 1) {
+    launch_dimensions =
+        LaunchDimensions(device_info.block_dim_limit().x,
+                         launch_dimensions.thread_counts_per_block().x);
+  }
+  std::string sanitized_kernel_name =
+      ir_emitter_context->GetSanitizedUniqueName(std::string(sort->name()));
+  ABSL_ASSIGN_OR_RETURN(auto kernel_arguments,
+                        emitters::KernelArguments::Create(
+                            ir_emitter_context->buffer_assignment(),
+                            GetDefaultBufferAlignment(), fusion));
+  ABSL_ASSIGN_OR_RETURN(
+      LlvmKernelSource llvm_kernel_source,
+      EmitModuleForSortIotaCopy(sort, ir_emitter_context,
+                                sanitized_kernel_name, kernel_arguments,
+                                launch_dimensions, threads_shape,
+                                elements_per_thread));
+  return ir_emitter_context->kernel_compiler()
+      ->Compile(Thunk::ThunkInfo::WithProfileAnnotation(
+                    fusion, ir_emitter_context->GetNextThunkId()),
+                std::move(llvm_kernel_source), sanitized_kernel_name,
+                kernel_arguments, launch_dimensions)
+      .Map([](std::unique_ptr<Thunk> thunk) {
+        return ThunkSequence::Of(std::move(thunk));
+      });
+}

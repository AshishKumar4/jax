   kCmdBufferCompatible = XLA_FFI_HANDLER_TRAITS_COMMAND_BUFFER_COMPATIBLE,
+
+  // Indicates that the handler's instantiate may run on any thread once IR
+  // emission ends, beside other instantiations of handlers with this trait
+  // (XLA_FFI_HANDLER_TRAITS_INSTANTIATE_AFTER_EMISSION).
+  kInstantiateAfterEmission =
+      XLA_FFI_HANDLER_TRAITS_INSTANTIATE_AFTER_EMISSION,

   // (can depend on attribute values) that can be captured and then replayed.
   XLA_FFI_HANDLER_TRAITS_COMMAND_BUFFER_COMPATIBLE = 1u << 0,
+
+  // The handler's instantiate may run on any thread once the compiler has
+  // emitted every thunk, beside other instantiations of handlers with this
+  // trait: it reads nothing of the emitter's but its arguments, and takes
+  // LLVM's command-line options lease itself where it compiles with LLVM.
+  // XLA:GPU then runs such instantiations in parallel after IR emission,
+  // outside the emitter's own lease, rather than one after another during it.
+  XLA_FFI_HANDLER_TRAITS_INSTANTIATE_AFTER_EMISSION = 1u << 1,
 };
 

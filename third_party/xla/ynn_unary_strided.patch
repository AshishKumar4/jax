index 0000000000..aa9f4bc738
--- /dev/null
+++ b/third_party/xnnpack/ynn_unary_strided.patch
@@ -0,0 +1,63 @@
+diff --git a/ynnpack/subgraph/elementwise.cc b/ynnpack/subgraph/elementwise.cc
+--- a/ynnpack/subgraph/elementwise.cc
++++ b/ynnpack/subgraph/elementwise.cc
+@@ -7,7 +7,9 @@
+ #include <cassert>
+ #include <cstddef>
+ #include <cstdint>
++#include <cstring>
+ #include <utility>
++#include <vector>
+ 
+ #include "ynnpack/base/log.h"
+ #include "ynnpack/base/to_string.h"
+@@ -46,18 +48,43 @@
+       return 0;
+     }
+ 
+-    // We don't support broadcasting of `a` here in the innermost
+-    // dimension (and it would waste computation).
+-    assert(is_contiguous(a_dims[0], a.elem_size));
+-
+     const slinky::index_t x_n_extent = x_dims[0].extent();
+     const slinky::index_t a_m_stride = a_dims[1].stride();
+     const slinky::index_t x_m_extent = x_dims[1].extent();
+     const slinky::index_t x_m_stride = x_dims[1].stride();
+ 
++    if (is_contiguous(a_dims[0], a.elem_size)) {
++      slinky::for_each_element(
++          [=, &params](void* x, const void* a) {
++            kernel(x_m_extent, x_n_extent, a_m_stride, a, x_m_stride, x,
++                   &params);
++          },
++          x, a);
++      return 0;
++    }
++
++    // The kernels read `a` contiguously in its innermost dimension. A
++    // broadcast of `a` there (a stride of zero) or any other stride is
++    // gathered into a buffer of this call's own, read as given and never
++    // written.
++    const slinky::index_t a_n_extent = a_dims[0].extent();
++    const slinky::index_t a_n_stride = a_dims[0].stride();
++    const std::size_t elem_size = a.elem_size;
++    const slinky::index_t dense_m_stride = a_n_extent * elem_size;
++    std::vector<char> dense(x_m_extent * dense_m_stride);
+     slinky::for_each_element(
+-        [=, &params](void* x, const void* a) {
+-          kernel(x_m_extent, x_n_extent, a_m_stride, a, x_m_stride, x, &params);
++        [=, &params, &dense](void* x, const void* a) {
++          const char* row = static_cast<const char*>(a);
++          char* to = dense.data();
++          for (slinky::index_t i = 0; i < x_m_extent; ++i, row += a_m_stride) {
++            const char* from = row;
++            for (slinky::index_t j = 0; j < a_n_extent;
++                 ++j, from += a_n_stride, to += elem_size) {
++              std::memcpy(to, from, elem_size);
++            }
++          }
++          kernel(x_m_extent, x_n_extent, dense_m_stride, dense.data(),
++                 x_m_stride, x, &params);
+         },
+         x, a);
+     return 0;

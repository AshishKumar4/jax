 }
 
+TEST_P(YnnFusionTest, SharedBroadcastThenConvert) {
+  // The two converts keep the broadcast shared during YNN's fusion pass.
+  // After common-subgraph elimination, the remaining unary kernel must not
+  // treat a stride-zero alias of the scalar as a contiguous array.
+  constexpr absl::string_view kModuleStr = R"(
+    HloModule shared_broadcast_then_convert
+
+    ynn_fusion {
+      %input = $dtype[] parameter(0)
+      %broadcast = $dtype[17] broadcast(%input), dimensions={}
+      %lhs = f32[17] convert(%broadcast)
+      %rhs = f32[17] convert(%broadcast)
+      ROOT %sum = f32[17] add(%lhs, %rhs)
+    }
+
+    ENTRY entry {
+      %p0 = $dtype[] parameter(0)
+      ROOT %fusion = f32[17] fusion(%p0), kind=kCustom, calls=ynn_fusion,
+        backend_config={"fusion_config": {kind: "__ynn_fusion"}}
+    })";
+
+  RunTest(kModuleStr);
+}
+
+TEST_P(YnnFusionTest, ReductionsWithSharedClampBroadcast) {
+  constexpr absl::string_view kModuleStr = R"(
+    HloModule reductions_with_shared_clamp_broadcast
+
+    add {
+      %lhs = f32[] parameter(0)
+      %rhs = f32[] parameter(1)
+      ROOT %sum = f32[] add(%lhs, %rhs)
+    }
+
+    ynn_fusion {
+      %lhs = $dtype[4096,2] parameter(0)
+      %rhs = $dtype[4096,2] parameter(1)
+      %lhs_f32 = f32[4096,2] convert(%lhs)
+      %rhs_f32 = f32[4096,2] convert(%rhs)
+      %zero = f32[] constant(0)
+      %lhs_sum = f32[4096] reduce(%lhs_f32, %zero), dimensions={1},
+        to_apply=add
+      %rhs_sum = f32[4096] reduce(%rhs_f32, %zero), dimensions={1},
+        to_apply=add
+      %lhs_narrow = $dtype[4096] convert(%lhs_sum)
+      %rhs_narrow = $dtype[4096] convert(%rhs_sum)
+      %one = $dtype[] constant(1)
+      %broadcast = $dtype[4096] broadcast(%one), dimensions={}
+      %lhs_clamp = $dtype[4096] maximum(%lhs_narrow, %broadcast)
+      %rhs_clamp = $dtype[4096] maximum(%rhs_narrow, %broadcast)
+      %lhs_result = f32[4096] convert(%lhs_clamp)
+      %rhs_result = f32[4096] convert(%rhs_clamp)
+      ROOT %sum = f32[4096] add(%lhs_result, %rhs_result)
+    }
+
+    ENTRY entry {
+      %p0 = $dtype[4096,2] parameter(0)
+      %p1 = $dtype[4096,2] parameter(1)
+      ROOT %fusion = f32[4096] fusion(%p0, %p1), kind=kCustom,
+        calls=ynn_fusion,
+        backend_config={"fusion_config": {kind: "__ynn_fusion"}}
+    })";
+
+  RunTest(kModuleStr);
+}
+
+TEST_P(YnnFusionTest, RowSumsOfSquares) {
+  // A sum of squares over a row's innermost dimension, as an RMS norm takes
+  // it: row 6829's trapping reductions, which must run as compiled.
+  constexpr absl::string_view kModuleStr = R"(
+    HloModule row_sums_of_squares
+
+    add {
+      %lhs = f32[] parameter(0)
+      %rhs = f32[] parameter(1)
+      ROOT %sum = f32[] add(%lhs, %rhs)
+    }
+
+    ynn_fusion {
+      %input = $dtype[8,512,16] parameter(0)
+      %wide = f32[8,512,16] convert(%input)
+      %square = f32[8,512,16] multiply(%wide, %wide)
+      %zero = f32[] constant(0)
+      ROOT %sums = f32[8,512] reduce(%square, %zero), dimensions={2},
+        to_apply=add
+    }
+
+    ENTRY entry {
+      %p0 = $dtype[8,512,16] parameter(0)
+      ROOT %fusion = f32[8,512] fusion(%p0), kind=kCustom, calls=ynn_fusion,
+        backend_config={"fusion_config": {kind: "__ynn_fusion"}}
+    })";
+
+  RunTest(kModuleStr);
+}
+
+TEST_P(YnnFusionTest, SoftmaxRows) {
+  // A softmax over each row's innermost dimension, its maximum and its sum each
+  // broadcast back over the row: row 6829's trapping reductions.
+  constexpr absl::string_view kModuleStr = R"(
+    HloModule softmax_rows
+
+    max {
+      %lhs = f32[] parameter(0)
+      %rhs = f32[] parameter(1)
+      ROOT %max = f32[] maximum(%lhs, %rhs)
+    }
+
+    add {
+      %lhs = f32[] parameter(0)
+      %rhs = f32[] parameter(1)
+      ROOT %sum = f32[] add(%lhs, %rhs)
+    }
+
+    ynn_fusion {
+      %input = $dtype[8,64,512] parameter(0)
+      %logits = f32[8,64,512] convert(%input)
+      %lowest = f32[] constant(-inf)
+      %row_max = f32[8,64] reduce(%logits, %lowest), dimensions={2},
+        to_apply=max
+      %max_broadcast = f32[8,64,512] broadcast(%row_max), dimensions={0,1}
+      %shifted = f32[8,64,512] subtract(%logits, %max_broadcast)
+      %exp = f32[8,64,512] exponential(%shifted)
+      %zero = f32[] constant(0)
+      %row_sum = f32[8,64] reduce(%exp, %zero), dimensions={2}, to_apply=add
+      %sum_broadcast = f32[8,64,512] broadcast(%row_sum), dimensions={0,1}
+      ROOT %softmax = f32[8,64,512] divide(%exp, %sum_broadcast)
+    }
+
+    ENTRY entry {
+      %p0 = $dtype[8,64,512] parameter(0)
+      ROOT %fusion = f32[8,64,512] fusion(%p0), kind=kCustom,
+        calls=ynn_fusion,
+        backend_config={"fusion_config": {kind: "__ynn_fusion"}}
+    })";
+
+  RunTest(kModuleStr);
+}

diff --git a/xla/backends/gpu/autotuner/cudnn.cc b/xla/backends/gpu/autotuner/cudnn.cc
index abb46c31a3..26f5a07a45 100644
--- a/xla/backends/gpu/autotuner/cudnn.cc
+++ b/xla/backends/gpu/autotuner/cudnn.cc
@@ -391,6 +391,15 @@ bool CudnnBackend::IsSupported(const HloInstruction& instr) {
 absl::StatusOr<std::unique_ptr<BackendConfig>> CudnnBackend::GetDefaultConfig(
     const HloInstruction& instr) {
   if (IsCustomCallToDnnConvolution(instr)) {
+    // Without a device no algorithm is chosen, and the default's -1 is no
+    // engine cuDNN runs: the executable would fail at its first run with
+    // CUDNN_STATUS_BAD_PARAM. Fail the compile instead.
+    if (stream_executor() == nullptr) {
+      return absl::FailedPreconditionError(
+          "Cannot get default cuDNN convolution config without a device: "
+          "compile with a StreamExecutor, or with autotune results that hold "
+          "this convolution");
+    }
     // If the instruction is a custom call to a DnnConvolution, we can return
     // the default config.
     auto config = std::make_unique<BackendConfig>();

+
+// Deserializes an executable for a topology without loading it, as
+// PJRT_Compile compiles one: a compile-only client's counterpart of
+// PJRT_Executable_DeserializeAndLoad, which needs a client.
+
+#define PJRT_API_EXECUTABLE_DESERIALIZE_EXTENSION_VERSION 1
+
+struct PJRT_ExecutableDeserialize_Deserialize_Args {
+  size_t struct_size;
+  PJRT_Extension_Base* extension_start;
+  PJRT_TopologyDescription* topology;
+  // As PJRT_Executable_Serialize serializes one.
+  const char* serialized_executable;
+  size_t serialized_executable_size;
+  // Serialized CompileOptionsProto or null (to use the options from the
+  // serialized executable).
+  const char* overridden_serialized_compile_options;
+  size_t overridden_serialized_compile_options_size;
+  PJRT_Executable* executable;  // out
+};
+PJRT_DEFINE_STRUCT_TRAITS(PJRT_ExecutableDeserialize_Deserialize_Args,
+                          executable);
+
+typedef PJRT_Error* (*PJRT_ExecutableDeserialize_Deserialize)(
+    PJRT_ExecutableDeserialize_Deserialize_Args* args);
+
+typedef struct PJRT_ExecutableDeserialize_Extension {
+  PJRT_Extension_Base base;
+  PJRT_ExecutableDeserialize_Deserialize deserialize;
+} PJRT_ExecutableDeserialize_Extension;
+PJRT_DEFINE_STRUCT_TRAITS(PJRT_ExecutableDeserialize_Extension, deserialize);
+
+#ifdef __cplusplus
+}
+#endif
+
+namespace pjrt {
+
+// Deserializes through the compiler of `args->topology`'s platform
+// (xla::PjRtDeserializeExecutable), as PJRT_Compile compiles through it.
+PJRT_Error* PJRT_ExecutableDeserialize_DeserializeExecutable(
+    PJRT_ExecutableDeserialize_Deserialize_Args* args);
+
+PJRT_ExecutableDeserialize_Extension CreateExecutableDeserializeExtension(
+    PJRT_Extension_Base* next);
+
+}  // namespace pjrt
+
+#endif  // XLA_PJRT_EXTENSIONS_EXECUTABLE_DESERIALIZE_EXECUTABLE_DESERIALIZE_EXTENSION_H_

+absl::StatusOr<std::unique_ptr<PjRtExecutable>>
+PjRtCApiCompiler::DeserializeExecutable(
+    const PjRtTopologyDescription& topology,
+    riegeli::Any<riegeli::Reader*> reader,
+    std::optional<CompileOptions>&& options,
+    const DeserializeExecutableOptions& deserialize_options) {
+  PJRT_ExecutableDeserialize_Extension* extension =
+      pjrt::FindExtension<PJRT_ExecutableDeserialize_Extension>(
+          c_api_,
+          PJRT_Extension_Type::PJRT_Extension_Type_ExecutableDeserialize);
+  if (extension == nullptr) {
+    return absl::UnimplementedError(absl::StrCat(
+        "DeserializeExecutable is not implemented for: ",
+        topology.platform_name(),
+        " (its plugin has no PJRT_ExecutableDeserialize_Extension)."));
+  }
+  std::string serialized;
+  ABSL_RETURN_IF_ERROR(riegeli::ReadAll(std::move(reader), serialized));
+  std::string options_str;
+  if (options.has_value()) {
+    ABSL_ASSIGN_OR_RETURN(const CompileOptionsProto options_proto,
+                          options->ToProto());
+    options_str = options_proto.SerializeAsString();
+  }
+
+  PJRT_ExecutableDeserialize_Deserialize_Args args;
+  args.struct_size = PJRT_ExecutableDeserialize_Deserialize_Args_STRUCT_SIZE;
+  args.extension_start = nullptr;
+  args.topology = absl::down_cast<const PjRtCApiTopologyDescription*>(&topology)
+                      ->c_topology();
+  args.serialized_executable = serialized.data();
+  args.serialized_executable_size = serialized.size();
+  args.overridden_serialized_compile_options =
+      options.has_value() ? options_str.data() : nullptr;
+  args.overridden_serialized_compile_options_size = options_str.size();
+  args.executable = nullptr;
+  RETURN_STATUS_IF_PJRT_ERROR(extension->deserialize(&args), c_api_);
+  std::unique_ptr<PjRtExecutable> executable =
+      std::make_unique<PjRtCApiExecutable>(c_api_, args.executable);
+  return executable;
+}

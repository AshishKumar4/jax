+tsl::Future<ExecutableRef> PjRtCompiler::DeserializeExecutable(
+    const absl::Cord& serialized, const Topology& topology,
+    absl_nullable std::unique_ptr<DeserializeExecutableOptions> options) {
+  const auto* pjrt_topology = dyn_cast<PjRtTopology>(&topology);
+  if (pjrt_topology == nullptr) {
+    return absl::InvalidArgumentError("PjRtCompiler requires a PjRtTopology");
+  }
+  ABSL_ASSIGN_OR_RETURN(auto xla_deserialize_options,
+                        GetXlaDeserializeExecutableOptions(std::move(options)));
+  // An unloaded executable's device IDs are its topology's, as `Compile`'s
+  // are when it cross-compiles: none is translated to a client's.
+  ABSL_ASSIGN_OR_RETURN(
+      auto common_metadata_and_serialized_pjrt_executable,
+      PjRtExecutable::CommonMetadata::Deserialize(
+          serialized,
+          absl::bind_front(&PjRtCompiler::IsExecutableVersionCompatible, this),
+          *xla_deserialize_options));
+  ABSL_ASSIGN_OR_RETURN(
+      std::unique_ptr<xla::PjRtExecutable> pjrt_executable,
+      xla::PjRtDeserializeExecutable(
+          *pjrt_topology->description(),
+          std::make_unique<riegeli::CordReader<>>(
+              &common_metadata_and_serialized_pjrt_executable.second),
+          std::move(xla_deserialize_options->compile_options)));
+  return PjRtExecutable::Create(
+      std::shared_ptr<xla::PjRtExecutable>(std::move(pjrt_executable)),
+      std::move(common_metadata_and_serialized_pjrt_executable.first));
+}

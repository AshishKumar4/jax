+#include "xla/pjrt/c/pjrt_c_api_status_utils.h"
+#include "xla/pjrt/c/pjrt_c_api_wrapper_impl.h"
+#include "xla/pjrt/pjrt_compiler.h"
+#include "xla/pjrt/pjrt_executable.h"
+#include "xla/pjrt/proto/compile_options.pb.h"
+
+namespace pjrt {
+
+PJRT_Error* PJRT_ExecutableDeserialize_DeserializeExecutable(
+    PJRT_ExecutableDeserialize_Deserialize_Args* args) {
+  PJRT_RETURN_IF_ERROR(ActualStructSizeIsGreaterOrEqual(
+      "PJRT_ExecutableDeserialize_Deserialize_Args",
+      PJRT_ExecutableDeserialize_Deserialize_Args_STRUCT_SIZE,
+      args->struct_size));
+  if (args->topology == nullptr) {
+    return StatusToPjRtError(
+        absl::InvalidArgumentError("Deserializing an executable needs the "
+                                   "topology it was compiled for."));
+  }
+  std::optional<xla::CompileOptions> options;
+  if (args->overridden_serialized_compile_options != nullptr &&
+      args->overridden_serialized_compile_options_size > 0) {
+    xla::CompileOptionsProto proto;
+    if (!proto.ParseFromString(
+            std::string(args->overridden_serialized_compile_options,
+                        args->overridden_serialized_compile_options_size))) {
+      return StatusToPjRtError(absl::InvalidArgumentError(
+          "PJRT_ExecutableDeserialize_Deserialize: failed to parse the "
+          "overridden CompileOptionsProto."));
+    }
+    PJRT_ASSIGN_OR_RETURN(options, xla::CompileOptions::FromProto(proto));
+  }
+  PJRT_ASSIGN_OR_RETURN(
+      std::unique_ptr<xla::PjRtExecutable> executable,
+      xla::PjRtDeserializeExecutable(
+          *args->topology->topology,
+          std::make_unique<riegeli::StringReader<>>(
+              absl::string_view(args->serialized_executable,
+                                args->serialized_executable_size)),
+          std::move(options)));
+  args->executable = new PJRT_Executable(std::move(executable));
+  return nullptr;
+}
+
+PJRT_ExecutableDeserialize_Extension CreateExecutableDeserializeExtension(
+    PJRT_Extension_Base* next) {
+  return PJRT_ExecutableDeserialize_Extension{
+      PJRT_Extension_Base{
+          /*struct_size=*/PJRT_ExecutableDeserialize_Extension_STRUCT_SIZE,
+          /*type=*/PJRT_Extension_Type_ExecutableDeserialize,
+          /*next=*/next,
+      },
+      /*deserialize=*/PJRT_ExecutableDeserialize_DeserializeExecutable,
+  };
+}
+
+}  // namespace pjrt

# TODO: use a released version when available
bazel_dep(name = "xla")
archive_override(
    module_name = "xla",
    integrity = "sha256-UKZ/Qqn4U274TL4t5cmI87M9yYRIVzksbmFpCy5/34g=",
    patch_strip = 1,
    patches = [
        "//third_party:xla/xpu_triton_hook.patch",
        "//third_party:xla/nvptx_compiler_target.patch",
        "//third_party:xla/windows_cpp_gen_intrinsics.patch",
        # Triton's pipeliner sizes a load's async-copy buffers by its earliest use, not the last wgmma reading
        # the buffer forwarded to a local_alloc, which the next cp.async overwrites while that wgmma still reads
        # it (Dew ledger 3521): triton-lang/triton PR 12738, open, carried as it stands.
        "//third_party:xla/triton_pipeliner_multiuse_load.patch",
        # A bitcast commuted across a layout-changing copy in GEMM fusion drops the copy's permutation, so a
        # Triton GEMM fusion reads its operand permuted (Dew ledger 5275; upstream a22dec8093, PR #51630).
        "//third_party:xla/gemm_fusion_bitcast_layouts.patch",
        # A cuDNN call in a computation on the parallel execution thread (compute_on, a stream-annotated call)
        # compiles its graph as one on the main thread does (upstream 4caba817d8, PR #50350).
        "//third_party:xla/cudnn_compile_parallel_thread.patch",
        # A compile with no device and cuDNN's deviceless compilation off fails at a cuDNN call, rather than
        # returning an executable whose cuDNN thunk finds no serialized graph at load (upstream ecc9e27f91).
        "//third_party:xla/cudnn_uncompiled_fails.patch",
        # A cuDNN convolution compiled with no algorithm (the autotuner's default, -1, which a compile with
        # no device keeps) runs the first engine cuDNN's heuristics give it that needs no workspace, as none
        # is allocated it, where engine -1 failed its first run with CUDNN_STATUS_BAD_PARAM (Dew's
        # FS-DEVICELESS-AUTO-gh200).
        "//third_party:xla/cudnn_conv_default_engine.patch",
        # A deviceless compile's cuDNN device description states the global memory bus width, which cuDNN
        # 9.27 requires of one ("!json_object.HasMember(key)" without it: every cuDNN graph compiled with no
        # device failed, Dew's FS-CUDNNPROPS-gh200).
        "//third_party:xla/cudnn_device_props_memory_bus_width.patch",
        # A cuDNN call the custom call compiler fingerprints as one it compiled takes that one's backend config
        # too, which the compile set (a backward's force_deterministic under deterministic ops): otherwise its
        # thunk's fingerprint names no serialized graph (Dew ledger 5322).
        "//third_party:xla/cudnn_graph_cache_hit_config.patch",
        # Deterministic ops keep the autotuner's Triton backend (no split-k, so ordered sums), whatever the
        # client's DebugOptions state of its mode: GEMM fusions compile with no device, and with one take their
        # first compilable config as before (rows 5389 and the GPU tier's "No supported config found").
        "//third_party:xla/deterministic_ops_keep_triton.patch",
        # A reducer rooted in a copy of its reduction (Shardy's export holds a region root's sharding so)
        # reduces by the copied operation: AllReducePromotion aborted a CPU bf16 psum's compile on it, and
        # MatchReductionComputation read it as no reduction (Dew row 5900).
        "//third_party:xla/reducer_copy_root.patch",
        # cuDNN frontend 1.32.3: the packed d256 attention backward's plan holds 577 MiB of engine workspace
        # where 1.26.0's held 9.68 GB at a 12,288-token call (Dew row 5916).
        "//third_party:xla/cudnn_frontend_1_32_3.patch",
        # A compile stops after buffer assignment and states its memory (xla_gpu_experimental_early_exit's
        # EARLY_EXIT_POINT_AFTER_BUFFER_ASSIGNMENT): a planner's probe at the cost of the HLO passes alone.
        "//third_party:xla/early_exit_buffer_assignment.patch",
        # The CUDA plugin serves its executables' metadata (PJRT_ExecutableMetadata_Extension), and the C API
        # client reads their buffer assignment from it into memory_analysis().
        "//third_party:xla/executable_metadata_gpu.patch",
        # FFI handlers that instantiate concurrently (Mosaic GPU's) are instantiated together on the compile
        # threads before thunk emission, a program's Mosaic kernels compiled in parallel.
        "//third_party:xla/instantiate_concurrently.patch",
        # A compile over xla_gpu_memory_limit_early_exit_bytes stops after buffer assignment: its executable
        # states its memory and buffer assignment and refuses to run; within the limit it finishes. A start
        # compiles its step once whether it fits or not.
        "//third_party:xla/memory_limit_early_exit.patch",
        # YNNPACK's unary kernels read an input of any innermost stride as given, a broadcast's stride zero among
        # them, gathering it into a buffer of the call's own: a bf16 convert of a broadcast scalar read past it
        # (row 5495), where writing the stride on the shared input crashed (row 6829).
        "//third_party:xla/ynn_unary_strided.patch",
        # Triton's combine keeps a float add of a dot's result apart from its accumulator: a residual r + x @ w
        # fused into a nested GEMM took r as the accumulator's start and rounded 1.7 times as far from float64
        # as the add kept apart (row 6759).
        "//third_party:xla/triton_dot_add_kept.patch",
        # HloEvaluator's float32 dot over an empty contraction is zeros, where its Eigen contraction divided by
        # the depth: XLA:CPU's constant folding died of SIGFPE on one with the algebraic simplifier off (row 6942).
        "//third_party:xla/evaluator_empty_contraction.patch",
        # A float add, subtract or multiply labeled xla_no_contract (jax.experimental.xla_metadata) rounds on its
        # own on the CPU, fenced (llvm.arithmetic.fence) where XLA:CPU makes its arithmetic contractible, its
        # unlabeled twins kept apart by CSE and contracted as before; LLVM widens the fence (row 7953: Dew's
        # error-free transforms' products contracted into fused multiply-adds, their compensations lost).
        "//third_party:xla/no_contract_mark.patch",
        # A small dot strength-reduces as its precision algorithm states, each multiplied and summed as it says
        # (F16_F16_F32's, F16_F16_F16's, BF16_BF16_BF16's, F64_F64_F64's, the ANY_F8 ones'), where XLA:GPU
        # refused every one with INVALID_ARGUMENT (an A100's ragged dot of half operands, row 8554).
        "//third_party:xla/dot_algorithm_multiply.patch",
        # A CPU executable deserialized (from the compilation cache) keeps one collective communicator across a
        # while loop's body, a call's and a conditional's branches and the sequence holding them, as the compile
        # emits it: each nested sequence's resources deserialized apart dropped every resource edge between a
        # loop and the collectives beside it, and ranks entered a loop's all-reduce and an all-gather beside it in
        # different orders until their rendezvous timed out (row 10128: a sharded mamba step aborted on every load
        # of its cache entry, never compiled fresh).
        "//third_party:xla/cpu_serdes_collective_resources.patch",
        # Upstream's output-to-operand aliasing in DynamicSliceFusionV2 (63ed7d6a6f) and its buffer sharing
        # checking every use of an operand (bdf1e5789f, openxla/xla#51490): a dynamic-slice fusion around a cuBLAS
        # GEMM with beta 1 whose output, accumulator and a slice operand shared one buffer read the operand after
        # the GEMM began writing it, a write-after-read race on an A100 (rows 10112, 8372, 9762).
        "//third_party:xla/gpu_dynamic_slice_operand_uses.patch",
        # The backport at this pin: its sharing check reads HloValue's operand-use rule (kDomain transparent
        # here, removed upstream), and its tests' host copies use executor-allocated memory.
        "//third_party:xla/gpu_dynamic_slice_operand_uses_pin.patch",
        # A compile-only GPU device states the client's memory spaces (device, pinned_host), so a program compiled
        # ahead for one keeps its host offloads, which canonicalizing "pinned_host" to the default memory dropped
        # (row 8372: a host step prepared without a GPU compiled other programs than its run).
        "//third_party:xla/compile_only_memory_spaces.patch",
        # A spill warning's function is read whatever name ptxas quotes: a PTX name holding `$` (LLVM's NVPTX
        # backend writes `_$_` into a name it makes valid) spilled with no stats recorded, read as no spill by
        # Mosaic GPU's kernel facts (row 9649).
        "//third_party:xla/ptxas_spill_function_names.patch",
        # A reduce over degenerate dimensions alone is its inputs, each result its own: ReductionDegenerateDimRemover
        # replaced a variadic one with one bitcast of its first input and failed the compile (RET_CHECK
        # hlo_computation.cc: reduce ((f32[32], f32[32])) vs bitcast (f32[32]), a compensated (hi, lo) sum over a
        # one-element axis on an A100, row 10742), and bitcast a mixed precision one across element types.
        "//third_party:xla/reduce_degenerate_variadic.patch",
        # A scatter's indices are flattened in their own type: ScatterDeterminismExpander's S64 strides made S32
        # indices an s32 x s64 dot, which the elemental emitter multiplied as `arith.muli (i32, i64)` and LLVM IR
        # translation refused (RET_CHECK mlir_kernel_emitter.cc:705) under deterministic ops with the algebraic
        # simplifier off, an accuracy check's reference as written (row 10741); and the emitter multiplies any
        # mixed precision dot's operands in one type.
        "//third_party:xla/mixed_index_dot.patch",
        # A CPU collective waits for the last one to complete, not to start (upstream bd5b6fb67b, less its version
        # bump): a while loop's thunk returns before its collective starts, so the next loops' collectives took
        # every worker and a multi-device CPU program hung (row 5397: 11 of 12 processes of a plain JAX program).
        "//third_party:xla/cpu_collective_execution_edges.patch",
    ],
    strip_prefix = "xla-d867969800d4a8fd045505eabc65e1e66f30794f",
    urls = ["https://github.com/openxla/xla/archive/d867969800d4a8fd045505eabc65e1e66f30794f.tar.gz"],
)

